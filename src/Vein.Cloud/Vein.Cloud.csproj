<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Vein.Cloud</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packaging, naming and the compile gate live in the compiler, where Vein.Tests can reach them.
         This project only moves bytes. -->
    <ProjectReference Include="..\Vein.Compiler\Vein.Compiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
