<Project Sdk="Microsoft.NET.Sdk">

  <!-- net9.0 so it can reference the ShardECS SECS core (net9) AND the net8 Vein.Compiler. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vein.Runtime.SECS</RootNamespace>
    <AssemblyName>Vein.Runtime.SECS</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vein.Compiler\Vein.Compiler.csproj" />
    <!-- The ShardECS entity/component runtime, vendored in-tree (src/ShardECS.SECS). -->
    <ProjectReference Include="..\ShardECS.SECS\SECS.csproj" />
  </ItemGroup>

</Project>
