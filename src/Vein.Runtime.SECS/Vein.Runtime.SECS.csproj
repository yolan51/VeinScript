<Project Sdk="Microsoft.NET.Sdk">

  <!-- net8.0, like everything here, so an ENGINE host on net8 (Godot 4.7 .NET) can reference it. It was
       net9 only because the vendored SECS core was; nothing in either uses a net9-only API. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vein.Runtime.SECS</RootNamespace>
    <AssemblyName>Vein.Runtime.SECS</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vein.Compiler\Vein.Compiler.csproj" />
    <!-- The ShardECS entity/component runtime, vendored in-tree (src/ShardECS.SECS). -->
    <ProjectReference Include="..\ShardECS.SECS\SECS.csproj" />
  </ItemGroup>

</Project>
