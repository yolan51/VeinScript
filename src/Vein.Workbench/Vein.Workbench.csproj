<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Vein.Workbench</RootNamespace>

    <!-- The name a person sees in the folder and on the taskbar. RootNamespace stays `Vein.Workbench`,
         so embedded-resource names are unaffected — but `avares://` URIs address the ASSEMBLY, so the
         four that load the logo had to change with this. -->
    <AssemblyName>VeinScript-Workbench</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.0" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/VeinScript.xshd" />
    <!-- The logo is an AvaloniaResource, not an EmbeddedResource: that is what `avares://` resolves,
         and it is referenced from XAML (window icon, menu strip, toolbar, About). -->
    <AvaloniaResource Include="Assets/VSLOGO.png" />

    <!-- One icon per VeinScript primitive, keyed by filename (`shape.png`, `mark.png`, …) and mapped
         to SymbolKind in PrimitiveIcons.cs. AvaloniaResource for the same reason the logo is: that is
         what `avares://` resolves.

         They are 314x314 sources drawn at 14px. That is deliberate rather than careless — decoding
         happens once through Bitmap.DecodeToWidth, so what is held is the small copy, and the large
         original is what makes them still look right if a panel ever wants them bigger. -->
    <AvaloniaResource Include="Assets/primitives/*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vein.Compiler\Vein.Compiler.csproj" />
    <ProjectReference Include="..\Vein.Cloud\Vein.Cloud.csproj" />

    <!-- The CLI ships INSIDE the Workbench. ▶ and the terminal shell out to `veinc`, and without it
         they fall back to building it from source with the SDK, and a machine that just installed
         this application has neither the SDK nor the source tree. -->
    <ProjectReference Include="..\Vein.Cli\Vein.Cli.csproj" />
  </ItemGroup>

  <!-- THE STANDARD LIBRARY SHIPS WITH THE APPLICATION.
       `BundleIndex.LocateNamed` looks for a folder named `stdlib` holding .vein files, starting at
       AppContext.BaseDirectory and walking up. Inside the repo it finds the real one; on an installed
       copy it found nothing at all, so every `*Vein.Console.Io.@Print` failed to resolve and no program
       a person wrote would compile. Copying it beside the executable is what makes the same lookup
       succeed with no special case anywhere in the code. -->
  <ItemGroup>
    <Content Include="..\..\stdlib\**\*.vein" LinkBase="stdlib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- THE SAMPLES SHIP TOO, so somebody who has just installed this has something to open and run
       before they have written anything.

       BY EXTENSION, NEVER BY FOLDER. `samples/` also holds three 65 MB executables left behind by
       `veinc build` — they are gitignored, so they are invisible in a clone and very present on the
       machine of anyone who has run that command. A `samples\**\*` include would have quietly put
       195 MB into a 44 MB download. What is actually source here is 633 KB. -->
  <ItemGroup>
    <Content Include="..\..\samples\**\*.vein" LinkBase="samples" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\**\vein.discovery" LinkBase="samples" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
