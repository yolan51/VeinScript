<?xml version="1.0" encoding="utf-8"?>
<!-- VeinScript highlighting for AvaloniaEdit. Keywords mirror Vein.Compiler/Lexing/Lexer.cs
     (the Keywords map + the M2 additions + ShardView). Keep this list in sync with the lexer. -->
<SyntaxDefinition name="VeinScript" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#6A9955" />
  <Color name="String"  foreground="#CE9178" />
  <Color name="Number"  foreground="#B5CEA8" />
  <Color name="Keyword" foreground="#569CD6" fontWeight="bold" />

  <!-- A COLOUR PER SIGIL. The four are different kinds of thing — data, tag, message, template — and
       one shared colour made a file read as an undifferentiated wall. They are also the four names
       that can legally collide: RULES 14e allows a shape and a mark to share one, so the colour is
       often the only thing on the line that says which you are looking at. -->
  <Color name="Shape"   foreground="#4EC9B0" />              <!-- $ teal   — data that attaches   -->
  <Color name="Mark"    foreground="#C586C0" />              <!-- # mauve  — a tag                -->
  <Color name="Event"   foreground="#DCDCAA" />              <!-- @ gold   — a message            -->
  <Color name="Builder" foreground="#E09B5A" />              <!-- & amber  — an identity template -->
  <Color name="Sigil"   foreground="#4EC9B0" />

  <RuleSet ignoreCase="false">
    <Span color="Comment" begin="//" />
    <Span color="Comment" multiline="true" begin="/\*" end="\*/" />

    <Span color="String">
      <Begin>"</Begin>
      <End>"</End>
      <RuleSet>
        <Span begin="\\" end="." />
      </RuleSet>
    </Span>

    <!-- One rule each, so the four read apart at a glance. `&Builder` had no rule at all before and
         rendered as plain text. -->
    <Rule color="Shape">\$[A-Za-z_][A-Za-z0-9_]*</Rule>
    <!-- `[#]` and NOT a bare `#`: these patterns are compiled with IgnorePatternWhitespace, under
         which `#` starts a regex COMMENT — the rest of the line vanishes, the pattern matches zero
         characters, and AvaloniaEdit throws on the first highlighted line. The Workbench would not
         open at all. A character class sidesteps it, which is why the original single rule used one. -->
    <Rule color="Mark">[#][A-Za-z_][A-Za-z0-9_]*</Rule>
    <Rule color="Event">@[A-Za-z_][A-Za-z0-9_]*</Rule>
    <Rule color="Builder">&amp;[A-Za-z_][A-Za-z0-9_]*</Rule>

    <!-- `?` fill-the-rest placeholder in emit/bring -->
    <Rule color="Sigil">\?</Rule>

    <!-- EVERY lexer keyword, and nothing else. SyntaxThemeTests checks this list against
         `Lexer.KeywordNames` in both directions, because drift here fails nothing: a keyword the theme
         omits simply renders as plain text, which reads as "not a keyword". `app`, `by`, `transform`,
         `mute`/`unmute`, `on`, `base` and `Index` were all missing; `random` and `in` were painted and
         are not keywords at all — `random()` is a built-in FUNCTION (removing it from the lexer is what
         made `random()` callable), and `in` has never been one. -->
    <Keywords color="Keyword">
      <Word>bundle</Word>   <Word>need</Word>      <Word>use</Word>        <Word>publicator</Word> <Word>shared</Word>
      <Word>shape</Word>    <Word>event</Word>     <Word>shard</Word>      <Word>ShardView</Word>
      <Word>bridge</Word>   <Word>target</Word>    <Word>each</Word>       <Word>tick</Word>
      <Word>settled</Word>  <Word>start</Word>     <Word>hear</Word>       <Word>emit</Word>
      <Word>mark</Word>     <Word>unmark</Word>    <Word>attach</Word>     <Word>unattach</Word>
      <Word>to</Word>       <Word>from</Word>      <Word>destroy</Word>    <Word>chance</Word>
      <Word>folds</Word>    <Word>sync</Word>      <Word>audience</Word>   <Word>as</Word>
      <Word>SF</Word>       <Word>builder</Word>   <Word>bring</Word>      <Word>count</Word>
      <Word>let</Word>      <Word>var</Word>       <Word>return</Word>     <Word>when</Word>
      <Word>else</Word>     <Word>if</Word>        <Word>while</Word>      <Word>repeat</Word>
      <Word>match</Word>    <Word>break</Word>     <Word>continue</Word>   <Word>type</Word>
      <Word>enum</Word>     <Word>fn</Word>        <Word>and</Word>        <Word>or</Word>
      <Word>not</Word>      <Word>true</Word>      <Word>false</Word>      <Word>map</Word>
      <Word>Entity</Word>   <Word>app</Word>       <Word>by</Word>         <Word>transform</Word>
      <Word>mute</Word>     <Word>unmute</Word>    <Word>on</Word>         <Word>base</Word>
      <Word>Index</Word>
    </Keywords>

    <Rule color="Number">\b\d+(\.\d+)?%?\b</Rule>
  </RuleSet>
</SyntaxDefinition>
