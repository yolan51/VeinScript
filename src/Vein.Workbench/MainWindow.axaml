<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:term="using:Vein.Workbench.Terminal"
        xmlns:local="using:Vein.Workbench"
        x:Class="Vein.Workbench.MainWindow"
        Width="1320" Height="860"
        Icon="avares://Vein.Workbench/Assets/VSLOGO.png"
        Title="VeinScript Workbench">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <!-- The logo sits in the menu strip itself, so it is present on every screen without costing a
           row of vertical space the editor would rather have. -->
      <MenuItem Padding="6,0" IsHitTestVisible="False">
        <MenuItem.Header>
          <Image Source="avares://Vein.Workbench/Assets/VSLOGO.png" Height="20" Width="22"
                 Stretch="Uniform" VerticalAlignment="Center" />
        </MenuItem.Header>
      </MenuItem>
      <MenuItem Header="_File">
        <MenuItem Header="_New File" Click="OnNew" InputGesture="Ctrl+N" />
        <MenuItem Header="New _Bundle…" Click="OnNewBundle" />
        <MenuItem Header="New _App…" Click="OnNewApp" />
        <Separator />
        <MenuItem Header="_Open File…" Click="OnOpen" InputGesture="Ctrl+O" />
        <MenuItem Header="_Close Tab" Click="OnCloseTab" InputGesture="Ctrl+W" />
        <MenuItem Header="Open _Folder…" Click="OnOpenFolder" InputGesture="Ctrl+K" />
        <Separator />
        <MenuItem Header="_Save" Click="OnSave" InputGesture="Ctrl+S" />
        <MenuItem Header="Save _As…" Click="OnSaveAs" InputGesture="Ctrl+Shift+S" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Click="OnUndo" InputGesture="Ctrl+Z" />
        <MenuItem Header="_Redo" Click="OnRedo" InputGesture="Ctrl+Y" />
        <Separator />
        <MenuItem Header="Cu_t" Click="OnCut" InputGesture="Ctrl+X" />
        <MenuItem Header="_Copy" Click="OnCopy" InputGesture="Ctrl+C" />
        <MenuItem Header="_Paste" Click="OnPaste" InputGesture="Ctrl+V" />
        <Separator />
        <MenuItem Header="Select _All" Click="OnSelectAll" InputGesture="Ctrl+A" />
        <Separator />
        <MenuItem Header="_Find / Replace…" Click="OnFind" InputGesture="Ctrl+F" />
        <MenuItem Header="_Go to Line…" Click="OnGoToLine" InputGesture="Ctrl+G" />
        <MenuItem Header="Go to _Symbol…" Click="OnGoToSymbol" InputGesture="Ctrl+T" />
        <Separator />
        <MenuItem Header="Toggle _Comment" Click="OnToggleComment" InputGesture="Ctrl+OemQuestion" />
        <MenuItem Header="_Duplicate Line" Click="OnDuplicateLine" InputGesture="Ctrl+D" />
        <MenuItem Header="Move Line _Up" Click="OnMoveLineUp" InputGesture="Alt+Up" />
        <MenuItem Header="Move Line Do_wn" Click="OnMoveLineDown" InputGesture="Alt+Down" />
        <Separator />
        <MenuItem Header="Go to De_finition" Click="OnGoToDefinition" InputGesture="F12" />
        <MenuItem Header="Find _References" Click="OnFindReferences" InputGesture="Shift+F12" />
      </MenuItem>
      <MenuItem Header="_Build">
        <MenuItem Header="_Build" Click="OnBuild" InputGesture="Ctrl+B" />
        <MenuItem Header="Build + _Inspect IR" Click="OnBuildInspect" InputGesture="Ctrl+Shift+B" />
      </MenuItem>
      <MenuItem Header="_Run">
        <MenuItem Header="_Run" Click="OnRun" InputGesture="F5" />
        <MenuItem Header="Run _All Participants" Click="OnRunAll" InputGesture="Ctrl+F5" />
        <MenuItem Header="Run in E_xternal Console" Click="OnRunExternal" InputGesture="Shift+F5" />
        <Separator />
        <MenuItem Header="_Stop All Sessions" Click="OnStopAll" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Toggle _Project Explorer" Click="OnToggleExplorer" />
        <MenuItem Header="Toggle _Bottom Panel" Click="OnToggleBottom" />
        <MenuItem Header="Focus _Terminal" Click="OnFocusTerminal" InputGesture="Ctrl+OemTilde" />
        <Separator />
        <MenuItem Header="Compile as You _Type" Click="OnToggleAutoBuild" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About VeinScript Workbench" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <!-- Toolbar: the run configuration this file declares in its own header, and the controls for it. -->
    <Border DockPanel.Dock="Top" Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,0,0,1" Padding="8,4">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Image Source="avares://Vein.Workbench/Assets/VSLOGO.png" Height="24" Width="26"
               Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
        <Button Name="RunButton" Click="OnRun" Padding="10,2" ToolTip.Tip="Run the selected configuration (F5)">▶</Button>
        <Button Name="RunAllButton" Click="OnRunAll" Padding="10,2" ToolTip.Tip="Start every participant this file declares, in header order (Ctrl+F5)">&#x25B6;&#x25B6;</Button>
        <Button Name="StopButton" Click="OnStopAll" Padding="10,2" ToolTip.Tip="Stop every terminal session">■</Button>
        <ComboBox Name="RunConfigs" MinWidth="150" VerticalAlignment="Center"
                  ToolTip.Tip="Run configurations declared in this file's header" />
        <TextBox Name="RunArgs" MinWidth="420" VerticalAlignment="Center" FontSize="12"
                 FontFamily="Cascadia Code,Consolas,monospace"
                 ToolTip.Tip="The command ▶ will run. Edit it to change --ticks or --port without touching the header." />
        <TextBlock Name="RunHint" VerticalAlignment="Center" Foreground="Gray" FontSize="11" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#252526" Padding="10,3">
      <TextBlock Name="StatusBar" Text="Ready" />
    </Border>

    <Grid RowDefinitions="*,4,240">
      <Grid Grid.Row="0" Name="TopCols" ColumnDefinitions="230,4,*,4,390">
        <DockPanel Grid.Column="0" Name="ExplorerPanel">
          <TextBlock DockPanel.Dock="Top" Text="Project Explorer" Margin="8,6" FontWeight="Bold" />
          <TreeView Name="ProjectTree" DoubleTapped="OnProjectItemActivated" />
        </DockPanel>
        <GridSplitter Grid.Column="1" Width="4" Background="#333" />

        <DockPanel Grid.Column="2">
          <Border DockPanel.Dock="Top" Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,0,0,1">
            <local:EditorTabs Name="FileTabs" />
          </Border>
          <ae:TextEditor Name="Editor"
                         ShowLineNumbers="True"
                         FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="14" />
        </DockPanel>

        <GridSplitter Grid.Column="3" Width="4" Background="#333" />
        <DockPanel Grid.Column="4">
          <Border DockPanel.Dock="Top" Name="BundleInspector" IsVisible="False"
                  Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,0,0,1" Padding="12" />
          <TabControl Name="Inspector">
            <TabItem Header="Outline">
              <local:OutlinePanel Name="Outline" />
            </TabItem>
            <TabItem Header="IR Tree">
              <TreeView Name="IrTree" DoubleTapped="OnIrNodeActivated" />
            </TabItem>
          </TabControl>
        </DockPanel>
      </Grid>

      <GridSplitter Grid.Row="1" Height="4" Background="#333" />

      <TabControl Grid.Row="2" Name="BottomPanel">
        <TabItem Header="Diagnostics">
          <ListBox Name="Diagnostics" DoubleTapped="OnDiagnosticActivated"
                   FontFamily="Cascadia Code,Consolas,monospace" FontSize="13" />
        </TabItem>
        <TabItem Header="Raw IR">
          <ae:TextEditor Name="RawIr" IsReadOnly="True" ShowLineNumbers="False"
                         FontFamily="Cascadia Code,Consolas,monospace" FontSize="13" />
        </TabItem>
        <TabItem Header="Output">
          <ae:TextEditor Name="RunOutput" IsReadOnly="True" ShowLineNumbers="False"
                         FontFamily="Cascadia Code,Consolas,monospace" FontSize="13" />
        </TabItem>
        <TabItem Header="Dependencies">
          <TreeView Name="DepsTree" />
        </TabItem>
        <TabItem Header="Execution">
          <ScrollViewer Name="ExecPanel" Padding="12,8" />
        </TabItem>
        <TabItem Header="Consoles">
          <local:ConsoleTopologyPanel Name="ConsoleTopology" />
        </TabItem>
        <TabItem Header="Preview">
          <local:WebPreviewPanel Name="WebPreview" />
        </TabItem>
        <TabItem Header="Terminal">
          <term:TerminalPanel Name="TerminalPanel" />
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
