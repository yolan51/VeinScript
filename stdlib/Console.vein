// stdlib/Console.vein — VeinScript Standard Library : Vein.Console
// Console I/O as EVENTS. A program emits *Vein.Console.Io.@Print to write a line, and hears
// *Vein.Console.Io.@Input for each line the user types — the runtime bridges these to stdout/stdin.
// Run a console program with:  veinc run <file>
// Discover:  veinc symbols stdlib/Console.vein

bundle Console by Vein {

    publicator Io {
        shared("Write a line of text to the console (stdout).")
        event @Print { text: string }

        // stderr — for what went WRONG, so `tasks list > out.txt` keeps the list in the file and the
        // problem on the screen. With no separate error stream (the Workbench), it lands with the rest.
        shared("Write a line to the error output (stderr).")
        event @PrintError { text: string }

        shared("A line of text the user typed at the console (stdin).")
        event @Input { text: string }

        // A tool's last chance: stdin closed — `tasks < commands.txt` reached the end, or the user typed
        // Ctrl+Z / Ctrl+D. Print the total, save the file, then the run ends.
        shared("Standard input has ended — raised once, before the run finishes; `lines` is how many were read.")
        event @InputEnded { lines: int }

        // What is already queued still runs (a save emitted just before lands), then nothing more is read.
        // `code` is the process exit code: 0 for success, anything else tells a shell or a script it failed.
        shared("Stop the program, with an exit code (0 = success).")
        event @Quit { code: int = 0 }

        shared("Write a line to the console — `bring Line(\"…\")` emits @Print { text }.")
        builder Line { text: string   line = text }

        // A console address is an IDENTITY, not text — write `#Server`, not `"Server"`. The `Mark` type
        // says so, and the compiler warns (VS0212) when an address is never spawned. `#Main` is the
        // reserved address of the root console (the process you launched).
        shared("A named console application to spawn (name identifies it; firsttext is printed on start).")
        event @Console { name: Mark, firsttext: string }

        shared("Send a line to another console — emit @Send { to, text } delivers it to console `to`.")
        event @Send { to: Mark, text: string }

        shared("A message received from another console — hear @Message { from, text }.")
        event @Message { from: Mark, text: string }

        // A console you spawned can be closed at any time; the send simply finds nothing listening. That
        // is ordinary, so it is reported as an event you can hear, not an error that stops the program.
        shared("A line that could not be delivered — console `to` is not running (closed, or not started yet).")
        event @Undelivered { to: Mark, text: string }

        shared("Build a named console application — `bring Console(#Server, \"ready\")` spawns its own window.")
        builder Console { name: Mark, firsttext: string }

        // Emit-only helpers — the same events, named as actions.
        shared("Write a line to this console.")
        SF print(text: string) { emit @Print { text: text } }

        shared("Write a line to the error output (stderr) — for what went wrong.")
        SF printError(text: string) { emit @PrintError { text: text } }

        shared("Send a line to another console by address.")
        SF send(dest: Mark, text: string) { emit @Send { to: dest, text: text } }

        shared("Spawn a named console window.")
        SF spawn(name: Mark, firsttext: string) { emit @Console { name: name, firsttext: firsttext } }

        shared("Stop the program with an exit code — `do quit(0)` for success.")
        SF quit(code: int) { emit @Quit { code: code } }
    }
}
