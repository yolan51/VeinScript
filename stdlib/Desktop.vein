// stdlib/Desktop.vein — VeinScript Standard Library : Vein.Desktop
// Windows and widgets as IDENTITIES. A window carries $Window; a widget carries one of Vein.UI's shapes
// ($Text, $Button, $Field) or this bundle's $Toggle / $Panel, plus *Vein.Core.Relations.$Parent naming the
// window or panel it sits in. The tree is nothing but those links (a relationship is a component, not a
// pointer graph), in spawn order (D13). A host draws it as native controls — the Workbench does, on ▶ — and
// turns what the user does into the events below.
// Discover:  veinc symbols stdlib/Desktop.vein
//
//   need "Vein.Desktop"
//   need "Vein.UI"                                     (for $Text, $Button, $Field and @Clicked)
//   shard Build { run once {
//       bring Window("Notes", 480.0, 360.0) as w
//       bring Label(w, "Hello")
//       bring Button(w, "Save") as save
//       mark save #Save
//   } }
//   shard Clicks { hear *Vein.UI.Interaction.@Clicked as c {
//       target $Button #Save on c.target as b { … }
//   } }
//
// THE IDENTITIES ARE THE TRUTH. To change the screen, change a field: `t.Text.content = "3 left"` is the whole
// of "update the label". What the user types, the host writes into the box's $Field.value before @Edited
// arrives, and a tick into $Toggle.checked before @Toggled — the way it writes $View (docs/HOSTING.md).
//
// To hide a widget and everything in it, mark it *Vein.Graphics.Looks.#Hidden (`need "Vein.Graphics"`); unmark
// to show it. #Accent draws a button in the accent colour. Any widget takes a colour from
// *Vein.Graphics.Looks.$Tint { r, g, b, a } — a button's or panel's background, a text's colour; `a` is how strong.
//
// Every builder takes its PARENT FIRST, then the shape's fields in order (RULES 9). Mark a widget to tell it
// apart from its siblings, and look at the clicked one with `on` (RULES 14f) rather than comparing ids.

bundle Desktop by Vein {

    publicator Widgets {
        shared("A top-level window: its title, its starting size in pixels, and an icon (an image file beside the program).")
        shape $Window { title: string, width: float = 480.0, height: float = 360.0, icon: string = "" }

        shared("A container. Its children stack down, or across when it carries #Row; gap is the space between them.")
        shape $Panel { gap: float = 8.0 }

        shared("A checkbox: what it says, and whether it is ticked.")
        shape $Toggle { label: string, checked: bool = false }

        shared("How tall to draw a picture, in pixels; its width follows the image.")
        shape $Picture { height: float = 32.0 }

        shared("A dropdown: the options it offers, and which one is picked (0 is the first).")
        shape $Choice { ~<list> options: string, picked: int = 0 }

        shared("A slider's range and where it sits. The host writes `value` as it moves.")
        shape $Slider { min: float = 0.0, max: float = 100.0, value: float = 0.0 }

        shared("A progress bar: how far along, out of `max`.")
        shape $Progress { value: float = 0.0, max: float = 1.0 }

        shared("Empty room between widgets, in pixels.")
        shape $Space { size: float = 12.0 }

        shared("A line across a column, `thickness` pixels high.")
        shape $Rule { thickness: float = 1.0 }

        shared("A column that scrolls once its content is taller than `height` pixels.")
        shape $Scroll { height: float = 240.0 }

        shared("A small picture on a button: an image file beside the program, `size` pixels.")
        shape $Icon { source: string, size: float = 18.0 }

        shared("Words shown when the pointer rests on a widget: attach it to any widget.")
        shape $Tip { text: string }

        shared("Two panes side by side, the first `first` pixels wide, with a divider the user can drag.")
        shape $Split { first: float = 220.0 }

        shared("A key that fires a menu item or a button, shown beside it in a menu: attach $Shortcut to save { keys: \"Ctrl+S\" }.")
        shape $Shortcut { keys: string }

        shared("Carried by every window.")
        mark #Window

        shared("Carried by every widget that sits inside a window.")
        mark #Widget

        shared("A panel that lays its children out across instead of down.")
        mark #Row

        // HIDING IS NOT A NEW MARK. *Vein.Graphics.Looks.#Hidden already means "keep it, draw it nowhere" to
        // every host, so a widget wearing it — and everything inside it — is not shown until it is unmarked.
        shared("A button drawn in the accent colour: the selected tab, the main action.")
        mark #Accent

        shared("A $Choice drawn as radio buttons — every option visible — instead of a dropdown.")
        mark #Radio

        shared("A $Toggle drawn as an on/off switch instead of a checkbox.")
        mark #Switch

        shared("A $Text drawn as a small rounded badge: a count, a status.")
        mark #Badge

        shared("A text box for several lines: Enter is a new line, Ctrl+Enter submits.")
        mark #Multiline

        shared("The menu bar along a window's top edge; it holds Menus.")
        mark #MenuBar

        shared("A menu in a menu bar (or a submenu in a menu); it holds MenuItems.")
        mark #Menu

        shared("An item in a menu. A click is @Clicked, as a button's is; an item labelled \"-\" is a separator.")
        mark #MenuItem

        shared("A row of buttons along a window's top edge, under its menu bar.")
        mark #Toolbar

        shared("A row along a window's bottom edge: where things stand.")
        mark #StatusBar

        shared("A widget the user can drag onto another #Draggable one; the host then raises @Dropped { target, onto }.")
        mark #Draggable

        shared("A button drawn flat, as an item of a list: a sidebar's projects, a folder's files.")
        mark #Flat

        shared("A window: bring Window(\"Notes\", 480.0, 360.0, \"icon.png\") as w, then bring widgets into w.")
        builder Window { $Window   mark #Window }

        shared("A column of widgets inside parent: bring Column(w, 4.0) as list.")
        builder Column { *Vein.Core.Relations.$Parent  $Panel   mark #Widget }

        shared("A row of widgets inside parent, side by side.")
        builder Row { *Vein.Core.Relations.$Parent  $Panel   mark #Widget #Row }

        shared("A line of text inside parent.")
        builder Label { *Vein.Core.Relations.$Parent  *Vein.UI.Widgets.$Text   mark #Widget }

        shared("Text at a size: bring Heading(w, \"To-do\", 22.0).")
        builder Heading { *Vein.Core.Relations.$Parent  *Vein.UI.Widgets.$Text  *Vein.UI.Widgets.$Font   mark #Widget }

        shared("A button inside parent. A click arrives as *Vein.UI.Interaction.@Clicked { target }.")
        builder Button { *Vein.Core.Relations.$Parent  *Vein.UI.Widgets.$Button   mark #Widget }

        shared("A text box inside parent: bring Input(w, \"\", \"What needs doing?\") as box.")
        builder Input { *Vein.Core.Relations.$Parent  *Vein.UI.Widgets.$Field   mark #Widget }

        shared("A checkbox inside parent: bring Check(row, \"Buy milk\", false).")
        builder Check { *Vein.Core.Relations.$Parent  $Toggle   mark #Widget }

        shared("A dropdown inside parent: bring Dropdown(row, [\"Low\", \"High\"], 0) as pick. A pick arrives as @Picked.")
        builder Dropdown { *Vein.Core.Relations.$Parent  $Choice   mark #Widget }

        shared("A slider: bring Slider(row, 0.0, 10.0, 5.0) as s. A move arrives as @Slid.")
        builder Slider { *Vein.Core.Relations.$Parent  $Slider   mark #Widget }

        shared("A progress bar: bring Progress(group, 3.0, 5.0) — 3 of 5.")
        builder Progress { *Vein.Core.Relations.$Parent  $Progress   mark #Widget }

        shared("Empty room: bring Spacer(w, 16.0).")
        builder Spacer { *Vein.Core.Relations.$Parent  $Space   mark #Widget }

        shared("A line across a column: bring Divider(w, 1.0).")
        builder Divider { *Vein.Core.Relations.$Parent  $Rule   mark #Widget }

        shared("A column that scrolls past height pixels: bring Scroll(w, 300.0) as list, then bring rows into list.")
        builder Scroll { *Vein.Core.Relations.$Parent  $Scroll  $Panel   mark #Widget }

        shared("Radio buttons: bring Radios(w, [\"Small\", \"Large\"], 0). A pick arrives as @Picked.")
        builder Radios { *Vein.Core.Relations.$Parent  $Choice   mark #Widget #Radio }

        shared("An on/off switch: bring Switch(w, \"Dark mode\", false). A flip arrives as @Toggled.")
        builder Switch { *Vein.Core.Relations.$Parent  $Toggle   mark #Widget #Switch }

        shared("A small rounded label: bring Badge(row, \"3\").")
        builder Badge { *Vein.Core.Relations.$Parent  *Vein.UI.Widgets.$Text   mark #Widget #Badge }

        shared("A button with a picture: bring IconButton(row, \"trash.png\", 16.0, \"\") — label may be empty.")
        builder IconButton { *Vein.Core.Relations.$Parent  $Icon  *Vein.UI.Widgets.$Button   mark #Widget }

        shared("A text box for several lines: bring TextArea(w, \"\", \"Notes…\"). Ctrl+Enter submits.")
        builder TextArea { *Vein.Core.Relations.$Parent  *Vein.UI.Widgets.$Field   mark #Widget #Multiline }

        shared("An image file beside the program, drawn height pixels tall: bring Picture(w, \"logo.png\", 32.0).")
        builder Picture { *Vein.Core.Relations.$Parent  *Vein.UI.Widgets.$Image  $Picture   mark #Widget }

        // ---- an application's frame: a menu bar, a toolbar, a status bar, and a split ----------------------
        // A window lays these out by kind, whatever order they are brought in: menu bars and toolbars along the top,
        // status bars along the bottom, a Split filling the rest. A window without them is a column, as before.

        shared("The menu bar of window: bring MenuBar(w) as bar, then Menu(bar, \"File\").")
        builder MenuBar { *Vein.Core.Relations.$Parent  $Panel   mark #Widget #MenuBar }

        shared("A menu in a menu bar, or a submenu in a menu: bring Menu(bar, \"File\") as file.")
        builder Menu { *Vein.Core.Relations.$Parent  *Vein.UI.Widgets.$Button   mark #Widget #Menu }

        shared("An item of a menu; a click is @Clicked. \"-\" draws a separator: bring MenuItem(file, \"Save\") as save.")
        builder MenuItem { *Vein.Core.Relations.$Parent  *Vein.UI.Widgets.$Button   mark #Widget #MenuItem }

        shared("A toolbar along the window's top, under its menu bar: bring Toolbar(w, 6.0) as tools.")
        builder Toolbar { *Vein.Core.Relations.$Parent  $Panel   mark #Widget #Row #Toolbar }

        shared("A status bar along the window's bottom: bring StatusBar(w, 12.0) as status.")
        builder StatusBar { *Vein.Core.Relations.$Parent  $Panel   mark #Widget #Row #StatusBar }

        shared("Two panes side by side: its first child on the left, `first` pixels wide; its second fills the rest.")
        builder Split { *Vein.Core.Relations.$Parent  $Split   mark #Widget }

        // REMOVAL WALKS DOWN. The runtime raises no @Destroyed (stdlib/Core.vein leaves teardown to the
        // program), so taking a row away would leave its checkbox behind, parented to nothing. This takes the
        // identity and everything under it, at any depth — and everything it OWNS (*Vein.Core.Relations.$Owner):
        // a group's tab sits in the tab row, not under the group, but it ends with the group. Written qualified:
        // a shared SF runs INLINE in the caller, which may not have `need`ed this bundle by name. (`remove` is
        // the list built-in, VS0361.)
        shared("Remove a window or widget, everything inside it, and everything it owns: do discard(row).")
        SF discard(e: Entity) {
            target $Parent as child {
                if child.Parent.of == e { do *Vein.Desktop.Widgets.discard(child) }
            }
            target $Owner as owned {
                if owned.Owner.ownerId == e { do *Vein.Desktop.Widgets.discard(owned) }
            }
            destroy e
        }
    }

    publicator Events {
        shared("From the host: the text in a box changed. $Field.value already holds it.")
        event @Edited { target: Entity, value: string }

        shared("From the host: Enter was pressed in a box.")
        event @Submitted { target: Entity, value: string }

        shared("From the host: a checkbox was ticked or unticked. $Toggle.checked already holds it.")
        event @Toggled { target: Entity, checked: bool }

        shared("From the host: an option was picked in a dropdown or radio group. $Choice.picked already holds it.")
        event @Picked { target: Entity, picked: int, option: string }

        shared("From the host: a slider moved. $Slider.value already holds it.")
        event @Slid { target: Entity, value: float }

        // What a drop MEANS — a tab moved, a card filed — is the program's: the host only says which onto which.
        shared("From the host: the user dragged #Draggable widget `target` and let go over #Draggable widget `onto`.")
        event @Dropped { target: Entity, onto: Entity }

        shared("From the host: the user closed a window. The host then removes it, and everything in it.")
        event @WindowClosed { target: Entity }

        // ---- file dialogs: the program asks, the host shows the operating system's own dialog ----

        shared("Ask the user for a file to OPEN, with the system dialog. `extension` filters it (\"plan\"); the answer is @FilePicked or @PickCancelled.")
        event @PickOpenFile { title: string = "Open", extension: string = "", tag: string = "" }

        shared("Ask the user where to SAVE, with the system dialog, starting from `suggested`. The answer is @FilePicked or @PickCancelled.")
        event @PickSaveFile { title: string = "Save as", extension: string = "", suggested: string = "", tag: string = "" }

        shared("From the host: the file the user chose — a full path. `tag` is the request's.")
        event @FilePicked { path: string, tag: string = "" }

        shared("From the host: the dialog was closed without a choice — or there is no window to show one in (`veinc run`).")
        event @PickCancelled { tag: string = "", reason: string = "" }
    }

    // ---- a document app's shell, as TEMPLATES (D27) ------------------------------------------------------------
    //
    // Everything a program that opens and saves files repeats: the File menu and toolbar (New, Open…, Save, Save as…
    // with their shortcuts), the system dialogs, "unsaved — do it again to discard", recent files, the files beside
    // the open one, the window's title with its unsaved dot, a status bar. Nothing here runs by itself; a program
    // takes it with two lines and writes only its own part:
    //
    //   bring Document("Planner", "example.plan", "plan", false, false, [], [])     // title, first file, extension
    //   ShardView Main from *Vein.Desktop.Document.!DocumentWindow { Content { …its own widgets… } }
    //   shard Files from *Vein.Desktop.Document.!DocumentFiles
    //
    // and three HOOKS the files shard calls:
    //
    //   SF documentNew()                      start an empty document
    //   SF documentLoaded(text: string)       open one from its text
    //   fn documentText() return string       the text to save
    //
    // A change the user makes is `emit *Vein.Desktop.Document.@DocumentChanged { }`. The window's slots are Menus (after
    // File), Tools (after New/Open/Save), Sidebar (above Recent), Content (the main pane) and Status.
    publicator Document {
        shared("A recently opened file, listed in the sidebar.")
        shape $RecentFile { path: string }

        shared("A file beside the open one, of the same kind, listed in the sidebar.")
        shape $FolderFile { name: string, path: string }

        shared("The open document: its window title, its file (\"\" until saved), its extension, and whether it changed.")
        shape $Document {
            title: string, file: string = "", extension: string = "txt", dirty: bool = false, warned: bool = false,
            ~<list> recents: owns $RecentFile, ~<list> entries: owns $FolderFile
        }

        shared("The document a program opens and saves: bring Document(\"Notes\", \"notes.txt\", \"txt\", false, false, [], []).")
        builder Document { $Document   mark #Document }
        shared("A recent file.")
        builder RecentFile { $RecentFile   mark #RecentFile }
        shared("A file beside the open one.")
        builder FolderFile { $FolderFile   mark #FolderFile }
        shared("The recent files, as `<extension>.recent.json` beside the program.")
        loom<Json> SavedRecentFile { $RecentFile   mark #RecentFile }

        shared("Carried by the document.")
        mark #Document
        shared("Carried by a recent file.")
        mark #RecentFile
        shared("Carried by a file beside the open one.")
        mark #FolderFile
        shared("File ▸ New, and the toolbar's New.")
        mark #DocNew
        shared("File ▸ Open…, and the toolbar's Open.")
        mark #DocOpen
        shared("File ▸ Save, and the toolbar's Save.")
        mark #DocSave
        shared("File ▸ Save as….")
        mark #DocSaveAs
        shared("A recent file's entry in the sidebar.")
        mark #DocRecent
        shared("A sidebar entry for a file beside the open one.")
        mark #DocEntry
        shared("The status bar's file name.")
        mark #DocFileLabel
        shared("The status bar's saved / unsaved.")
        mark #DocSaveLabel
        shared("Tag of the document's own reads and writes.")
        mark #DocFile
        shared("Tag of the recent files' reads and writes.")
        mark #DocRecents
        shared("Tag of the listing of the open file's folder.")
        mark #DocFolder
        shared("Tag of the Open dialog.")
        mark #DocOpenPick
        shared("Tag of the Save as dialog.")
        mark #DocSavePick

        shared("The user changed the document: it is unsaved now. Emit it from every change.")
        event @DocumentChanged { }
        shared("Start an empty document (the files shard then calls documentNew).")
        event @DocumentFresh { }
        shared("The recent files changed: they are written at the end of the frame.")
        event @DocumentRecentsChanged { }

        shared("A document app's window: menu bar, toolbar, a sidebar of recent and nearby files, the main pane, a status bar.")
        ShardView DocumentWindow on $Document as d {
            Window(d.Document.title, 1120.0, 700.0) {
                MenuBar() slot Menus {
                    Menu("File") {
                        MenuItem("New") mark #DocNew as newItem
                        attach $Shortcut to newItem { keys: "Ctrl+N" }
                        MenuItem("Open…") mark #DocOpen as openItem
                        attach $Shortcut to openItem { keys: "Ctrl+O" }
                        MenuItem("Save") mark #DocSave as saveItem
                        attach $Shortcut to saveItem { keys: "Ctrl+S" }
                        MenuItem("Save as…") mark #DocSaveAs as saveAsItem
                        attach $Shortcut to saveAsItem { keys: "Ctrl+Shift+S" }
                    }
                }
                Toolbar(6.0) slot Tools {
                    Button("New") mark #DocNew
                    Button("Open") mark #DocOpen
                    Button("Save") mark #DocSave
                    Spacer(16.0)
                }
                Split(250.0) {
                    Scroll(4000.0, 6.0) {
                        Column(6.0) slot Sidebar
                        Divider(1.0)
                        Heading("Recent", 14.0)
                        Column(2.0) socket !RecentFileItem(d.Document.~recents)
                        Heading("In this folder", 14.0)
                        Column(2.0) socket !FolderFileItem(d.Document.~entries)
                    }
                    Scroll(4000.0, 8.0) {
                        Column(8.0) slot Content
                    }
                }
                StatusBar(20.0) slot Status {
                    Label("") mark #DocFileLabel
                    Label("") mark #DocSaveLabel
                }
            }
        }

        shared("A recent file in the sidebar: a click opens it.")
        ShardView RecentFileItem on $RecentFile as r {
            Button(*Vein.Files.Io.fileName(r.RecentFile.path)) mark #Flat #DocRecent as item
            attach $Tip to item { text: r.RecentFile.path }
        }

        shared("A file beside the open one, in the sidebar: a click opens it.")
        ShardView FolderFileItem on $FolderFile as e {
            Button(e.FolderFile.name) mark #Flat #DocEntry
        }

        // The file side. It CALLS the program's hooks — documentNew(), documentLoaded(text), documentText() — which a
        // copy made with `from` resolves in the program, where they are written.
        shared("A document app's files: New, Open…, Save, Save as…, unsaved warnings, recents, the folder, the title.")
        shard DocumentFiles {
            var recentsChanged = false
            var started = false

            hear *Vein.UI.Interaction.@Clicked as k {
                target $Button #DocNew on k.target as b { do docLeave("new", "") }
                target $Button #DocOpen on k.target as b { do docLeave("pick", "") }
                target $Button #DocSave on k.target as b { do docSave(false) }
                target $Button #DocSaveAs on k.target as b { do docSave(true) }
                target $Owner #DocRecent on k.target as b { target $RecentFile on b.Owner.ownerId as r { do docLeave("open", r.RecentFile.path) } }
                target $Owner #DocEntry on k.target as b { target $FolderFile on b.Owner.ownerId as e { do docLeave("open", e.FolderFile.path) } }
            }

            hear @DocumentFresh as x {
                do documentNew()
                target $Document as d {
                    d.Document.file = ""
                    d.Document.dirty = false
                    d.Document.warned = false
                }
            }

            hear @DocumentChanged as c {
                target $Document as d {
                    d.Document.dirty = true
                    d.Document.warned = false
                }
            }

            hear *Vein.Files.Io.@FileLoaded as f {
                if f.tag == #DocRecents { weave SavedRecentFile(f.text) }
                if f.tag == #DocFile {
                    do documentLoaded(f.text)
                    do docOpened(f.full)
                }
            }

            hear *Vein.Files.Io.@FileMissing as f {
                if f.tag == #DocFile { emit @DocumentFresh { } }
            }

            hear @Woven as w {
                if w.loom == "SavedRecentFile" {
                    target $Document as d {
                        target $RecentFile as r { if not (d.Document.~recents has r) { d.Document.~recents.add(r) } }
                    }
                }
            }

            hear *Vein.Desktop.Events.@FilePicked as p {
                if p.tag == #DocOpenPick { emit *Vein.Files.Io.@ReadFile { path: p.path, tag: #DocFile } }
                if p.tag == #DocSavePick { emit *Vein.Files.Io.@WriteFile { path: p.path, text: documentText(), append: false, tag: #DocFile } }
            }

            hear *Vein.Files.Io.@FileWritten as w {
                if w.tag == #DocFile { do docOpened(w.full) }
            }

            // "In this folder": every file of the document's extension beside the open one.
            hear *Vein.Files.Io.@FolderListed as f {
                if f.tag == #DocFolder {
                    target $Document as d {
                        d.Document.~entries.clear()
                        target f.entries as name {
                            if endsWith(name, "." + d.Document.extension) {
                                bring FolderFile(name, f.full + "/" + name) as entry
                                d.Document.~entries.add(entry)
                            }
                        }
                    }
                }
            }

            hear @DocumentRecentsChanged as r { recentsChanged = true }

            settled {
                target $Document as d {
                    // Started on the first frame the document exists — not in `run once`, which cannot see a document
                    // the program brings in its own `run once` (that bring commits after both have run).
                    if not started {
                        started = true
                        emit *Vein.Files.Io.@ReadFile { path: d.Document.extension + ".recent.json", tag: #DocRecents }
                        if d.Document.file == "" { emit @DocumentFresh { } } else { emit *Vein.Files.Io.@ReadFile { path: d.Document.file, tag: #DocFile } }
                    }
                    if recentsChanged {
                        emit *Vein.Files.Io.@WriteFile { path: d.Document.extension + ".recent.json", text: toText<Json>(SavedRecentFile), append: false, tag: #DocRecents }
                        recentsChanged = false
                    }
                    var name = "untitled"
                    if not (d.Document.file == "") { name = *Vein.Files.Io.fileName(d.Document.file) }
                    var dot = ""
                    if d.Document.dirty { dot = " •" }
                    target $Owner $Window as w { if w.Owner.ownerId == d { w.Window.title = d.Document.title + " — " + name + dot } }
                    target $Text #DocFileLabel as t { t.Text.content = name }
                    target $Text #DocSaveLabel as t {
                        t.Text.content = "saved"
                        if d.Document.dirty { t.Text.content = "unsaved" }
                        if d.Document.warned { t.Text.content = "Unsaved changes — Save first, or do it again to discard them" }
                    }
                    // The folder listing writes `dir/name`, a dialog `dir\name`: compare the names.
                    target $Owner #DocEntry as item {
                        target $FolderFile on item.Owner.ownerId as e { if e.FolderFile.name == name { mark item #Accent } else { unmark item #Accent } }
                    }
                }
            }

            // New, Open and the sidebar's files leave the open document. Unsaved, the first try only warns.
            SF docLeave(what: string, path: string) {
                target $Document as d {
                    if d.Document.dirty and not d.Document.warned {
                        d.Document.warned = true
                    } else {
                        if what == "new" { emit @DocumentFresh { } }
                        if what == "pick" { emit *Vein.Desktop.Events.@PickOpenFile { title: "Open", extension: d.Document.extension, tag: #DocOpenPick } }
                        if what == "open" { emit *Vein.Files.Io.@ReadFile { path: path, tag: #DocFile } }
                    }
                }
            }

            SF docSave(asNew: bool) {
                target $Document as d {
                    if asNew or d.Document.file == "" {
                        var suggested = "untitled." + d.Document.extension
                        if not (d.Document.file == "") { suggested = *Vein.Files.Io.fileName(d.Document.file) }
                        emit *Vein.Desktop.Events.@PickSaveFile { title: "Save as", extension: d.Document.extension, suggested: suggested, tag: #DocSavePick }
                    } else {
                        emit *Vein.Files.Io.@WriteFile { path: d.Document.file, text: documentText(), append: false, tag: #DocFile }
                    }
                }
            }

            // Opened or saved: this is the document's file now, as it is on disk; remembered; its folder listed.
            SF docOpened(full: string) {
                target $Document as d {
                    d.Document.file = full
                    d.Document.dirty = false
                    d.Document.warned = false
                }
                var known = false
                target $RecentFile as r { if lower(r.RecentFile.path) == lower(full) { known = true } }
                if not known {
                    bring RecentFile(full) as recent
                    target $Document as d {
                        d.Document.~recents.add(recent)
                        var held = 0
                        target d.Document.~recents as r { held += 1 }
                        if held > 6 { target d.Document.~recents as r { if Index == 0 { d.Document.~recents.remove(r) } } }
                    }
                    emit @DocumentRecentsChanged { }
                }
                emit *Vein.Files.Io.@ListFolder { path: *Vein.Files.Io.folderOf(full), tag: #DocFolder }
            }
        }
    }

    // ---- tabs, as TEMPLATES (D27) ------------------------------------------------------------------------------
    //
    // Attach $Tab { label } to anything that should have a tab (a project, a file, a map), keep a $TabStrip whose
    // `~tabs` lists them in order, and take the view and the shard:
    //
    //   ShardView MyTab from *Vein.Desktop.Tabs.!TabItem              then: Row(2.0) socket !MyTab(x.TabStrip.~tabs)
    //   shard Tabs from *Vein.Desktop.Tabs.!TabActions
    //
    // A click shows a tab, × closes it (the thing stays — only the tab goes), a drag onto another tab moves it there,
    // and a thing marked #TabUnsaved shows a dot. `open` is the open tab's PLACE in `~tabs`, so it saves as a number;
    // openTabOf(strip) is the thing itself. A sidebar opens one with `do openTab(strip, thing)`.
    publicator Tabs {
        shared("What a tab says. Attach it to anything that should have a tab.")
        shape $Tab { label: string }

        shared("Tabs in order, and the place of the open one (-1 while none is open).")
        shape $TabStrip { open: int = 0, ~<list> tabs: $Tab }

        shared("A tab strip: bring TabStrip(0, [a, b]), or include $TabStrip in a builder of your own.")
        builder TabStrip { $TabStrip   mark #TabStrip }

        shared("Carried by a tab strip.")
        mark #TabStrip
        shared("A tab: its label and its ×, dragged as one.")
        mark #TabItem
        shared("A tab's label: a click shows it.")
        mark #TabLabel
        shared("A tab's ×: a click closes it.")
        mark #TabClose
        shared("On a thing with a tab: it changed since it was saved, and its tab shows a dot.")
        mark #TabUnsaved

        shared("A tab, as the Workbench draws one: a label and a ×; drag it onto another tab to move it there.")
        ShardView TabItem on $Tab as t {
            Row(0.0) mark #TabItem #Draggable {
                Button(t.Tab.label) mark #Flat #TabLabel
                Button("×") mark #Flat #TabClose as close
                attach $Tip to close { text: "Close this tab" }
            }
        }

        shared("Tabs that work: click to show, × to close, drag to move, a dot while unsaved, the open one accented.")
        shard TabActions {
            hear *Vein.UI.Interaction.@Clicked as k {
                target $Owner #TabLabel on k.target as b { target $TabStrip as s { if s.TabStrip.~tabs has b.Owner.ownerId { do openTab(s, b.Owner.ownerId) } } }
                target $Owner #TabClose on k.target as b { target $TabStrip as s { if s.TabStrip.~tabs has b.Owner.ownerId { do closeTab(s, b.Owner.ownerId) } } }
            }

            hear *Vein.Desktop.Events.@Dropped as d {
                target $Owner #TabItem on d.target as dragged {
                    target $Owner #TabItem on d.onto as under {
                        target $TabStrip as s {
                            if s.TabStrip.~tabs has dragged.Owner.ownerId { do moveTab(s, dragged.Owner.ownerId, under.Owner.ownerId) }
                        }
                    }
                }
            }

            settled {
                target $TabStrip as s {
                    target s.TabStrip.~tabs as thing {
                        let place = Index
                        target $Owner $Button #TabLabel as label {
                            if label.Owner.ownerId == thing {
                                if place == s.TabStrip.open { mark label #Accent } else { unmark label #Accent }
                                if thing carries #TabUnsaved { label.Button.label = thing.Tab.label + "  •" } else { label.Button.label = thing.Tab.label }
                            }
                        }
                    }
                }
            }
        }

        shared("Show `thing` in its tab — opened at the end when it had none.")
        SF openTab(strip: Entity, thing: Entity) {
            target $TabStrip on strip as s {
                var at = -1
                var total = 0
                target s.TabStrip.~tabs as x {
                    if x == thing { at = Index }
                    total += 1
                }
                if at < 0 {
                    s.TabStrip.~tabs.add(thing)
                    at = total
                }
                s.TabStrip.open = at
            }
        }

        shared("Close `thing`'s tab; the thing stays. The tab beside it opens when it was the open one.")
        SF closeTab(strip: Entity, thing: Entity) {
            target $TabStrip on strip as s {
                var at = -1
                var total = 0
                target s.TabStrip.~tabs as x {
                    if x == thing { at = Index }
                    total += 1
                }
                if at >= 0 {
                    s.TabStrip.~tabs.remove(thing)
                    if s.TabStrip.open > at { s.TabStrip.open = s.TabStrip.open - 1 }
                    if s.TabStrip.open >= total - 1 { s.TabStrip.open = total - 2 }
                }
            }
        }

        shared("Move `thing`'s tab to where `under`'s is; the open tab stays the open one.")
        SF moveTab(strip: Entity, thing: Entity, under: Entity) {
            target $TabStrip on strip as s {
                var src = -1
                var dst = -1
                target s.TabStrip.~tabs as x {
                    if x == thing { src = Index }
                    if x == under { dst = Index }
                }
                if src >= 0 and dst >= 0 {
                    s.TabStrip.~tabs.move(thing, dst)
                    let open = s.TabStrip.open
                    if open == src { s.TabStrip.open = dst }
                    if src < open and open <= dst { s.TabStrip.open = open - 1 }
                    if dst <= open and open < src { s.TabStrip.open = open + 1 }
                }
            }
        }

        shared("The thing whose tab is open, or 0 when none is.")
        fn openTabOf(strip: Entity) return Entity {
            var found = 0
            target $TabStrip on strip as s { target s.TabStrip.~tabs as x { if Index == s.TabStrip.open { found = x } } }
            return found
        }
    }

    // ---- boards: lanes of cards, as a board or as a list (TEMPLATES, D27) --------------------------------------
    //
    //   ShardView MyBoard from *Vein.Desktop.Board.!BoardPage { Tools { …the app's buttons… } }
    //   ShardView MyList from *Vein.Desktop.Board.!BoardList
    //   shard Boards from *Vein.Desktop.Board.!BoardActions
    //   SF boardChanged(board: Entity) { … }          the hook: the user changed this board
    //
    // Inside a board everything is done: add and remove lanes and cards, move a card a lane left or right, tick it,
    // give it a priority (its colour), counts and progress, and hiding done cards when a $TaskBoardLooks says so.
    publicator Board {
        shared("A card: what it says, whether it is done, its priority (1 Low … 4 Very high).")
        shape $TaskCard { id: string, title: string, done: bool = false, priority: int = 1 }
        shared("A lane of cards, in order.")
        shape $TaskLane { id: string, name: string, ~<list> cards: owns $TaskCard }
        shared("A board of lanes, in order.")
        shape $TaskBoard { id: string, name: string, ~<list> lanes: owns $TaskLane }
        shared("How boards are shown: attach one anywhere; `hideDone` hides done cards.")
        shape $TaskBoardLooks { hideDone: bool = false }

        shared("A card: bring TaskCard(\"c1\", \"Write the copy\", false, 3).")
        builder TaskCard { $TaskCard   mark #TaskCard }
        shared("A lane: bring TaskLane(\"l1\", \"To do\", [cards…]).")
        builder TaskLane { $TaskLane   mark #TaskLane }
        shared("A board: bring TaskBoard(\"b1\", \"Website\", [lanes…]).")
        builder TaskBoard { $TaskBoard   mark #TaskBoard }
        shared("Cards as JSON records — the cards of every board.")
        loom<Json> SavedTaskCard { $TaskCard   mark #TaskCard }
        shared("Lanes as JSON records, their cards by id.")
        loom<Json> SavedTaskLane { $TaskLane   mark #TaskLane }

        shared("Carried by a card.")
        mark #TaskCard
        shared("Carried by a lane.")
        mark #TaskLane
        shared("Carried by a board.")
        mark #TaskBoard
        shared("A board page's root.")
        mark #BoardPage
        shared("A list page's root.")
        mark #ListPage
        shared("A card on the board.")
        mark #Tile
        shared("A card in the list.")
        mark #Line
        shared("A board's new-lane box.")
        mark #LaneName
        shared("A board's Add lane.")
        mark #AddLane
        shared("A lane's ✕.")
        mark #DropLane
        shared("A lane's new-card box.")
        mark #CardName
        shared("A list section's priority for a new card.")
        mark #NewPriority
        shared("A lane's add-card button.")
        mark #AddCard
        shared("A card's ←.")
        mark #MoveLeft
        shared("A card's →.")
        mark #MoveRight
        shared("A card's ✕.")
        mark #DeleteCard
        shared("A card's checkbox.")
        mark #Done
        shared("A card's priority.")
        mark #Priority
        shared("A lane's count.")
        mark #LaneCount
        shared("A list section's \"2 of 3 left\".")
        mark #LaneStatus
        shared("A list section's progress.")
        mark #LaneBar
        shared("A list page's \"4 of 7 tasks done\".")
        mark #BoardProgress

        shared("A board: its name, the app's Tools, a new-lane box, and its lanes as columns of cards.")
        ShardView BoardPage on $TaskBoard as p {
            Column(12.0) mark #BoardPage {
                Row(8.0) slot Tools {
                    Heading(p.TaskBoard.name, 22.0)
                    Input("", "New lane") mark #LaneName
                    Button("Add lane") mark #AddLane
                }
                Row(16.0) socket !LaneColumn(p.TaskBoard.~lanes)
            }
        }

        shared("A lane on a board: its name and count, its cards, a new-card box.")
        ShardView LaneColumn on $TaskLane as l {
            Column(6.0) {
                Row(6.0) {
                    Heading(l.TaskLane.name, 16.0)
                    Badge("0") mark #LaneCount
                    Button("✕") mark #DropLane as drop
                    attach $Tip to drop { text: "Remove this lane and its cards" }
                }
                Column(6.0) socket !CardTile(l.TaskLane.~cards)
                Row(4.0) {
                    Input("", "New card") mark #CardName
                    Button("+") mark #AddCard
                }
            }
        }

        shared("A card on a board: its priority, ← → to move it, ✕, and its checkbox.")
        ShardView CardTile on $TaskCard as c {
            Column(2.0) mark #Tile {
                Row(4.0) {
                    Dropdown(levels(), c.TaskCard.priority - 1) mark #Priority as chip
                    attach $Tint to chip { r: 0.92, g: 0.26, b: 0.21, a: intensity(c.TaskCard.priority) }
                    Button("←") mark #MoveLeft
                    Button("→") mark #MoveRight
                    Button("✕") mark #DeleteCard
                }
                Check(c.TaskCard.title, c.TaskCard.done) mark #Done
            }
        }

        shared("A board as a list: its name, the app's Tools, how much is done, and a section per lane.")
        ShardView BoardList on $TaskBoard as p {
            Column(12.0) mark #ListPage {
                Row(8.0) slot Tools { Heading(p.TaskBoard.name, 22.0) }
                Label("") mark #BoardProgress
                Column(16.0) socket !LaneSection(p.TaskBoard.~lanes)
            }
        }

        shared("A lane as a list section: name, what is left, progress, its cards, and a box to add one.")
        ShardView LaneSection on $TaskLane as l {
            Column(6.0) {
                Row(8.0) {
                    Heading(l.TaskLane.name, 16.0)
                    Label("") mark #LaneStatus
                }
                Progress(0.0, 1.0) mark #LaneBar
                Column(2.0) socket !CardLine(l.TaskLane.~cards)
                Row(6.0) {
                    Input("", "Add a task to " + l.TaskLane.name) mark #CardName
                    Dropdown(levels(), 0) mark #NewPriority
                    Button("Add") mark #AddCard
                }
            }
        }

        shared("A card in a list: its priority, its checkbox, ✕.")
        ShardView CardLine on $TaskCard as c {
            Row(8.0) mark #Line {
                Dropdown(levels(), c.TaskCard.priority - 1) mark #Priority as chip
                attach $Tint to chip { r: 0.92, g: 0.26, b: 0.21, a: intensity(c.TaskCard.priority) }
                Check(c.TaskCard.title, c.TaskCard.done) mark #Done
                Button("✕") mark #DeleteCard
            }
        }

        // Every change it makes, it reports through the hook `boardChanged(board)` — the program's.
        shared("Boards that work: lanes and cards added, removed, moved, ticked, prioritised; counts; hide done.")
        shard BoardActions {
            hear *Vein.UI.Interaction.@Clicked as k {
                target $Owner #AddLane on k.target as b { do addLane(b.Owner.ownerId) }
                target $Owner #DropLane on k.target as b { do dropLane(b.Owner.ownerId) }
                target $Owner #AddCard on k.target as b { do addCard(b.Owner.ownerId) }
                target $Owner #MoveLeft on k.target as b { do moveCard(b.Owner.ownerId, -1) }
                target $Owner #MoveRight on k.target as b { do moveCard(b.Owner.ownerId, 1) }
                target $Owner #DeleteCard on k.target as b { do deleteCard(b.Owner.ownerId) }
            }

            hear @Submitted as s {
                target $Owner #LaneName on s.target as f { do addLane(f.Owner.ownerId) }
                target $Owner #CardName on s.target as f { do addCard(f.Owner.ownerId) }
            }

            hear @Toggled as e {
                target $Owner #Done on e.target as box {
                    target $TaskCard on box.Owner.ownerId as c { c.TaskCard.done = e.checked }
                    do boardChanged(boardOfCard(box.Owner.ownerId))
                }
            }

            hear @Picked as e {
                target $Owner #Priority on e.target as pick {
                    target $TaskCard on pick.Owner.ownerId as c { c.TaskCard.priority = e.picked + 1 }
                    do boardChanged(boardOfCard(pick.Owner.ownerId))
                }
            }

            settled {
                var hide = false
                target $TaskBoardLooks as looks { hide = looks.TaskBoardLooks.hideDone }
                target $Owner #Tile as w { target $TaskCard on w.Owner.ownerId as c { if hide and c.TaskCard.done { mark w #Hidden } else { unmark w #Hidden } } }
                target $Owner #Line as w { target $TaskCard on w.Owner.ownerId as c { if hide and c.TaskCard.done { mark w #Hidden } else { unmark w #Hidden } } }
                target $Owner $Choice $Tint #Priority as chip { chip.Tint.a = intensity(chip.Choice.picked + 1) }
                target $Owner $Text #LaneCount as label { target $TaskLane on label.Owner.ownerId as l { label.Text.content = string(cardsIn(l)) } }
                target $Owner $Text #LaneStatus as label {
                    target $TaskLane on label.Owner.ownerId as l { label.Text.content = string(cardsIn(l) - doneIn(l)) + " of " + string(cardsIn(l)) + " left" }
                }
                target $Owner $Progress #LaneBar as bar {
                    target $TaskLane on bar.Owner.ownerId as l {
                        bar.Progress.value = float(doneIn(l))
                        bar.Progress.max = float(larger(1, cardsIn(l)))
                    }
                }
                target $Owner $Text #BoardProgress as label {
                    target $TaskBoard on label.Owner.ownerId as p {
                        var all = 0
                        var done = 0
                        target p.TaskBoard.~lanes as l {
                            all += cardsIn(l)
                            done += doneIn(l)
                        }
                        label.Text.content = string(done) + " of " + string(all) + " tasks done"
                    }
                }
            }

            SF addLane(board: Entity) {
                target $Owner $Field #LaneName as f {
                    if f.Owner.ownerId == board and not (trim(f.Field.value) == "") {
                        bring TaskLane("l" + nextNumber(), trim(f.Field.value), []) as lane
                        target $TaskBoard on board as p { p.TaskBoard.~lanes.add(lane) }
                        f.Field.value = ""
                        do boardChanged(board)
                    }
                }
            }

            // Out of its board — and an `owns` list ends what leaves it: the lane, its cards, their views.
            SF dropLane(lane: Entity) {
                let board = boardOfLane(lane)
                target $TaskBoard as p { if p.TaskBoard.~lanes has lane { p.TaskBoard.~lanes.remove(lane) } }
                do boardChanged(board)
            }

            // A lane has a box on the board and one in the list; the one holding words is the one meant.
            SF addCard(lane: Entity) {
                var priority = 1
                target $Owner $Choice #NewPriority as pick { if pick.Owner.ownerId == lane { priority = pick.Choice.picked + 1 } }
                target $Owner $Field #CardName as f {
                    if f.Owner.ownerId == lane and not (trim(f.Field.value) == "") {
                        bring TaskCard("c" + nextNumber(), trim(f.Field.value), false, priority) as card
                        target $TaskLane on lane as l { l.TaskLane.~cards.add(card) }
                        f.Field.value = ""
                        do boardChanged(boardOfLane(lane))
                    }
                }
            }

            // To the lane `step` places along. Adding to an `owns` list moves the card, and its view follows.
            SF moveCard(card: Entity, step: int) {
                let board = boardOfCard(card)
                target $TaskBoard on board as p {
                    var at = -1
                    target p.TaskBoard.~lanes as l { if l.TaskLane.~cards has card { at = Index } }
                    if at >= 0 {
                        target p.TaskBoard.~lanes as l { if Index == at + step { l.TaskLane.~cards.add(card) } }
                    }
                }
                do boardChanged(board)
            }

            SF deleteCard(card: Entity) {
                let board = boardOfCard(card)
                target $TaskLane as l { if l.TaskLane.~cards has card { l.TaskLane.~cards.remove(card) } }
                do boardChanged(board)
            }
        }

        shared("The priorities a card can have.")
        fn levels() return list<string> { return ["Low", "Medium", "High", "Very high"] }

        shared("How strong a priority's colour is: 0.18 for Low … 1.0 for Very high.")
        fn intensity(level: int) return float {
            if level >= 4 { return 1.0 }
            if level == 3 { return 0.7 }
            if level == 2 { return 0.42 }
            return 0.18
        }

        shared("How many cards a lane holds.")
        fn cardsIn(lane: Entity) return int {
            var n = 0
            target $TaskLane on lane as l { target l.TaskLane.~cards as c { n += 1 } }
            return n
        }

        shared("How many of a lane's cards are done.")
        fn doneIn(lane: Entity) return int {
            var n = 0
            target $TaskLane on lane as l { target l.TaskLane.~cards as c { if c.TaskCard.done { n += 1 } } }
            return n
        }

        shared("The board a lane is in, or 0.")
        fn boardOfLane(lane: Entity) return Entity {
            var found = 0
            target $TaskBoard as p { if p.TaskBoard.~lanes has lane { found = p } }
            return found
        }

        shared("The board a card is in, or 0.")
        fn boardOfCard(card: Entity) return Entity {
            var found = 0
            target $TaskLane as l { if l.TaskLane.~cards has card { found = boardOfLane(l) } }
            return found
        }

        shared("The larger of two numbers.")
        fn larger(a: int, b: int) return int {
            if a > b { return a }
            return b
        }

        // Ids are a letter and a number (`c12`, `l3`, `b2`): the number is what must not repeat.
        shared("A number no card, lane or board uses yet, for a new id: \"c\" + nextNumber().")
        fn nextNumber() return int {
            var top = 0
            target $TaskCard as c { top = larger(top, idNumber(c.TaskCard.id)) }
            target $TaskLane as l { top = larger(top, idNumber(l.TaskLane.id)) }
            target $TaskBoard as p { top = larger(top, idNumber(p.TaskBoard.id)) }
            return top + 1
        }

        shared("The number in an id after its first letter: idNumber(\"c12\") is 12; 0 when there is none.")
        fn idNumber(id: string) return int {
            let digits = substring(id, 1, len(id) - 1)
            if isNumber(digits) { return int(digits) }
            return 0
        }
    }
}
