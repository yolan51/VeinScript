// stdlib/Web.vein — VeinScript Standard Library : Vein.Web
// The web backend's domain: HTTP events + reusable html BUILDERS. Builders (markup/code/css) are where
// platform-specific rendering legitimately lives — the rest of the stdlib stays platform-independent,
// Vein.Web owns the html. Authored `by Vein`; public API `shared` in publicators (reachable as
// *Vein.Web.<Pub>.<name>).
//
// Vocabulary only — no shards. See samples/web_demo.vein for these builders assembled into a page
// end to end:  veinc render samples/web_demo.vein /

bundle Web by Vein {

    // Http — the request/response + fragment events used to assemble a page reactively.
    publicator Http {
        // A request is a path AND what was asked of it. `method` and `body` are what separate reading a
        // page from submitting one: without them a program can render, but it cannot receive. Both are
        // defaulted, so every existing `hear @Request as r { r.path }` keeps working untouched, and a
        // one-shot `veinc render` looks exactly like the GET it always was.
        //
        // Query-string values arrive as EXTRA payload fields rather than a parsed map — `?name=x` reads
        // as `r.name` — because the boot payload already overrides named fields (`--set name=x` does the
        // same thing). One mechanism, two drivers.
        shared("An inbound HTTP request: the path, what was asked of it, and any submitted body.")
        event @Request {
            path: string
            method: string = "GET"
            body: string = ""
        }

        shared("A fragment of HTML contributed by some shard.")
        event @Html { markup: string }

        shared("A fragment of CSS.")
        event @Style { css: string }

        shared("A fragment of JavaScript.")
        event @Script { code: string }

        shared("All fragments are in — assemble and send the page for this path.")
        event @Render { path: string }

        shared("The response to send back.")
        event @Response { status: int, body: string }
    }

    // Elements — reusable html builders. `bring Heading("…")` emits an @Html fragment.
    publicator Elements {
        shared("A top-level heading element.")
        builder Heading { text: string   markup = "<h1>" + text + "</h1>" }

        shared("A paragraph of text.")
        builder Paragraph { body: string   markup = "<p>" + body + "</p>" }

        shared("A clickable button element.")
        builder Button { label: string   markup = "<button>" + label + "</button>" }

        shared("An anchor / hyperlink.")
        builder Link { href: string, label: string   markup = "<a href=\"" + href + "\">" + label + "</a>" }

        shared("An image element.")
        builder Image { source: string, alt: string   markup = "<img src=\"" + source + "\" alt=\"" + alt + "\">" }

        shared("A second-level heading.")
        builder Subheading { text: string   markup = "<h2>" + text + "</h2>" }

        shared("A list item.")
        builder ListItem { text: string   markup = "<li>" + text + "</li>" }

        // A builder emits ONE fragment, so it cannot wrap other fragments — there is no way to express
        // "open a div, then some cards, then close it" as a single builder. `Raw` is the escape hatch
        // that makes the rest of the library able to stay small and unopinionated: anything this
        // vocabulary does not model, you write directly.
        shared("Markup this library does not model — passed through unchanged.")
        builder Raw { html: string   markup = html }

        // Self-contained on purpose, for the same reason: a form has to enclose its fields, and one
        // fragment cannot. This covers the common single-field case; anything richer is &Raw.
        shared("A single-field form that POSTs back to `action`.")
        builder Form { action: string, field: string, label: string   markup = "<form method=\"post\" action=\"" + action + "\"><input name=\"" + field + "\"> <button>" + label + "</button></form>" }

        // The only builder here with no parameters — a line break has nothing to say, only somewhere to
        // be. `markup` still carries a default, which is what keeps it a complete builder rather than one
        // missing its output. Repeat it with the count `bring` already takes: `bring 3 JumpLine()`.
        shared("A line break — `bring JumpLine()`, or `bring 3 JumpLine()` for several.")
        builder JumpLine { markup = "<br>" }
    }

    // Styles — the CSS channel. A builder's OUTPUT FIELD is what picks its channel, so `css = …` emits
    // @Style exactly as `markup = …` emits @Html. A stylesheet is therefore assembled the same way a
    // page is: shards contribute rules, the view collects them.
    publicator Styles {
        shared("One CSS rule — a selector and its declarations.")
        builder Rule { selector: string, decl: string   css = selector + "{" + decl + "}" }

        shared("A stylesheet fragment passed through unchanged (media queries, keyframes, …).")
        builder Css { text: string   css = text }
    }

    // Scripts — the JavaScript channel, `code = …` emitting @Script. Behaviour that runs in the BROWSER,
    // which is not the same thing as a shard: a shard reacts on the server, this ships to the client.
    publicator Scripts {
        shared("A named JavaScript function, callable from markup (onclick=\"name()\").")
        builder Define { name: string, body: string   code = "function " + name + "(){" + body + "}" }

        shared("JavaScript passed through unchanged — runs when the page loads.")
        builder Js { text: string   code = text }
    }

    // --- no behaviour here ---------------------------------------------------------------------------
    // A shard cannot be `shared`, so a router or page view declared here would not be API — it would be
    // invisible behaviour handed to everyone who only wanted a `&Button`. The routing + assembly demo
    // lives in samples/web_demo.vein, which reaches these builders by qualified path:
    //     veinc render samples/web_demo.vein /
}
