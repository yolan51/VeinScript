// stdlib/Input.vein — VeinScript Standard Library : Vein.Input
// Platform-independent input as EVENTS. Each backend (desktop, web, …) translates native input into
// these identities, so application code hears the SAME event regardless of platform:
//     native input → runtime → *Vein.Input.…@Event → hear → shard → shape changes → view
// Discover:  veinc symbols stdlib/Input.vein

bundle Input by Vein {

    // Pointer position is `*Vein.Math.Values.$Vec2`, not a hand-rolled x/y pair: a `$Shape` include is a
    // COMPILE-TIME field-group expansion, so reusing another bundle's shared shape needs no app link+run.
    // One vocabulary for "a 2D point" across the whole library.
    publicator Mouse {
        shared("A mouse/pointer button was pressed.")
        event @MouseDown { *Vein.Math.Values.$Vec2, button: int }

        shared("A mouse/pointer button was released.")
        event @MouseUp { *Vein.Math.Values.$Vec2, button: int }

        shared("The pointer moved.")
        event @MouseMove { *Vein.Math.Values.$Vec2 }

        // Where the pointer is IN THE WORLD — what click-to-move and aiming want. A 2D host's mouse events
        // are in world coordinates already; a 3D host's are screen pixels, so it raises this too: the point
        // where the ray under the pointer meets the ground plane (y = 0), on every move and press.
        shared("Where the pointer meets the ground (y = 0) in the world — raised by a 3D host as the mouse moves.")
        event @MouseWorld { *Vein.Math.Values.$Vec3 }
    }

    publicator Keyboard {
        // The key identity is declared once and reused by both edges, so a listener that handles either
        // sees the same field. `$Key` is `shared`, so other bundles may include it too.
        shared("The key a keyboard event concerns.")
        shape $Key { key: string }

        shared("A key was pressed.")
        event @KeyDown { $Key }

        shared("A key was released.")
        event @KeyUp { $Key }

        shared("Text was entered (already composed — not raw key codes).")
        event @TextInput { text: string }
    }

    // NAMED ACTIONS — "jump", "fire", "move_left" — rather than keys. Which keys, buttons or sticks trigger
    // an action is the HOST's setting (Godot's Input Map), so a player can rebind and a gamepad can jump
    // without the rules naming a single key. The rules hear what the player MEANT.
    //
    // `player` says WHOSE action: 0 for the person at this machine, 1.. for a second pad on the same screen
    // or a co-op partner across the network (Vein.Coop raises their actions on the host with their number).
    // A single-player game never reads it.
    publicator Actions {
        shared("A named action began. `strength` is 0..1 — 1 for a key or button, partial for a stick or trigger.")
        event @ActionPressed { action: string, strength: float = 1.0, player: int = 0 }

        shared("A named action ended.")
        event @ActionReleased { action: string, player: int = 0 }
    }

    // Raw gamepad input, for what actions do not cover (a stick's exact angle, which pad is which player).
    // `device` tells pads apart, from 0. Names are the common layout's, the same on every host:
    //   buttons  A B X Y Back Guide Start LeftStick RightStick LeftShoulder RightShoulder
    //            DpadUp DpadDown DpadLeft DpadRight
    //   axes     LeftX LeftY RightX RightY (-1..1, y down) TriggerLeft TriggerRight (0..1)
    publicator Gamepad {
        shared("A gamepad button was pressed.")
        event @ButtonDown { device: int, button: string }

        shared("A gamepad button was released.")
        event @ButtonUp { device: int, button: string }

        shared("A stick or trigger moved. Small movements around rest are dropped by the host; back at rest reads 0.")
        event @AxisMoved { device: int, axis: string, value: float }
    }
}
