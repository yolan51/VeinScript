// stdlib/Game.vein — VeinScript Standard Library : Vein.Game
// The game-specific capabilities, kept in their OWN bundle so non-game apps don't pull them in:
// collision, rigid bodies, and combat. The publicators expose the shared DATA/API (shapes + events);
// the bundle-level SHARDS are the behaviour you get for free by loading the bundle.
// Discover:  veinc symbols stdlib/Game.vein

bundle Game by Vein {

    // --- shared API (cross-bundle) --------------------------------------------------------------------
    publicator Collision {
        shared("A collision box (half-extents in world units).")
        shape $Collider { width: float, height: float }

        shared("Two identities overlapped this step.")
        event @Collided { a: Entity, b: Entity }
    }

    publicator Bodies {
        shared("A rigid body: mass and bounciness.")
        shape $Body { mass: float, restitution: float }
    }

    publicator Combat {
        shared("An identity took damage — carries the target and the amount.")
        event @Damaged { target: Entity, amount: int }
    }

    // --- behaviour (bundle-level shards) — comes with the bundle; not part of the shared API ----------
    // The schedule is outer, the entity `target` query is inner.
    shard CollisionDetection {
        each tick {
            target $Collider #Collidable as self {
                emit @Collided { a: self, b: self }
            }
        }
    }

    shard GravitySystem {
        each tick {
            target $Body as self { }
        }
    }

    shard DamageSystem {
        each tick {
            target $Body as self { }
        }
    }
}
