// stdlib/Graphics.vein — VeinScript Standard Library : Vein.Graphics
// What an identity LOOKS like, as data a host draws. `*Vein.UI.Widgets.$Image` is a flat picture; this
// bundle is for what a flat picture cannot say on its own: a 3D model, which animation is playing, a
// tint, a mirror, and whether it is shown at all.
//
// THE SPLIT, settled with the first engine host (Godot): the ENGINE owns how an animation looks — its
// keyframes, blending, bones, timing curves, all authored in the engine's own editor. The PROGRAM owns
// which animation plays and when: `attach $Animation { name: "run" }` on the identity, and the host plays
// the clip of that name on that identity's model. A program never sees a frame of it.
//
// A clip that reaches its end is `@AnimationEnded`, raised by the host like `@SoundEnded` — only the host
// owns the clock the clip ran on. A looping clip never ends; whether a clip loops is the engine's setting.
// Discover:  veinc symbols stdlib/Graphics.vein

bundle Graphics by Vein {

    publicator Models {
        // `source` is a path or asset name the host resolves, like `$Image.source` and `$PlaySound.source`
        // — a `.glb` or a `.tscn` to a Godot host. Placed, turned and sized by the identity's own
        // `*Vein.Transform.Spatial` shapes: `$World` (else `$Position`), `$Rotation` in radians, `$Scale`.
        shared("A 3D model to show at this identity's place. `source` is a path or asset name the host resolves.")
        shape $Model { source: string }
    }

    // How a picture is shown, beyond where: colour, mirroring, and whether at all. Each is a shape (or a
    // mark) on the identity, so a rule changes it like any other field — a fade is `t.Tint.a -= dt`.
    publicator Looks {
        // Multiplied into the picture: white (all 1.0) leaves it as drawn, `a` below 1 makes it see-through.
        shared("Colour this identity's picture: each channel 0..1 multiplies it; `a` is opacity.")
        shape $Tint { r: float = 1.0, g: float = 1.0, b: float = 1.0, a: float = 1.0 }

        shared("Mirror this identity's picture: `x` left-right, `y` upside down.")
        shape $Flip { x: bool = false, y: bool = false }

        // A mark rather than `$Tint { a: 0 }`: a hidden identity keeps its colour for when it comes back, and
        // `target … not #Hidden` finds what the player can see.
        shared("Wear this to be drawn nowhere. Unmark to show it again, as it was.")
        mark #Hidden
    }

    publicator Animations {
        // An identity carrying `$Animation` asks its host to play the clip called `name` on whatever the
        // identity shows (a `$Model`, or an animated `$Image`). Changing `name` switches clip; detaching
        // the shape stops it. `speed` scales playback — 2.0 is twice as fast, 0 holds the current frame.
        shared("Play the clip called `name` on this identity's model or sprite. `speed` scales playback.")
        shape $Animation { name: string, speed: float = 1.0 }

        // Only the host knows when a clip ends — it owns the clock the clip runs on. `Interp.FireAnimationEnded`
        // is that entry point, beside `FireSoundEnded`. Pure data, so the C# backend compiles it.
        shared("Fact: the clip `name` reached its end on `entity`. A looping clip never does.")
        event @AnimationEnded { entity: Entity, name: string }
    }
}
