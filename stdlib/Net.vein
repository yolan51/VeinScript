// stdlib/Net.vein — VeinScript Standard Library : Vein.Net
// The network as EVENTS, in two shapes that are deliberately NOT the same shape:
//
//   Peer — symmetric, identity-addressed, VeinScript on both ends. `@Send { to: #Server }` reaches a
//          program on another machine exactly as it reaches a console on this one. The transport is the
//          routing table's business, not the program's.
//   Http — asymmetric, URL-addressed, anything on the far end. A REST service has no mark and answers
//          once per question, so `@Fetch` is a REQUEST with a reply, not an addressed send.
//
// Discover:  veinc symbols stdlib/Net.vein

bundle Net by Vein {

    // Peer — VeinScript to VeinScript, across machines.
    //
    // The messaging vocabulary here (@Send / @Message / @Undelivered) is the SAME vocabulary
    // *Vein.Console.Io declares, because at runtime they are the same events. That is the point: a
    // program written against consoles goes cross-machine by adding @Listen and @Link and changing
    // nothing else. They are re-declared here so a headless server never has to import "Console" to
    // talk to the network.
    publicator Peer {
        // A key is REQUIRED, and the runtime refuses @Listen without one. A port anyone may write to
        // accepts any claimed identity, which would quietly turn `audience` — the language's networking
        // barrier (KEYWORDS.md) — into decoration. Every frame is signed with this secret and carries a
        // timestamp and a nonce, so a peer's name is proven and a captured frame cannot be replayed.
        //
        // Frames are also ENCRYPTED with this key (AES-256-GCM under an HKDF-derived key), so the wire
        // carries nothing readable but a length. What that is not is TLS: one static key means no
        // forward secrecy — a later leak decrypts traffic captured earlier — and no certificate
        // identity, so everyone holding the secret can impersonate anyone else.
        shared("Accept peers on a port, under a network identity. `as` is who this program IS on the network; `key` is the shared secret that signs every frame.")
        event @Listen { as: Mark, at: int, key: string }

        shared("Teach this program how to reach a peer — `at` is \"host\" or \"host:port\". Registers a route; nothing connects until you send.")
        event @Link { name: Mark, at: string, key: string }

        shared("Send a line to a peer or console by address — remote when linked, local otherwise.")
        event @Send { to: Mark, text: string }

        shared("A line that arrived — `from` is the sender's proven identity, safe to use in `audience`.")
        event @Message { from: Mark, text: string }

        shared("A line that could not be delivered — the peer is unreachable, unlinked, or refused it.")
        event @Undelivered { to: Mark, text: string }

        // Emit-only helpers — the same events, named as actions.
        shared("Accept peers on a port under a network identity.")
        SF listen(me: Mark, port: int, key: string) { emit @Listen { as: me, at: port, key: key } }

        shared("Register the route to a peer.")
        SF link(name: Mark, at: string, key: string) { emit @Link { name: name, at: at, key: key } }

        shared("Send a line to a peer by address.")
        SF send(dest: Mark, text: string) { emit @Send { to: dest, text: text } }
    }

    // Http — reaching a service that is not a VeinScript peer.
    publicator Http {
        // A reply of ANY status is @Fetched, including 404 and 500: the service answered, and what it
        // answered is the program's business. Only a request that never got a reply at all — bad host,
        // refused connection, timeout — becomes @Failed. That is the same line @Undelivered draws for
        // Peer: "no answer" and "an answer you dislike" are different events.
        // `headers` is ONE string, `Name: Value` per line — the HTTP wire format itself. It is not a map
        // because an event payload field has a scalar type and the language has no map literal; it is not
        // a list because a list is a VALUE with no type to declare. A newline-joined string is the shape
        // VeinScript can already build, and *Vein.Rest exists so you rarely write one by hand.
        //
        // Blank lines are skipped, a line with no colon is skipped, and a name or value containing a
        // control character is DROPPED — a CR smuggled in from data would otherwise append headers of its
        // own. Content-Type, if you set it, replaces the default application/json.
        shared("Request a URL. `method` defaults to GET; a non-empty `body` is sent as JSON; `headers` is one \"Name: Value\" per line.")
        event @Fetch { url: string, method: string, body: string, headers: string }

        shared("The service replied — `status` is its HTTP status, whatever it was.")
        event @Fetched { url: string, status: int, body: string }

        shared("The request never got a reply — bad host, refused connection, or timeout.")
        event @Failed { url: string, reason: string }

        shared("GET a URL.")
        SF get(url: string) { emit @Fetch { url: url, method: "GET", body: "", headers: "" } }

        shared("POST a body to a URL.")
        SF post(url: string, body: string) { emit @Fetch { url: url, method: "POST", body: body, headers: "" } }

        // The authenticated forms. Kept as separate names rather than extra parameters on `get`/`post`
        // because VeinScript has no default arguments — a fifth positional "" at every unauthenticated
        // call site would be worse than two more names.
        shared("GET a URL with headers — see *Vein.Rest for building them.")
        SF getWith(url: string, headers: string) { emit @Fetch { url: url, method: "GET", body: "", headers: headers } }

        shared("POST a body to a URL with headers.")
        SF postWith(url: string, body: string, headers: string) { emit @Fetch { url: url, method: "POST", body: body, headers: headers } }

        shared("Any method, body and headers — the general form the others are shorthand for.")
        SF request(url: string, method: string, body: string, headers: string) { emit @Fetch { url: url, method: method, body: body, headers: headers } }
    }

    // --- no behaviour here ---------------------------------------------------------------------------
    // A shard cannot be `shared`, so any routing or retry policy declared here would be invisible
    // behaviour handed to everyone who only wanted the vocabulary — the same line stdlib/Web.vein holds.
    // See samples/net_peer.vein and samples/net_fetch.vein for these assembled end to end.
}
