// stdlib/Diagnostics.vein — VeinScript Standard Library : Vein.Diagnostics
// Standard diagnostic concepts the compiler, tools, and eventual VeinIDE can share: a $Diagnostic shape
// (severity + message + source location), a @DiagnosticRaised event, and a Collector shard.
// Platform-independent.  Discover:  veinc symbols stdlib/Diagnostics.vein

bundle Diagnostics by Vein {

    publicator Report {
        // `severity`: 0 = info, 1 = warning, 2 = error. (An int — cross-bundle enums await link+run.)
        shared("A diagnostic at a source location: severity (0 info / 1 warning / 2 error) + message.")
        shape $Diagnostic {
            severity: int
            message: string
            line: int
            column: int
        }

        shared("A diagnostic was produced by some tool/shard.")
        event @DiagnosticRaised { severity: int, message: string }

        // Emit-only helpers. An `SF` names the intent so callers don't hand-roll the severity codes.
        shared("Raise an informational diagnostic (severity 0).")
        SF info(message: string) { emit @DiagnosticRaised { severity: 0, message: message } }

        shared("Raise a warning diagnostic (severity 1).")
        SF warn(message: string) { emit @DiagnosticRaised { severity: 1, message: message } }

        shared("Raise an error diagnostic (severity 2).")
        SF error(message: string) { emit @DiagnosticRaised { severity: 2, message: message } }
    }

    // No behaviour here — collecting raised diagnostics is the tool's or IDE's job, not the library's.
    // It hears @DiagnosticRaised and does whatever it needs with $Diagnostic.
}
