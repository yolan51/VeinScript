// stdlib/UI.vein — VeinScript Standard Library : Vein.UI
// Visual state as SHAPES + interaction as EVENTS — platform-independent. A backend RENDERER turns these
// identities into pixels/DOM; no HTML/CSS/JS lives here (that's Vein.Web's builders). Layout rectangles
// reuse Vein.Math.$Rect rather than a redundant $Bounds; visibility/enabled are marks by convention
// (#Visible / #Enabled), not duplicated as shapes.
// Discover:  veinc symbols stdlib/UI.vein

bundle UI by Vein {

    publicator Widgets {
        shared("A run of display text.")
        shape $Text { content: string }

        // `label` is what the user reads; the other three are NAMES a renderer resolves, not markup —
        // an identifier, a style class, and the handler to invoke. That keeps the no-HTML rule above
        // intact (a DOM renderer maps them to attributes; a native one to whatever it uses) while
        // matching what a button actually needs. It was `{ label: string }` alone, which no button in
        // this repo could use, so every sample declared a richer `$Button` of its own — and components
        // unify by name, so those were one component with two meanings waiting to happen (VS0220).
        // `label` FIRST, and that ordering is load-bearing: builder params bind positionally, so putting
        // `id` first would silently turn every existing `Button("Save")` into a button with the id
        // "Save" and no label. The essential field leads; the decoration follows.
        shared("A button: its label, plus the identifier, style class and handler a renderer resolves.")
        // Only the label is REQUIRED, and the defaults say so out loud. In HTML an id, a class and a
        // handler are all optional — `<button>Go</button>` is a complete button — so `bring Button("Go")`
        // has to stay a one-argument call. Without the defaults it is three silently empty parameters,
        // which VS0228 now reports, correctly: a missing argument and an argument deliberately left out
        // look identical at the call site, and a default is how a declaration tells them apart.
        shape $Button { label: string, id: string = "", class: string = "", onclick: string = "" }

        shared("A text input field with current value and placeholder.")
        shape $Field { value: string, placeholder: string }

        shared("An image element, by source path/url.")
        shape $Image { source: string }

        // HOW BIG THE TEXT IS, and it lives here because every renderer needs it and `$Text` does not
        // carry it. Left to each consumer, this is a name collision waiting: components unify by bare
        // name, so one bundle's `$Font { size }` beside another's `$Font { size, face }` is VS0332 the
        // moment an app links both — and neither author did anything wrong. One declaration removes the
        // question.
        //
        // JUST THE SIZE. A `face` would be a name this host ignores, and a field every renderer ignores
        // is worse than one that is not there: it reads as a promise. A typeface is also a licensed
        // asset rather than a value, so naming one in a program is the wrong shape for the problem.
        // In pixels on the screen; world text scales with the zoom from there.
        shared("How big a widget's text is, in pixels on the screen.")
        shape $Font { size: float }
    }

    // WHAT THE PROGRAM IS BEING DRAWN ON. Maintained by the host, read by the program.
    publicator Surface {
        // A SHAPE, NOT AN EVENT, and the difference is the whole point. `$Rect` is absolute pixels from
        // the top-left, so a score in the top-left needs no arithmetic and a timer in the top-RIGHT
        // cannot be written at all without knowing the width — the best a program could do was guess a
        // number that is correct at one window size.
        //
        // An `@Resized` event would announce a change; it would not answer the question. A game that
        // never resizes would hear nothing and still not know how wide it is, and a shard that wants
        // the width has to have been listening earlier and stored it. An identity carrying `$View` can
        // be targeted from any shard at any time, which is what "how big is the view" actually needs.
        // The host keeps it current exactly as it already reads a camera.
        //
        // Float, matching `Vein.Math.$Rect`, so laying a widget out against the view edge is arithmetic
        // rather than a cast.
        shared("The surface being drawn on, in pixels. The host keeps this current; a program reads it.")
        shape $View { width: float, height: float }
    }

    // Interaction occurrences carry the target Entity, so any bundle can react to a specific widget.
    publicator Interaction {
        shared("An interactive element was activated.")
        event @Clicked { target: Entity }

        shared("An element gained focus.")
        event @Focused { target: Entity }

        shared("An element lost focus.")
        event @Blurred { target: Entity }

        shared("The pointer entered an element.")
        event @Hovered { target: Entity }
    }
}
