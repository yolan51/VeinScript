// stdlib/Rest.vein — VeinScript Standard Library : Vein.Rest
// The vocabulary for talking to an HTTP service that wants an API key: building the `headers` string
// *Vein.Net.Http.@Fetch carries, and reading the status it answers with.
// Discover:  veinc symbols stdlib/Rest.vein
//
// WHY THIS EXISTS AT ALL. `@Fetch` gained a `headers` field, and that field is one string with
// `Name: Value` per line — the HTTP wire format itself, because an event payload field has a scalar type
// and the language has no map literal. Writing that by hand is a concatenation with a `\n` in the middle
// that is wrong in a way nothing reports: a missing newline merges two headers into one, and the service
// answers 401 with no hint which header it never saw. These functions put the newline in.
//
// WHY IT IS NOT NAMED FOR A SERVICE. Supabase, PostgREST, GitHub and Stripe all authenticate the same
// two ways — a bearer token, or a named key header — and none of that is theirs. A `Vein.Supabase` bundle
// would put one company's product in the standard library and inherit their release schedule. The
// service-specific half (which path, which query parameters, which `Prefer` header) lives in the program,
// where it can change without a stdlib release; see samples/db_supabase.vein for that half assembled.
//
// WHAT IS DELIBERATELY MISSING, and each is a real limit rather than an oversight:
//
//   URL BUILDING. There is no `query(url, key, value)`, because it could not percent-encode CORRECTLY.
//     A program can look at characters — `s[0]` yields one and `code`/`chr` convert (RULES 28) — so the
//     ASCII half is writable. The blocker is that percent-encoding is defined over BYTES and `code(c)`
//     gives a UTF-16 code unit: `é` must become `%C3%A9` and the obvious implementation emits `%E9`,
//     which is a different character. A function that is correct only for input you already know is
//     ASCII is a trap with a helpful name. Concatenate the query string yourself, from literals.
//   BASIC AUTH. `Authorization: Basic …` needs base64, which is the same byte problem. If you need it,
//     the encoding has to come from the host, not from here.
//   RETRIES AND TIMEOUTS. A shard cannot be `shared` (STDLIB.md), so any policy declared here would be
//     invisible behaviour handed to everyone who only wanted the vocabulary. Retry in your own shard, on
//     @Failed, where you can see it.

bundle Rest by Vein {

    // Headers — assembling the string, one line at a time.
    //
    // The two-function split is what makes composition safe: `one` starts a header string and `also`
    // extends one, so the newline belongs to `also` and never has to be written at a call site. Chaining
    // reads in the order the headers go out:
    //
    //     let h = also(also(one("apikey", key), "Authorization", "Bearer " + key),
    //                  "Prefer", "return=representation")
    publicator Headers {
        shared("One header line — the start of a header string.")
        fn one(name: string, value: string) -> string { return name + ": " + value }

        shared("Add a header to an existing string. Safe on an empty one — no leading blank line matters, the transport skips them.")
        fn also(headers: string, name: string, value: string) -> string {
            return headers + "\n" + name + ": " + value
        }

        // Not a synonym for `one("Content-Type", …)`: the point is that the SPELLING is the thing people
        // get wrong ("application/json" vs "text/json" vs a charset suffix), and a name can hold the
        // right one. Note the transport already defaults a body to application/json, so this is for
        // saying so explicitly, or for the `accept` direction where there is no default.
        shared("Content-Type: application/json — the transport's default, stated out loud.")
        fn json() -> string { return "Content-Type: application/json" }

        shared("Accept a media type in the reply, e.g. accept(\"application/json\").")
        fn accept(mime: string) -> string { return "Accept: " + mime }
    }

    // Auth — the two schemes that cover most keyed APIs.
    publicator Auth {
        shared("Authorization: Bearer <token> — OAuth2, JWTs, and most modern APIs.")
        fn bearer(token: string) -> string { return "Authorization: Bearer " + token }

        shared("A key in a header of the service's own choosing, e.g. apiKey(\"apikey\", key) or apiKey(\"X-API-Key\", key).")
        fn apiKey(name: string, key: string) -> string { return name + ": " + key }

        // PostgREST-family services (Supabase included, but the pattern is theirs, not ours — see the
        // file header) want the SAME key sent two ways: a named header routes the request to the right
        // project, `Authorization` is the identity row-level security evaluates. Sending only one is the
        // classic first failure — a 401 whose body names neither header (samples/db_supabase.vein hit
        // this before writing it down). One function for the pair, so the mistake would have to be
        // deleting a line rather than forgetting to add one.
        // Fully qualified even though `also`/`apiKey` live in this same file: a leaf reference is
        // resolved and inlined into the CALLER's module at compile time (STDLIB.md §1), body and all —
        // so a bare name inside that body is looked up in the caller's own locals, not this bundle's.
        // Only a `*Vein.Rest…` reference re-triggers the same import, recursively, for the callee too.
        shared("Both headers a PostgREST-style API wants for one key: apiKey(name, key) plus bearer(key).")
        fn keyed(name: string, key: string) -> string {
            return *Vein.Rest.Headers.also(*Vein.Rest.Auth.apiKey(name, key), "Authorization", "Bearer " + key)
        }
    }

    // Status — reading the reply.
    //
    // Worth naming rather than writing inline, because @Fetched fires for EVERY status (a 404 is an
    // answer, not a failure — see stdlib/Net.vein), so a handler that forgets to check treats an error
    // page as data. `ok(f.status)` is the guard that belongs at the top of every `hear @Fetched`.
    publicator Status {
        shared("True for 2xx — the request succeeded. Check this before parsing a body.")
        fn ok(status: int) -> bool { return status >= 200 and status < 300 }

        shared("True for 4xx — this program got something wrong: a bad key, a bad path, a bad body.")
        fn clientError(status: int) -> bool { return status >= 400 and status < 500 }

        shared("True for 5xx — the service got something wrong. This is the one worth retrying.")
        fn serverError(status: int) -> bool { return status >= 500 and status < 600 }
    }

    // Db — a keyed REST endpoint you talk to more than once: a PostgREST-style API (Supabase, or any
    // hand-rolled service that authenticates the same way — see the file header for why nothing here
    // names a vendor).
    //
    // TWO WAYS TO DECLARE ONE, because they answer different questions.
    //
    //   bring *Vein.Rest.Db.&Connection(base, key)     — an IDENTITY. It persists, so any shard in any
    //     later phase reaches it with `target $Connection #Connection as c` and reads `c.Connection.base`.
    //     This is docs/RULES.md rule 7, and it is the one to reach for: the credentials become a thing
    //     the program HAS rather than a value that was passed around once.
    //
    //   bring *Vein.Rest.Db.&Connect(base, key)        — an EVENT. It fans out to every
    //     `hear *Vein.Rest.Db.@Connect` and is then gone. Right when the point is to REACT to the
    //     connection being declared — kick off queries at boot — and wrong when a later phase needs to
    //     look the credentials up, because there is nothing left to look at.
    //
    // A program can use both: `Connection` to hold them, `Connect` to announce them.
    //
    // THIS USED TO BE A REAL LIMIT AND IS NOT ANY MORE. A `$Shape` reaching a consumer only through a
    // builder's include was never registered as a component TYPE in that module, and a field access
    // resolves to a component only when the module declares one of that name (Interp.IsComponent). So
    // the attach worked, `target` matched the entity, and `c.Connection.base` came back as the empty
    // string with no diagnostic anywhere. Lower now records a non-local shape that something attaches
    // and adds its type to the module — see `RegisterImportedShape`.
    //
    // `$Connection` also earns its keep as an INCLUDE: `base`/`key` are declared once and reused rather
    // than retyped, the same reason `Vein.Input`'s pointer events reuse `Vein.Math`'s `$Vec2`
    // (STDLIB.md §1). It is NOT a parameter type: `fn`/`SF` parameters take `name: type`, and a `$Shape`
    // is not a `type` there (`SF f($Shape)` is VS0100). `$Include` works inside an `event`/`builder`
    // signature, which is what both builders below are.
    publicator Db {
        shared("The base URL and key any keyed REST connection needs — $Include this into your own shape, event, or builder rather than retyping base/key.")
        shape $Connection { base: string, key: string }

        shared("Marks an endpoint this program talks to.")
        mark #Connection

        shared("Hold a connection as an identity: bring Connection(\"https://xyz.supabase.co\", \"anon-key\"), then reach it from any later shard with target $Connection #Connection as c.")
        builder Connection { $Connection   mark #Connection }

        shared("Announce a connection: bring Connect(\"https://xyz.supabase.co\", \"anon-key\") — hear *Vein.Rest.Db.@Connect in your own shard(s) to react, or skip bring and call get/post directly with the same two values.")
        builder Connect { $Connection }

        // THE PARAMETER IS `root`, NOT `base`, and the shape's field above still is `base`. Both are
        // right: `base` is a keyword only in EXPRESSION position (`bring X(base)` = "the declared
        // default"), and it stays legal as a field or member name — `$Connection { base: … }` and
        // `c.Connection.base` are unaffected. A `SF` parameter is different because its BODY reads the
        // name bare: `url: base + path` would parse `base` as the keyword. So the public surface keeps
        // the good name and only the local binding moves.
        shared("GET base+path, with the paired apikey/bearer headers built from key.")
        SF get(root: string, key: string, path: string) {
            emit *Vein.Net.Http.@Fetch { url: root + path, method: "GET", body: "", headers: *Vein.Rest.Auth.keyed("apikey", key) }
        }

        // `Prefer: return=representation` makes an insert answer with the row(s) it wrote, including
        // whatever the service generated (an id, a default, a computed column). Without it PostgREST
        // answers 201 with an empty body, and a caller reading the reply for the new id finds nothing.
        shared("POST a JSON body to base+path — paired auth headers, plus Prefer: return=representation.")
        SF post(root: string, key: string, path: string, body: string) {
            emit *Vein.Net.Http.@Fetch {
                url: root + path, method: "POST", body: body,
                headers: *Vein.Rest.Headers.also(*Vein.Rest.Auth.keyed("apikey", key), "Prefer", "return=representation")
            }
        }
    }

    // --- still no shard --------------------------------------------------------------------------------
    // `Db.get`/`Db.post` are leaf SFs: they assemble a header string and `emit *Vein.Net.Http.@Fetch`,
    // the event Vein.Net already owns and NetHttp.Hook already answers — re-declaring @Fetch here instead
    // would give a program two names for one runtime event, the divergence VS0332 exists to catch.
    // `Connect` is an ordinary no-channel builder (docs/LANGUAGE.md §3.9): `bring` emits `@Connect` and
    // nothing runs on its own, so this is still vocabulary, not behaviour — a retry/timeout policy still
    // has nowhere to hide here, for the same reason as always: a shard cannot be `shared`, so one
    // declared here would be invisible to everyone who only wanted the vocabulary. Retry in your own
    // shard, on `@Failed`.
    //
    // Everything else here — Headers, Auth, Status — is leaf functions: a qualified call imports the
    // declaration at compile time, so `*Vein.Rest.Auth.bearer(…)` runs in the caller's module with no
    // link step.
}
