// samples/desktop/todo.vein — a to-do list in GROUPS, one shown at a time: name a group, pick its tab,
// add tasks to it, tick, remove.
//
//   In the Workbench, press ▶ (F5): its window opens, drawn from its identities.
//   veinc run samples/desktop/todo.vein --ticks 2      (its rules alone, with no window drawn)
//
// THE WINDOW, AS IDENTITIES. Every box below is one identity; every line is a $Parent link.
//
//   window ─┬─ row ── picture (vslogo.png)  heading "To-do"
//           ├─ row ── [new group name] [Add group]
//           ├─ row #Tabs ── [Shopping] [Work]   (one #Tab per group; the open one wears #Accent)
//           ├─ column #Groups ── column #Group ─┬─ row #Head ── heading "Shopping"  label #Status  [Remove group]
//           │                   (one per group)  ├─ row #Entry ── [add a task…] [Add]
//           │                                    └─ column #Tasks ── row ── [x] task  [Remove]
//           └─ label #Empty
//
// FIVE IDEAS CARRY THE WHOLE APP:
//
// 1. THE $Parent LINKS ARE THE DATA. Nothing keeps a list of groups or tasks. A group's tasks are the rows
//    whose parent is its #Tasks column; "which group is this Add button in?" is two steps up its parents.
//
// 2. TWO WAYS IN, ONE HANDLER. Enter in a box (@Submitted) and its button (@Clicked) both emit the same
//    event, so "add a group" and "add a task" are each written once.
//
// 3. REMOVING IS ONE LINE. `do discard(group)` takes the group with its header, its box and every task in
//    it, at any depth — the stdlib walks the $Parent links down.
//
// 4. WHAT IS SHOWN IS DERIVED, IN `settled`. Each group's "1 of 3 left" is counted after every commit, so
//    no handler has to remember to update it. Counting in @AddTask would miss the new row, which is
//    visible only from the next event (RULES 12b).
//
// 5. ONE GROUP AT A TIME IS A MARK. Every group but the open one wears *Vein.Graphics.Looks.#Hidden, which the
//    host draws nowhere — the group and everything in it. @Show { group } moves the mark; a tab knows its
//    group through $Opens, so nothing compares labels.
//
// 6. IT REMEMBERS, IN todo.json BESIDE THE PROGRAM. At start it reads the file and brings every group and
//    task back through the same @AddGroup and @AddTask a click uses. After every change `settled` writes
//    the list out again — only when the text changed. Built with `veinc build`, the file sits beside the
//    .exe, on whichever PC it was copied to:
//
//        {"groups":[{"group":{"name":"Shopping"},"tasks":[{"label":"Buy milk","checked":true}]}]}

bundle Todo by you {
    need "Vein.Desktop"
    need "Vein.UI"
    need "Vein.Core"
    need "Vein.Graphics"

    event @AddGroup { name: string }
    event @AddTask { group: Entity, text: string, done: bool = false, priority: int = 1 }
    event @Show { group: Entity }
    event @ShowSome { }
    event @ShowFirst { }
    event @RestoreTasks { }
    event @Loaded { }

    shape $Opens { group: Entity }   // a tab's group
    shape $Named { name: string }    // a group's name, as saved

    mark #Saved         // the tag of todo.json's reads and writes (RULES 28c)
    mark #NewGroup      // the box that names a new group
    mark #AddGroup      // …and its button
    mark #Tabs          // the row of tabs, one per group
    mark #Tab           // one tab
    mark #Groups        // the column every group lives in
    mark #Group         // one group
    mark #Head          // a group's header row
    mark #Status        // a group's "1 of 3 left"
    mark #DropGroup     // a group's Remove group button
    mark #Entry         // a group's row with its box and Add button
    mark #NewTask       // a group's box
    mark #Add           // a group's Add button
    mark #Tasks         // a group's column of tasks
    mark #Delete        // a task's Remove button
    mark #Priority      // a task's priority dropdown — its $Choice.picked IS the priority (0 low … 3 very high)
    mark #NewPriority   // a group's dropdown beside its box: the priority a new task gets
    mark #Empty         // the hint shown while there is no group

    shard Build {
        run once {
            bring Window("To-do", 480.0, 600.0, "vslogo.png") as w
            bring Row(w, 10.0) as title
            bring Picture(title, "vslogo.png", 40.0)
            bring Heading(title, "To-do", 24.0)
            bring Row(w, 8.0) as top
            bring Input(top, "", "New group, e.g. Shopping") as name
            mark name #NewGroup
            bring Button(top, "Add group") as addGroup
            mark addGroup #AddGroup
            bring Row(w, 6.0) as tabs
            mark tabs #Tabs
            bring Column(w, 16.0) as groups
            mark groups #Groups
            bring Label(w, "") as empty
            mark empty #Empty
        }
    }

    // ---- what the user does ------------------------------------------------------------------------

    shard Actions {
        hear *Vein.UI.Interaction.@Clicked as c {
            target $Button #AddGroup on c.target as b {
                target $Field #NewGroup as f { emit @AddGroup { name: f.Field.value } }
            }

            // Add sits in its group's #Entry row, beside that group's box and priority dropdown: read both,
            // name the group.
            target $Parent #Add on c.target as b {
                target $Parent #Entry on b.Parent.of as entry {
                    target $Parent #NewTask as box {
                        if box.Parent.of == entry {
                            target $Field on box as f {
                                emit @AddTask { group: entry.Parent.of, text: f.Field.value, priority: newPriority(entry) }
                            }
                        }
                    }
                }
            }

            // A tab opens its group.
            target $Opens #Tab on c.target as t { emit @Show { group: t.Opens.group } }

            // A task's Remove sits in the task's row: removing the row takes its checkbox with it.
            target $Parent #Delete on c.target as d { do discard(d.Parent.of) }

            // Remove group sits in the group's header row: the group is the header's parent.
            // Its tab goes with it; if it was the open one, another opens (next event, once it is gone).
            target $Parent #DropGroup on c.target as d {
                target $Parent #Head on d.Parent.of as head {
                    target $Opens #Tab as t {
                        if t.Opens.group == head.Parent.of { do discard(t) }
                    }
                    do discard(head.Parent.of)
                    emit @ShowSome { }
                }
            }
        }

        hear @Submitted as s {
            target $Field #NewGroup on s.target as f { emit @AddGroup { name: s.value } }
            target $Parent #NewTask on s.target as box {
                target $Parent #Entry on box.Parent.of as entry {
                    emit @AddTask { group: entry.Parent.of, text: s.value, priority: newPriority(entry) }
                }
            }
        }
    }

    // ---- what it changes ---------------------------------------------------------------------------

    shard Groups {
        hear @AddGroup as g {
            // A name already taken opens that group instead: two "Shopping"s could not be told apart, by
            // the user or by todo.json.
            var taken = false
            target $Named #Group as other {
                if other.Named.name == g.name {
                    taken = true
                    emit @Show { group: other }
                }
            }
            if not (g.name == "") and not taken {
                target $Panel #Groups as groups {
                    bring Column(groups, 6.0) as group
                    mark group #Group
                    attach $Named to group { name: g.name }
                    bring Row(group, 12.0) as head
                    mark head #Head
                    bring Heading(head, g.name, 18.0)
                    bring Label(head, "") as status
                    mark status #Status
                    bring Button(head, "Remove group") as dropGroup
                    mark dropGroup #DropGroup
                    bring Row(group, 8.0) as entry
                    mark entry #Entry
                    bring Input(entry, "", "Add a task to " + g.name) as box
                    mark box #NewTask
                    bring Dropdown(entry, levels(), 0) as pick
                    mark pick #NewPriority
                    bring Button(entry, "Add") as add
                    mark add #Add
                    bring Column(group, 4.0) as tasks
                    mark tasks #Tasks
                    target $Panel #Tabs as tabs {
                        bring Button(tabs, g.name) as tab
                        mark tab #Tab
                        attach $Opens to tab { group: group }
                    }
                    // A new group opens at once: the user named it to fill it.
                    emit @Show { group: group }
                }
                target $Field #NewGroup as f { f.Field.value = "" }
            }
        }

        // Exactly one group shown: the one asked for. Its tab is the accented one.
        hear @Show as s {
            target $Panel #Group as g {
                if g == s.group { unmark g #Hidden } else { mark g #Hidden }
            }
            target $Opens #Tab as t {
                if t.Opens.group == s.group { mark t #Accent } else { unmark t #Accent }
            }
        }

        // After a removal: if nothing is shown, show the first group left.
        hear @ShowSome as x {
            var shown = 0
            target $Panel #Group not #Hidden as g { shown += 1 }
            if shown == 0 { emit @ShowFirst { } }
        }

        hear @ShowFirst as x {
            var first = 0
            target $Panel #Group as g {
                first += 1
                if first == 1 { emit @Show { group: g } }
            }
        }

        hear @AddTask as a {
            if not (a.text == "") {
                target $Parent #Tasks as tasks {
                    if tasks.Parent.of == a.group {
                        bring Row(tasks, 8.0) as row
                        bring Dropdown(row, levels(), a.priority - 1) as chip
                        mark chip #Priority
                        attach $Tint to chip { }
                        bring Check(row, a.text, a.done)
                        bring Button(row, "Remove") as del
                        mark del #Delete
                    }
                }
                // Empty THIS group's box, and only this one.
                target $Parent #Entry as entry {
                    if entry.Parent.of == a.group {
                        target $Parent #NewTask as box {
                            if box.Parent.of == entry { target $Field on box as f { f.Field.value = "" } }
                        }
                    }
                }
            }
        }
    }

    // ---- what is shown, derived --------------------------------------------------------------------

    shard Status {
        settled {
            var groups = 0
            target $Panel #Group as group {
                groups += 1

                // Count this group's checkboxes: checkbox → row → this group's #Tasks column.
                var all = 0
                var left = 0
                target $Parent #Tasks as tasks {
                    if tasks.Parent.of == group {
                        target $Parent as row {
                            if row.Parent.of == tasks {
                                target $Parent as cell {
                                    if cell.Parent.of == row {
                                        target $Toggle on cell as t {
                                            all += 1
                                            if not t.Toggle.checked { left += 1 }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Write it into this group's #Status label: label → #Head row → this group.
                target $Parent #Status as status {
                    target $Parent #Head on status.Parent.of as head {
                        if head.Parent.of == group {
                            target $Text on status as s {
                                if all == 0 {
                                    s.Text.content = "empty"
                                } else {
                                    s.Text.content = string(left) + " of " + string(all) + " left"
                                }
                            }
                        }
                    }
                }
            }

            target $Text #Empty as e {
                if groups == 0 { e.Text.content = "No group yet. Name one above, then press Enter." } else { e.Text.content = "" }
            }
        }
    }

    // ---- priority: one colour, four intensities ------------------------------------------------------

    // The four, in order: a dropdown's `picked` is the index, so the level is picked + 1.
    fn levels() return list<string> { return ["Low", "Medium", "High", "Very high"] }

    // The priority a new task gets in this group: the dropdown beside the group's box (`entry`).
    fn newPriority(entry: Entity) return int {
        var level = 1
        target $Parent #NewPriority as np {
            if np.Parent.of == entry { target $Choice on np as c { level = c.Choice.picked + 1 } }
        }
        return level
    }

    // How strong the red is: a faint wash for low, solid for very high. `$Tint.a` is the intensity.
    fn intensity(level: int) return float {
        if level >= 4 { return 1.0 }
        if level == 3 { return 0.7 }
        if level == 2 { return 0.42 }
        return 0.18
    }

    // A saved level, or Low: a todo.json from before priorities has none, and reads as "".
    fn levelOf(saved: string) return int {
        if isNumber(saved) {
            let n = int(saved)
            if n >= 1 and n <= 4 { return n }
        }
        return 1
    }

    // Derived, like the counts: every task's priority dropdown wears its level's intensity. Pick another level
    // and the colour follows next frame — nothing else has to remember to repaint.
    shard Looks {
        settled {
            target $Choice #Priority as p {
                let level = p.Choice.picked + 1
                target $Tint on p as t {
                    t.Tint.r = 0.92
                    t.Tint.g = 0.26
                    t.Tint.b = 0.21
                    t.Tint.a = intensity(level)
                }
            }
        }
    }

    // ---- what it remembers: todo.json, beside the program -----------------------------------------
    //
    // THE SHAPES ARE THE RECORDS. `toJson(t.Toggle)` writes a checkbox as {"label":…,"checked":…} and
    // `toJson(g.Named)` a group's name — escaped by the language, in declaration order (RULES 24b) — and
    // `fromJson` reads the file back into records whose fields have the same names.

    shard Storage {
        var loaded = false   // nothing is written until what was saved has come back
        var saved = ""       // the text last read or written: an unchanged list is not written again

        run once {
            emit *Vein.Files.Io.@ReadFile { path: "todo.json", tag: #Saved }
        }

        // The groups first, through the same @AddGroup a click uses. Their tasks need the groups to exist,
        // which they do from the NEXT event (RULES 12b) — so @RestoreTasks is queued after them.
        hear *Vein.Files.Io.@FileLoaded as f {
            if f.tag == #Saved {
                saved = f.text
                target fromJson(f.text).groups as grp { emit @AddGroup { name: grp.group.name } }
                emit @RestoreTasks { }
            }
        }

        // The first run, or the file was deleted: start empty, and save from now on.
        hear *Vein.Files.Io.@FileMissing as f {
            if f.tag == #Saved { emit @Loaded { } }
        }

        hear @RestoreTasks as r {
            target fromJson(saved).groups as grp {
                target $Named #Group as g {
                    if g.Named.name == grp.group.name {
                        target grp.tasks as task {
                            emit @AddTask { group: g, text: task.label, done: task.checked, priority: levelOf(string(task.priority)) }
                        }
                    }
                }
            }
            emit @ShowFirst { }
            emit @Loaded { }
        }

        hear @Loaded as l { loaded = true }

        // The whole list as JSON, every frame — and written only when it differs from what is on disk.
        settled {
            if loaded {
                var groups = ""
                target $Named #Group as g {
                    var tasks = ""
                    target $Parent #Tasks as list {
                        if list.Parent.of == g {
                            target $Parent as row {
                                if row.Parent.of == list {
                                    target $Parent as cell {
                                        if cell.Parent.of == row {
                                            target $Toggle on cell as t {
                                                // The checkbox's record, with its row's priority added.
                                                var level = 1
                                                target $Parent #Priority as pc {
                                                    if pc.Parent.of == row { target $Choice on pc as p { level = p.Choice.picked + 1 } }
                                                }
                                                let record = toJson(t.Toggle)
                                                if not (tasks == "") { tasks = tasks + "," }
                                                tasks = tasks + substring(record, 0, len(record) - 1) +
                                                        ",\"priority\":" + string(level) + "}"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if not (groups == "") { groups = groups + ",\n " }
                    groups = groups + "{\"group\":" + toJson(g.Named) + ",\"tasks\":[" + tasks + "]}"
                }
                let text = "{\"groups\":[\n " + groups + "\n]}\n"
                if not (text == saved) {
                    saved = text
                    emit *Vein.Files.Io.@WriteFile { path: "todo.json", text: text, tag: #Saved }
                }
            }
        }
    }
}
