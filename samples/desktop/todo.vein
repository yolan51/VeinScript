// samples/desktop/todo.vein — a to-do list in groups: tabs, priorities, progress, saved beside the program.
//
//   In the Workbench, press ▶ (F5): its window opens, drawn from its identities.
//   veinc run samples/desktop/todo.vein --ticks 2      (its rules alone, with no window drawn)
//
// DATA FIRST, THEN THE SCREEN. A group is an identity carrying $Group { name }; a task is one carrying
// $Task { group, text, done, priority }. Everything else follows from those two shapes:
//
// 1. ONE LOOM EACH WAY: weave IN, toText OUT. groups.json and tasks.json beside the program are written by
//    `toText<Json>(SavedTask)` and read back by `weave SavedTask(text)`, one $Task identity per record (D23).
//    The loom says what a record is; the format is named on both lines, so no parsing or joining is written here.
//
// 2. ONE PLACE BUILDS THE SCREEN. `View` gives every $Group and $Task that has no widgets yet its widgets, and
//    marks it #Shown (`target $Task not #Shown`, D25). Loading, "Add group" and "Add" only bring DATA; the view
//    follows. The data identity IS its widget: a group is its column, a task is its row, so a task's checkbox
//    and dropdown hang straight under the task.
//
// 3. A GROUP OWNS ITS WIDGETS. Its tab, badge, status, bar, box and buttons carry the stdlib's
//    *Vein.Core.Relations.$Owner (`do ownedBy(tab, g)`), so "which group is this?" is a field, not a climb up the window.
//    $Parent says where a widget is drawn; $Owner says what it belongs to — and `discard` takes both with it.
//
// 4. WHAT IS SHOWN IS DERIVED, IN `settled`. Counts, the progress bar, the badges, the priority colours and
//    "hide done" are recomputed after every change, so no handler has to remember to repaint.

bundle Todo by you {
    need "Vein.Desktop"
    need "Vein.UI"
    need "Vein.Core"
    need "Vein.Graphics"

    // ---- the data ---------------------------------------------------------------------------------------

    shape $Group { name: string }
    shape $Task { group: string, text: string, done: bool = false, priority: int = 1 }

    builder Group { $Group   mark #Group }
    builder Task { $Task   mark #Task }

    // The same two shapes as records of a file: written with toText<Json>, read back with weave.
    loom<Json> SavedGroup { $Group   mark #Group }
    loom<Json> SavedTask { $Task   mark #Task }

    event @AddGroup { name: string }
    event @AddTask { group: Entity, text: string, priority: int = 1 }
    event @DropGroup { group: Entity }
    event @Show { group: Entity }
    event @ShowSome { }
    event @Changed { }                    // something the user did; the next frame saves

    mark #Group
    mark #Task
    mark #Shown         // data that has its widgets
    mark #Fresh         // a group just added by the user: open it once it is shown
    mark #NewGroup      // the box that names a new group
    mark #AddGroup      // …and its button
    mark #HideDone      // the switch that hides done tasks
    mark #Tabs          // the row of tabs
    mark #Tab           // one group's tab
    mark #TabBadge      // its count of tasks left
    mark #Groups        // the column every group lives in
    mark #Status        // a group's "1 of 3 left"
    mark #DoneBar       // its progress bar
    mark #DropGroup     // its Remove group button
    mark #Box           // its "add a task" box
    mark #NewPriority   // the priority a new task gets
    mark #Add           // its Add button
    mark #TaskList      // its scrolling list of tasks
    mark #Priority      // a task's priority dropdown
    mark #Done          // a task's checkbox
    mark #Delete        // a task's ✕
    mark #Empty         // the hint while there is no group
    mark #GroupsFile    // file tags (RULES 28c)
    mark #TasksFile
    mark #OldFile

    // ---- the window that is always there -------------------------------------------------------------------

    shard Build {
        run once {
            bring Window("To-do", 480.0, 640.0, "vslogo.png") as w
            bring Row(w, 10.0) as title
            bring Picture(title, "vslogo.png", 40.0)
            bring Heading(title, "To-do", 24.0)
            bring Row(w, 8.0) as top
            bring Input(top, "", "New group, e.g. Shopping") as name
            mark name #NewGroup
            bring Button(top, "Add group") as addGroup
            mark addGroup #AddGroup
            bring Switch(w, "Hide done tasks", false) as hide
            mark hide #HideDone
            bring Row(w, 6.0) as tabs
            mark tabs #Tabs
            bring Column(w, 16.0) as groups
            mark groups #Groups
            bring Label(w, "") as empty
            mark empty #Empty
        }
    }

    // ---- what the user does: each action, one or two steps ---------------------------------------------

    shard Actions {
        hear *Vein.UI.Interaction.@Clicked as c {
            target $Button #AddGroup on c.target as b {
                target $Field #NewGroup as f { emit @AddGroup { name: f.Field.value } }
            }
            target $Owner #Add on c.target as b {
                emit @AddTask { group: b.Owner.ownerId, text: boxText(b.Owner.ownerId), priority: newPriority(b.Owner.ownerId) }
            }
            target $Owner #Tab on c.target as t { emit @Show { group: t.Owner.ownerId } }
            target $Owner #DropGroup on c.target as d { emit @DropGroup { group: d.Owner.ownerId } }
            target $Parent #Delete on c.target as d {
                do discard(d.Parent.of)           // the ✕'s parent is its task
                emit @Changed { }
            }
        }

        hear @Submitted as s {
            target $Field #NewGroup on s.target as f { emit @AddGroup { name: s.value } }
            target $Owner #Box on s.target as b {
                emit @AddTask { group: b.Owner.ownerId, text: s.value, priority: newPriority(b.Owner.ownerId) }
            }
        }

        // A task's checkbox and dropdown sit under the task itself: one step up is the $Task.
        hear @Toggled as e {
            target $Parent #Done on e.target as box {
                target $Task on box.Parent.of as t { t.Task.done = e.checked }
                emit @Changed { }
            }
        }

        hear @Picked as e {
            target $Parent #Priority on e.target as pick {
                target $Task on pick.Parent.of as t { t.Task.priority = e.picked + 1 }
                emit @Changed { }
            }
        }
    }

    // ---- what it changes: data only — `View` draws it -----------------------------------------------

    shard Data {
        hear @AddGroup as a {
            // A name already taken opens that group instead: two "Shopping"s could not be told apart.
            var taken = false
            target $Group as g {
                if g.Group.name == a.name {
                    taken = true
                    emit @Show { group: g }
                }
            }
            if not (a.name == "") and not taken {
                bring Group(a.name) as fresh
                mark fresh #Fresh
                emit @Changed { }
            }
            target $Field #NewGroup as f { f.Field.value = "" }
        }

        hear @AddTask as a {
            if not (a.text == "") {
                target $Group on a.group as g { bring Task(g.Group.name, a.text, false, a.priority) }
                emit @Changed { }
                target $Owner #Box as b {
                    if b.Owner.ownerId == a.group { target $Field on b as f { f.Field.value = "" } }
                }
            }
        }

        // The group's column holds its tasks; its tab and badge are owned by it, so they go with it too.
        hear @DropGroup as d {
            do discard(d.group)
            emit @Changed { }
            emit @ShowSome { }
        }

        // Exactly one group shown: the one asked for. Its tab is the accented one.
        hear @Show as s {
            target $Group #Shown as g {
                if g == s.group { unmark g #Hidden } else { mark g #Hidden }
            }
            target $Owner #Tab as t {
                if t.Owner.ownerId == s.group { mark t #Accent } else { unmark t #Accent }
            }
        }

        // When no group is showing, show the first one.
        hear @ShowSome as x {
            var showing = 0
            target $Group #Shown not #Hidden as g { showing += 1 }
            if showing == 0 {
                var first = 0
                target $Group #Shown as g {
                    first += 1
                    if first == 1 { emit @Show { group: g } }
                }
            }
        }
    }

    // ---- the view: data that has no widgets yet gets them --------------------------------------------

    shard View {
        settled {
            // A group becomes its own column inside #Groups, with a header, a progress bar, an entry row and a
            // scrolling list; its tab and badge go in the tab row. It starts hidden: @Show decides what is seen.
            target $Group not #Shown as g {
                target $Panel #Groups as groups {
                    attach $Parent to g { of: groups }
                    attach $Panel to g { gap: 6.0 }
                    mark g #Shown #Hidden
                    do groupWidgets(g, g.Group.name)
                }
                target $Panel #Tabs as tabs {
                    bring Button(tabs, g.Group.name) as tab
                    mark tab #Tab
                    do ownedBy(tab, g)
                    bring Badge(tabs, "0") as badge
                    mark badge #TabBadge
                    do ownedBy(badge, g)
                }
                if g carries #Fresh { emit @Show { group: g } } else { emit @ShowSome { } }
            }

            // A task becomes its own row in its group's list — once that list exists.
            target $Task not #Shown as t {
                let list = listFor(t.Task.group)
                if not (list == 0) {
                    attach $Parent to t { of: list }
                    attach $Panel to t { gap: 8.0 }
                    mark t #Shown #Row
                    do taskWidgets(t, t.Task.text, t.Task.done, t.Task.priority)
                }
            }
        }
    }

    SF groupWidgets(g: Entity, name: string) {
        bring Row(g, 12.0) as head
        bring Heading(head, name, 18.0)
        bring Label(head, "") as status
        mark status #Status
        do ownedBy(status, g)
        bring Button(head, "Remove group") as drop
        mark drop #DropGroup
        do ownedBy(drop, g)
        attach $Tip to drop { text: "Remove this group and every task in it" }
        bring Progress(g, 0.0, 1.0) as bar
        mark bar #DoneBar
        do ownedBy(bar, g)
        bring Divider(g, 1.0)
        bring Row(g, 8.0) as entry
        bring Input(entry, "", "Add a task to " + name) as box
        mark box #Box
        do ownedBy(box, g)
        bring Dropdown(entry, levels(), 0) as pick
        mark pick #NewPriority
        do ownedBy(pick, g)
        bring Button(entry, "Add") as add
        mark add #Add
        do ownedBy(add, g)
        bring Scroll(g, 300.0, 4.0) as list
        mark list #TaskList
        do ownedBy(list, g)
    }

    SF taskWidgets(t: Entity, text: string, done: bool, priority: int) {
        bring Dropdown(t, levels(), priority - 1) as chip
        mark chip #Priority
        attach $Tint to chip { }
        attach $Tip to chip { text: "Priority" }
        bring Check(t, text, done) as box
        mark box #Done
        bring Button(t, "✕") as del
        mark del #Delete
        attach $Tip to del { text: "Remove this task" }
    }

    // ---- what is shown, derived -------------------------------------------------------------------------

    shard Status {
        settled {
            var hide = false
            target $Toggle #HideDone as h { hide = h.Toggle.checked }
            target $Task #Shown as t {
                if hide and t.Task.done { mark t #Hidden } else { unmark t #Hidden }
            }

            var groups = 0
            target $Group #Shown as g {
                groups += 1
                let all = total(g.Group.name)
                let open = left(g.Group.name)
                target $Owner as w { if w.Owner.ownerId == g { do show(w, all, open) } }
            }

            target $Text #Empty as e {
                if groups == 0 { e.Text.content = "No group yet. Name one above, then press Enter." } else { e.Text.content = "" }
            }
        }
    }

    // One of a group's widgets, brought up to date: whichever it is — the status text, the bar, the badge.
    SF show(w: Entity, all: int, open: int) {
        target $Text #Status on w as s {
            if all == 0 { s.Text.content = "empty" } else { s.Text.content = string(open) + " of " + string(all) + " left" }
        }
        target $Progress on w as p {
            p.Progress.value = float(all - open)
            if all == 0 { p.Progress.max = 1.0 } else { p.Progress.max = float(all) }
        }
        target $Text #TabBadge on w as b { b.Text.content = string(open) }
    }

    // Priority: one red, four intensities — `$Tint.a` follows the task's dropdown.
    shard Looks {
        settled {
            target $Choice #Priority as p {
                target $Tint on p as t {
                    t.Tint.r = 0.92
                    t.Tint.g = 0.26
                    t.Tint.b = 0.21
                    t.Tint.a = intensity(p.Choice.picked + 1)
                }
            }
        }
    }

    // ---- what it remembers: groups.json and tasks.json, beside the program --------------------------

    shard Storage {
        var changed = false

        run once {
            emit *Vein.Files.Io.@ReadFile { path: "groups.json", tag: #GroupsFile }
            emit *Vein.Files.Io.@ReadFile { path: "tasks.json", tag: #TasksFile }
        }

        hear *Vein.Files.Io.@FileLoaded as f {
            if f.tag == #GroupsFile { weave SavedGroup(f.text) }
            if f.tag == #TasksFile { weave SavedTask(f.text) }
            if f.tag == #OldFile { do migrate(f.text) }
        }

        // No tasks.json yet: bring along a todo.json from before this version, if there is one.
        hear *Vein.Files.Io.@FileMissing as f {
            if f.tag == #TasksFile { emit *Vein.Files.Io.@ReadFile { path: "todo.json", tag: #OldFile } }
        }

        hear @Changed as c { changed = true }

        // Written only after something the user did — so nothing is ever saved before it has been loaded.
        settled {
            if changed {
                emit *Vein.Files.Io.@WriteFile { path: "groups.json", text: toText<Json>(SavedGroup), tag: #GroupsFile }
                emit *Vein.Files.Io.@WriteFile { path: "tasks.json", text: toText<Json>(SavedTask), tag: #TasksFile }
                changed = false
            }
        }
    }

    // The old one-file format: {"groups":[{"group":{"name":…},"tasks":[{"label":…,"checked":…,"priority":…}]}]}.
    SF migrate(text: string) {
        target fromJson(text).groups as grp {
            bring Group(grp.group.name)
            target grp.tasks as task { bring Task(grp.group.name, task.label, task.checked, levelOf(string(task.priority))) }
        }
        emit @Changed { }
    }

    // ---- small answers -------------------------------------------------------------------------------

    fn levels() return list<string> { return ["Low", "Medium", "High", "Very high"] }

    fn intensity(level: int) return float {
        if level >= 4 { return 1.0 }
        if level == 3 { return 0.7 }
        if level == 2 { return 0.42 }
        return 0.18
    }

    // A saved level, or Low when there is none (an old file) or it is out of range.
    fn levelOf(saved: string) return int {
        if isNumber(saved) {
            let n = int(saved)
            if n >= 1 and n <= 4 { return n }
        }
        return 1
    }

    fn total(group: string) return int {
        var n = 0
        target $Task as t { if t.Task.group == group { n += 1 } }
        return n
    }

    fn left(group: string) return int {
        var n = 0
        target $Task as t { if t.Task.group == group and not t.Task.done { n += 1 } }
        return n
    }

    // A group's task list, found by its name — 0 until the group's widgets exist.
    fn listFor(group: string) return Entity {
        var list = 0
        target $Group #Shown as g {
            if g.Group.name == group {
                target $Owner #TaskList as l { if l.Owner.ownerId == g { list = l } }
            }
        }
        return list
    }

    fn boxText(group: Entity) return string {
        var text = ""
        target $Owner #Box as b { if b.Owner.ownerId == group { target $Field on b as f { text = f.Field.value } } }
        return text
    }

    fn newPriority(group: Entity) return int {
        var level = 1
        target $Owner #NewPriority as p { if p.Owner.ownerId == group { target $Choice on p as c { level = c.Choice.picked + 1 } } }
        return level
    }
}
