// samples/desktop/planner/planner.vein — a project planner: projects in a sidebar and as TABS you can drag, each
// one's tasks as a BOARD (lanes, cards that move) or as a LIST (priorities, progress, hide done), saved to .plan
// files you pick.
//
//   In the Workbench, press ▶ (F5): its window opens, built by its views, on example.plan beside it.
//   veinc run samples/desktop/planner/planner.vein --ticks 8      (its rules alone, with no window drawn)
//
// A BIG PROGRAM IN ONE FILE, KEPT READABLE BY FOUR IDEAS:
//
// 1. THE DATA IS A TREE OF `owns` LISTS (D24). The planner owns the open plan; a plan owns its projects, a project
//    its lanes, a lane its cards. Closing a plan ends all of it; moving a card is adding it to another lane's list.
//    A plan also keeps a second list, `~tabs`, that does NOT own: closing a tab leaves the project where it is.
//
// 2. EVERY PIECE OF THE SCREEN IS A VIEW ON ONE KIND OF IDENTITY (D26), placed by its parent's socket — in the
//    socket's collection's ORDER, so `.move(x, i)` on the data moves it on the screen. Fourteen views; a project has
//    four (a sidebar entry, a tab, a board, a list) and a card two (a tile, a line):
//
//      PlannerWindow on $Planner   menu bar · toolbar · Split( sidebar | pages ) · status bar
//      StatusLine    on $Planner   the status bar's words
//      PlanSidebar   on $Plan      its projects (drag to reorder)    RecentItem  on $Recent   a recently used file
//      PlanPages     on $Plan      its tab strip and pages           FolderEntry on $Entry    a .plan beside the open one
//      ProjectItem   on $Project   a sidebar entry                   ProjectTab  on $Project  a tab (drag it; × closes)
//      ProjectBoard  on $Project   the board page                    ProjectList on $Project  the list page
//      LaneColumn    on $Lane      a board column                    LaneSection on $Lane     a list section
//      CardTile      on $Card      a card on the board               CardLine    on $Card     a task in the list
//
// 3. FILES GO THROUGH LOOMS, BOTH WAYS. A .plan file is {"cards": […], "lanes": […], "projects": […], "plan": […]}:
//    each list is one loom's toText<Json>, read back by the same loom with `weave` — cards first, so a lane finds
//    its cards by id, then lanes, projects, and the plan (its projects' and tabs' order, and the open one).
//
// 4. HANDLERS CHANGE DATA; `settled` DERIVES WHAT IS SHOWN. Which page is visible, the accents, a tab's unsaved dot,
//    the counts, the colours, "hide done", the window's title are all recomputed from the data every frame.

bundle Planner by you {
    need "Vein.Desktop"
    need "Vein.UI"
    need "Vein.Core"
    need "Vein.Graphics"

    // ---- the data ---------------------------------------------------------------------------------------

    shape $Card { id: string, title: string, done: bool = false, priority: int = 1 }
    shape $Lane { id: string, name: string, ~<list> cards: owns $Card }
    shape $Project { id: string, name: string, ~<list> lanes: owns $Lane }

    // What a .plan file holds besides its projects: their order, the open tabs in theirs, and the tab showing.
    shape $Plan { id: string, open: string = "", ~<list> projects: owns $Project, ~<list> tabs: $Project }

    shape $Recent { path: string }
    shape $Entry { name: string, path: string }

    // The planner itself: the open file, whether it changed, the page kind, and what the sidebar lists.
    shape $Planner {
        title: string, file: string = "", dirty: bool = false, warned: bool = false,
        mode: string = "board", hideDone: bool = false,
        ~<list> plans: owns $Plan, ~<list> recents: owns $Recent, ~<list> entries: owns $Entry
    }

    builder Card { $Card   mark #Card }
    builder Lane { $Lane   mark #Lane }
    builder Project { $Project   mark #Project }
    builder Plan { $Plan   mark #Plan }
    builder Recent { $Recent   mark #Recent }
    builder Entry { $Entry   mark #Entry }
    builder Planner { $Planner   mark #Planner }

    // The file's four lists, and the recent files beside the program.
    loom<Json> SavedCard { $Card   mark #Card }
    loom<Json> SavedLane { $Lane   mark #Lane }
    loom<Json> SavedProject { $Project   mark #Project }
    loom<Json> SavedPlan { $Plan   mark #Plan }
    loom<Json> SavedRecent { $Recent   mark #Recent }

    event @Changed { }          // the user changed the plan: it is unsaved now
    event @LoadPlan { }         // the old plan is gone; weave the new one
    event @Fresh { }            // the old plan is gone; start an empty one
    event @RecentsChanged { }   // write planner.recent.json

    mark #Card
    mark #Lane
    mark #Project
    mark #Plan
    mark #Recent
    mark #Entry
    mark #Planner
    mark #Edited            // a project changed since the plan was last saved: its tab shows a dot
    // what the user can do — a menu item and a toolbar button for the same thing wear the same mark
    mark #New
    mark #Open
    mark #Save
    mark #SaveAs
    mark #ShowBoard
    mark #ShowList
    mark #ToggleDone
    mark #HideDone
    mark #AddProject
    mark #ProjectName
    mark #DropOpenProject
    mark #OpenProject
    mark #TabItem
    mark #TabLabel
    mark #CloseTab
    mark #DropProject
    mark #LaneName
    mark #AddLane
    mark #DropLane
    mark #CardName
    mark #NewPriority
    mark #AddCard
    mark #MoveLeft
    mark #MoveRight
    mark #DeleteCard
    mark #Done
    mark #Priority
    mark #OpenRecent
    mark #OpenEntry
    // what is shown
    mark #BoardPage
    mark #ListPage
    mark #NoTabs
    mark #Tile
    mark #Line
    mark #LaneCount
    mark #LaneStatus
    mark #LaneBar
    mark #ProjectProgress
    mark #FileLabel
    mark #CountLabel
    mark #SaveLabel
    // file tags (RULES 28c)
    mark #PlanFile
    mark #RecentsFile
    mark #PlanFolder
    mark #OpenPlan
    mark #SavePlan

    // ---- the views ------------------------------------------------------------------------------------

    ShardView PlannerWindow on $Planner as a {
        Window(a.Planner.title, 1120.0, 700.0) {
            MenuBar() {
                Menu("File") {
                    MenuItem("New") mark #New as newItem
                    attach $Shortcut to newItem { keys: "Ctrl+N" }
                    MenuItem("Open…") mark #Open as openItem
                    attach $Shortcut to openItem { keys: "Ctrl+O" }
                    MenuItem("Save") mark #Save as saveItem
                    attach $Shortcut to saveItem { keys: "Ctrl+S" }
                    MenuItem("Save as…") mark #SaveAs as saveAsItem
                    attach $Shortcut to saveAsItem { keys: "Ctrl+Shift+S" }
                }
                Menu("View") {
                    MenuItem("Board") mark #ShowBoard as boardItem
                    attach $Shortcut to boardItem { keys: "Ctrl+1" }
                    MenuItem("List") mark #ShowList as listItem
                    attach $Shortcut to listItem { keys: "Ctrl+2" }
                    MenuItem("-")
                    MenuItem("Hide done tasks") mark #ToggleDone as doneItem
                    attach $Shortcut to doneItem { keys: "Ctrl+H" }
                }
                Menu("Project") {
                    MenuItem("Remove this project") mark #DropOpenProject
                }
            }
            Toolbar(6.0) {
                Button("New") mark #New
                Button("Open") mark #Open
                Button("Save") mark #Save
                Spacer(16.0)
                Button("Board") mark #ShowBoard
                Button("List") mark #ShowList
                Spacer(16.0)
                Switch("Hide done", false) mark #HideDone
            }
            Split(250.0) {
                Scroll(4000.0, 6.0) {
                    Column(6.0) socket !PlanSidebar(a.Planner.~plans)
                    Divider(1.0)
                    Heading("Recent", 14.0)
                    Column(2.0) socket !RecentItem(a.Planner.~recents)
                    Heading("In this folder", 14.0)
                    Column(2.0) socket !FolderEntry(a.Planner.~entries)
                }
                Scroll(4000.0, 8.0) {
                    Column(8.0) socket !PlanPages(a.Planner.~plans)
                }
            }
            StatusBar(20.0) socket !StatusLine
        }
    }

    ShardView StatusLine on $Planner as s {
        Label("") mark #FileLabel
        Label("") mark #CountLabel
        Label("") mark #SaveLabel
    }

    // ---- the sidebar: the plan's projects (drag one onto another to move it), recent files, the folder --------

    ShardView PlanSidebar on $Plan as plan {
        Column(2.0) {
            Heading("Projects", 14.0)
            Column(2.0) socket !ProjectItem(plan.Plan.~projects)
            Row(4.0) {
                Input("", "New project") mark #ProjectName
                Button("+") mark #AddProject
            }
        }
    }

    ShardView ProjectItem on $Project as p {
        Button(p.Project.name) mark #Flat #OpenProject #Draggable as item
        attach $Tip to item { text: "Drag onto another project to move it" }
    }

    ShardView RecentItem on $Recent as r {
        Button(baseName(r.Recent.path)) mark #Flat #OpenRecent as item
        attach $Tip to item { text: r.Recent.path }
    }

    ShardView FolderEntry on $Entry as e {
        Button(e.Entry.name) mark #Flat #OpenEntry
    }

    // ---- the pages: a strip of tabs, and the open project's board or list -----------------------------

    ShardView PlanPages on $Plan as plan {
        Column(8.0) {
            Row(2.0) socket !ProjectTab(plan.Plan.~tabs)
            Divider(1.0)
            Label("No project open — pick one in the sidebar.") mark #NoTabs
            Column(8.0) socket !ProjectBoard(plan.Plan.~projects)
            Column(8.0) socket !ProjectList(plan.Plan.~projects)
        }
    }

    // A tab, as the Workbench draws one: its name (with a dot while unsaved) and a ×. Drag it onto another tab to
    // move it there.
    ShardView ProjectTab on $Project as t {
        Row(0.0) mark #TabItem #Draggable {
            Button(t.Project.name) mark #Flat #TabLabel
            Button("×") mark #Flat #CloseTab as close
            attach $Tip to close { text: "Close this tab — the project stays in the sidebar" }
        }
    }

    // ---- the board: columns of cards that move -----------------------------------------------------------

    ShardView ProjectBoard on $Project as p {
        Column(12.0) mark #BoardPage #Hidden {
            Row(8.0) {
                Heading(p.Project.name, 22.0)
                Input("", "New lane") mark #LaneName
                Button("Add lane") mark #AddLane
                Button("Remove project") mark #DropProject
            }
            Row(16.0) socket !LaneColumn(p.Project.~lanes)
        }
    }

    ShardView LaneColumn on $Lane as l {
        Column(6.0) {
            Row(6.0) {
                Heading(l.Lane.name, 16.0)
                Badge("0") mark #LaneCount
                Button("✕") mark #DropLane as drop
                attach $Tip to drop { text: "Remove this lane and its cards" }
            }
            Column(6.0) socket !CardTile(l.Lane.~cards)
            Row(4.0) {
                Input("", "New card") mark #CardName
                Button("+") mark #AddCard
            }
        }
    }

    ShardView CardTile on $Card as c {
        Column(2.0) mark #Tile {
            Row(4.0) {
                Dropdown(levels(), c.Card.priority - 1) mark #Priority as chip
                attach $Tint to chip { r: 0.92, g: 0.26, b: 0.21, a: intensity(c.Card.priority) }
                Button("←") mark #MoveLeft
                Button("→") mark #MoveRight
                Button("✕") mark #DeleteCard
            }
            Check(c.Card.title, c.Card.done) mark #Done
        }
    }

    // ---- the list: the same lanes and cards, as sections of tasks ---------------------------------------

    ShardView ProjectList on $Project as p {
        Column(12.0) mark #ListPage #Hidden {
            Heading(p.Project.name, 22.0)
            Label("") mark #ProjectProgress
            Column(16.0) socket !LaneSection(p.Project.~lanes)
        }
    }

    ShardView LaneSection on $Lane as l {
        Column(6.0) {
            Row(8.0) {
                Heading(l.Lane.name, 16.0)
                Label("") mark #LaneStatus
            }
            Progress(0.0, 1.0) mark #LaneBar
            Column(2.0) socket !CardLine(l.Lane.~cards)
            Row(6.0) {
                Input("", "Add a task to " + l.Lane.name) mark #CardName
                Dropdown(levels(), 0) mark #NewPriority
                Button("Add") mark #AddCard
            }
        }
    }

    ShardView CardLine on $Card as c {
        Row(8.0) mark #Line {
            Dropdown(levels(), c.Card.priority - 1) mark #Priority as chip
            attach $Tint to chip { r: 0.92, g: 0.26, b: 0.21, a: intensity(c.Card.priority) }
            Check(c.Card.title, c.Card.done) mark #Done
            Button("✕") mark #DeleteCard
        }
    }

    // ---- what the user does: data changes ------------------------------------------------------------

    shard Start {
        run once { bring Planner("Planner", "", false, false, "board", false, [], [], []) }
    }

    shard Actions {
        hear *Vein.UI.Interaction.@Clicked as k {
            // the file and the view: menu items and toolbar buttons alike
            target $Button #New on k.target as b { do leaveThen("new", "") }
            target $Button #Open on k.target as b { do leaveThen("pick", "") }
            target $Button #Save on k.target as b { do save(false) }
            target $Button #SaveAs on k.target as b { do save(true) }
            target $Button #ShowBoard on k.target as b { target $Planner as a { a.Planner.mode = "board" } }
            target $Button #ShowList on k.target as b { target $Planner as a { a.Planner.mode = "list" } }
            target $Button #ToggleDone on k.target as b { target $Planner as a { a.Planner.hideDone = not a.Planner.hideDone } }
            target $Button #DropOpenProject on k.target as b { target $Plan as plan { do dropProjectById(plan.Plan.open) } }

            // the sidebar
            target $Button #AddProject on k.target as b { do addProject() }
            target $Owner #OpenProject on k.target as b { do openTab(b.Owner.ownerId) }
            target $Owner #OpenRecent on k.target as b { target $Recent on b.Owner.ownerId as r { do leaveThen("open", r.Recent.path) } }
            target $Owner #OpenEntry on k.target as b { target $Entry on b.Owner.ownerId as e { do leaveThen("open", e.Entry.path) } }

            // the tabs
            target $Owner #TabLabel on k.target as b { do openTab(b.Owner.ownerId) }
            target $Owner #CloseTab on k.target as b { do closeTab(b.Owner.ownerId) }

            // the pages: each button is owned by what it acts on
            target $Owner #DropProject on k.target as b { do dropProject(b.Owner.ownerId) }
            target $Owner #AddLane on k.target as b { do addLane(b.Owner.ownerId) }
            target $Owner #DropLane on k.target as b { do dropLane(b.Owner.ownerId) }
            target $Owner #AddCard on k.target as b { do addCard(b.Owner.ownerId) }
            target $Owner #MoveLeft on k.target as b { do moveCard(b.Owner.ownerId, -1) }
            target $Owner #MoveRight on k.target as b { do moveCard(b.Owner.ownerId, 1) }
            target $Owner #DeleteCard on k.target as b { do deleteCard(b.Owner.ownerId) }
        }

        // Dragging: a tab onto a tab moves it in the tab strip; a sidebar project onto another moves it in the plan.
        hear *Vein.Desktop.Events.@Dropped as d {
            target $Owner #TabItem on d.target as dragged {
                target $Owner #TabItem on d.onto as under { do moveTab(dragged.Owner.ownerId, under.Owner.ownerId) }
            }
            target $Owner #OpenProject on d.target as dragged {
                target $Owner #OpenProject on d.onto as under { do moveProject(dragged.Owner.ownerId, under.Owner.ownerId) }
            }
        }

        hear @Submitted as s {
            target $Field #ProjectName on s.target as f { do addProject() }
            target $Owner #LaneName on s.target as f { do addLane(f.Owner.ownerId) }
            target $Owner #CardName on s.target as f { do addCard(f.Owner.ownerId) }
        }

        hear @Toggled as e {
            target $Owner #Done on e.target as box {
                target $Card on box.Owner.ownerId as c { c.Card.done = e.checked }
                do touched(projectOfCard(box.Owner.ownerId))
            }
            target $Toggle #HideDone on e.target as t { target $Planner as a { a.Planner.hideDone = e.checked } }
        }

        hear @Picked as e {
            target $Owner #Priority on e.target as pick {
                target $Card on pick.Owner.ownerId as c { c.Card.priority = e.picked + 1 }
                do touched(projectOfCard(pick.Owner.ownerId))
            }
        }

        hear @Changed as c {
            target $Planner as a {
                a.Planner.dirty = true
                a.Planner.warned = false
            }
        }
    }

    // New, Open and the sidebar's files leave the open plan. With unsaved changes, the first try only warns;
    // trying again means it.
    SF leaveThen(what: string, path: string) {
        target $Planner as a {
            if a.Planner.dirty and not a.Planner.warned {
                a.Planner.warned = true
            } else {
                if what == "new" { do closePlan() }
                if what == "new" { emit @Fresh { } }
                if what == "pick" { emit *Vein.Desktop.Events.@PickOpenFile { title: "Open a plan", extension: "plan", tag: #OpenPlan } }
                if what == "open" { emit *Vein.Files.Io.@ReadFile { path: path, tag: #PlanFile } }
            }
        }
    }

    // A project changed: the plan is unsaved, and the project's tab says so.
    SF touched(project: Entity) {
        target $Project on project as p { mark p #Edited }
        emit @Changed { }
    }

    // Shown in its tab — opened one if it was not.
    SF openTab(project: Entity) {
        target $Plan as plan {
            target $Project on project as p {
                if not (plan.Plan.~tabs has project) { plan.Plan.~tabs.add(project) }
                plan.Plan.open = p.Project.id
            }
        }
    }

    // Only the tab goes: the project stays in the plan, and in the sidebar.
    SF closeTab(project: Entity) {
        target $Plan as plan { plan.Plan.~tabs.remove(project) }
    }

    // Dropped on another tab, a tab takes that tab's place; the one it lands on shifts over.
    SF moveTab(project: Entity, under: Entity) {
        target $Plan as plan {
            var at = -1
            target plan.Plan.~tabs as x { if x == under { at = Index } }
            if at >= 0 { plan.Plan.~tabs.move(project, at) }
        }
        emit @Changed { }
    }

    SF moveProject(project: Entity, under: Entity) {
        target $Plan as plan {
            var at = -1
            target plan.Plan.~projects as x { if x == under { at = Index } }
            if at >= 0 { plan.Plan.~projects.move(project, at) }
        }
        emit @Changed { }
    }

    // A project with the three usual lanes, named by the sidebar's box, opened in a tab. A bring is not seen by a
    // query until its event commits, so the new ids are numbered once, here.
    SF addProject() {
        target $Field #ProjectName as f {
            if not (trim(f.Field.value) == "") {
                let n = nextNumber()
                bring Lane("l" + n, "To do", []) as todo
                bring Lane("l" + (n + 1), "Doing", []) as doing
                bring Lane("l" + (n + 2), "Done", []) as done
                bring Project("p" + (n + 3), trim(f.Field.value), [todo, doing, done]) as p
                target $Plan as plan {
                    plan.Plan.~projects.add(p)
                    plan.Plan.~tabs.add(p)
                    plan.Plan.open = "p" + (n + 3)
                }
                f.Field.value = ""
                emit @Changed { }
            }
        }
    }

    // Out of the tabs, then out of the plan — and an `owns` list ends what leaves it: the project, its lanes, cards.
    SF dropProject(project: Entity) {
        target $Plan as plan {
            plan.Plan.~tabs.remove(project)
            if plan.Plan.~projects has project { plan.Plan.~projects.remove(project) }
        }
        emit @Changed { }
    }

    SF dropProjectById(id: string) {
        target $Project as p { if p.Project.id == id { do dropProject(p) } }
    }

    SF addLane(project: Entity) {
        target $Owner $Field #LaneName as f {
            if f.Owner.ownerId == project and not (trim(f.Field.value) == "") {
                bring Lane("l" + nextNumber(), trim(f.Field.value), []) as lane
                target $Project on project as p { p.Project.~lanes.add(lane) }
                f.Field.value = ""
                do touched(project)
            }
        }
    }

    SF dropLane(lane: Entity) {
        let project = projectOfLane(lane)
        target $Project as p { if p.Project.~lanes has lane { p.Project.~lanes.remove(lane) } }
        do touched(project)
    }

    // The lane has a box on the board and one in the list; the one that holds words is the one meant.
    SF addCard(lane: Entity) {
        var priority = 1
        target $Owner $Choice #NewPriority as pick { if pick.Owner.ownerId == lane { priority = pick.Choice.picked + 1 } }
        target $Owner $Field #CardName as f {
            if f.Owner.ownerId == lane and not (trim(f.Field.value) == "") {
                bring Card("c" + nextNumber(), trim(f.Field.value), false, priority) as card
                target $Lane on lane as l { l.Lane.~cards.add(card) }
                f.Field.value = ""
                do touched(projectOfLane(lane))
            }
        }
    }

    // To the lane `step` places along in the same project. Adding to an `owns` list moves the card out of its old
    // one, and its view follows it to the new lane's socket.
    SF moveCard(card: Entity, step: int) {
        let project = projectOfCard(card)
        target $Project on project as p {
            var at = -1
            target p.Project.~lanes as l { if l.Lane.~cards has card { at = Index } }
            if at >= 0 {
                target p.Project.~lanes as l { if Index == at + step { l.Lane.~cards.add(card) } }
            }
        }
        do touched(project)
    }

    SF deleteCard(card: Entity) {
        let project = projectOfCard(card)
        target $Lane as l { if l.Lane.~cards has card { l.Lane.~cards.remove(card) } }
        do touched(project)
    }

    // ---- what it remembers: .plan files, and the recent ones -------------------------------------------

    shard Storage {
        var pending = ""        // the plan being opened, woven one list at a time
        var pendingPath = ""
        var recentsChanged = false

        run once {
            emit *Vein.Files.Io.@ReadFile { path: "planner.recent.json", tag: #RecentsFile }
            emit *Vein.Files.Io.@ReadFile { path: "example.plan", tag: #PlanFile }
        }

        hear *Vein.Files.Io.@FileLoaded as f {
            if f.tag == #RecentsFile { weave SavedRecent(f.text) }
            if f.tag == #PlanFile {
                do closePlan()
                pending = f.text
                pendingPath = f.full
                emit @LoadPlan { }
            }
        }

        hear *Vein.Files.Io.@FileMissing as f {
            if f.tag == #PlanFile { emit @Fresh { } }
        }

        // The old plan's identities are gone by now (they ended at the last commit), so its ids are free again.
        hear @LoadPlan as l { weave SavedCard(toJson(fromJson(pending).cards)) }

        hear @Woven as w {
            if w.loom == "SavedCard" { weave SavedLane(toJson(fromJson(pending).lanes)) }
            if w.loom == "SavedLane" { weave SavedProject(toJson(fromJson(pending).projects)) }
            if w.loom == "SavedProject" { weave SavedPlan(toJson(fromJson(pending).plan)) }
            if w.loom == "SavedPlan" { do opened(pendingPath) }
            if w.loom == "SavedRecent" {
                target $Planner as a {
                    target $Recent as r { if not (a.Planner.~recents has r) { a.Planner.~recents.add(r) } }
                }
            }
        }

        // A file from before plans had a record of their own has no "plan" list: that is not a problem.
        hear @Unwoven as u { if not (u.loom == "SavedPlan") { emit *Vein.Console.Io.@Print { text: "! " + u.why } } }

        hear @Fresh as x {
            let n = nextNumber()
            bring Lane("l" + n, "To do", []) as todo
            bring Lane("l" + (n + 1), "Doing", []) as doing
            bring Lane("l" + (n + 2), "Done", []) as done
            bring Project("p" + (n + 3), "My project", [todo, doing, done]) as p
            bring Plan("plan", "p" + (n + 3), [p], [p]) as plan
            target $Planner as a {
                a.Planner.~plans.add(plan)
                a.Planner.file = ""
                a.Planner.dirty = false
                a.Planner.warned = false
            }
        }

        hear *Vein.Desktop.Events.@FilePicked as p {
            if p.tag == #OpenPlan { emit *Vein.Files.Io.@ReadFile { path: p.path, tag: #PlanFile } }
            if p.tag == #SavePlan { do writePlan(p.path) }
        }

        hear *Vein.Files.Io.@FileWritten as w {
            if w.tag == #PlanFile {
                target $Planner as a {
                    a.Planner.file = w.full
                    a.Planner.dirty = false
                    a.Planner.warned = false
                }
                target $Project #Edited as p { unmark p #Edited }
                do remember(w.full)
                emit *Vein.Files.Io.@ListFolder { path: folderOf(w.full), tag: #PlanFolder }
            }
        }

        // The sidebar's "In this folder": every .plan beside the open file.
        hear *Vein.Files.Io.@FolderListed as f {
            if f.tag == #PlanFolder {
                target $Planner as a {
                    a.Planner.~entries.clear()
                    target f.entries as name {
                        if endsWith(name, ".plan") {
                            bring Entry(name, f.full + "/" + name) as entry
                            a.Planner.~entries.add(entry)
                        }
                    }
                }
            }
        }

        hear @RecentsChanged as r { recentsChanged = true }

        settled {
            if recentsChanged {
                emit *Vein.Files.Io.@WriteFile { path: "planner.recent.json", text: toText<Json>(SavedRecent), tag: #RecentsFile }
                recentsChanged = false
            }
        }
    }

    // The plan goes, and with it — `owns` — every project, lane and card.
    SF closePlan() {
        target $Planner as a { a.Planner.~plans.clear() }
    }

    // The woven plan becomes the open one. A file from before plans had a record of their own gets one: its projects
    // in the file's order, each open in a tab.
    SF opened(path: string) {
        var plans = 0
        target $Plan as plan { plans += 1 }
        if plans == 0 {
            var all = []
            var first = ""
            target $Project as p {
                all += p
                if first == "" { first = p.Project.id }
            }
            bring Plan("plan", first, all, all) as made
            target $Planner as a { a.Planner.~plans.add(made) }
        }
        target $Planner as a {
            target $Plan as plan { if not (a.Planner.~plans has plan) { a.Planner.~plans.add(plan) } }
            a.Planner.file = path
            a.Planner.dirty = false
            a.Planner.warned = false
        }
        do remember(path)
        emit *Vein.Files.Io.@ListFolder { path: folderOf(path), tag: #PlanFolder }
    }

    SF save(asNew: bool) {
        target $Planner as a {
            if asNew or a.Planner.file == "" {
                emit *Vein.Desktop.Events.@PickSaveFile { title: "Save the plan as", extension: "plan", suggested: baseName(a.Planner.file), tag: #SavePlan }
            } else {
                do writePlan(a.Planner.file)
            }
        }
    }

    // The four lists, each written by the loom that reads it back.
    SF writePlan(path: string) {
        emit *Vein.Files.Io.@WriteFile { path: path, text: "{\"cards\": " + toText<Json>(SavedCard) + ", \"lanes\": " +
            toText<Json>(SavedLane) + ", \"projects\": " + toText<Json>(SavedProject) + ", \"plan\": " +
            toText<Json>(SavedPlan) + "}\n", tag: #PlanFile }
    }

    // Recent files, newest last, six at most, each once — by its full path, whichever way it was reached.
    SF remember(path: string) {
        var known = false
        target $Recent as r { if lower(r.Recent.path) == lower(path) { known = true } }
        if not known {
            bring Recent(path) as recent
            target $Planner as a {
                a.Planner.~recents.add(recent)
                var held = 0
                target a.Planner.~recents as r { held += 1 }
                if held > 6 {
                    target a.Planner.~recents as r { if Index == 0 { a.Planner.~recents.remove(r) } }
                }
            }
            emit @RecentsChanged { }
        }
    }

    // ---- what is shown, derived -------------------------------------------------------------------------

    shard Looks {
        settled {
            var mode = "board"
            var hide = false
            var file = ""
            var dirty = false
            var warned = false
            target $Planner as a {
                mode = a.Planner.mode
                hide = a.Planner.hideDone
                file = a.Planner.file
                dirty = a.Planner.dirty
                warned = a.Planner.warned
            }

            // The open tab, or the first tab when it was closed; none while no tab is open.
            var open = ""
            var tabs = 0
            target $Plan as plan {
                var found = false
                var first = ""
                target plan.Plan.~tabs as x {
                    tabs += 1
                    target $Project on x as p {
                        if p.Project.id == plan.Plan.open { found = true }
                        if first == "" { first = p.Project.id }
                    }
                }
                if not found { plan.Plan.open = first }
                open = plan.Plan.open
                if not found { open = first }
            }
            target $Text #NoTabs as t { if tabs == 0 { unmark t #Hidden } else { mark t #Hidden } }

            // One page at a time: the open project's board, or its list.
            target $Owner #BoardPage as page {
                target $Project on page.Owner.ownerId as p { if mode == "board" and p.Project.id == open { unmark page #Hidden } else { mark page #Hidden } }
            }
            target $Owner #ListPage as page {
                target $Project on page.Owner.ownerId as p { if mode == "list" and p.Project.id == open { unmark page #Hidden } else { mark page #Hidden } }
            }

            // The tab strip: the open tab accented, an unsaved project's name with a dot.
            target $Owner $Button #TabLabel as label {
                target $Project on label.Owner.ownerId as p {
                    if p.Project.id == open { mark label #Accent } else { unmark label #Accent }
                    if p carries #Edited { label.Button.label = p.Project.name + "  •" } else { label.Button.label = p.Project.name }
                }
            }
            target $Owner #OpenProject as item {
                target $Project on item.Owner.ownerId as p { if p.Project.id == open { mark item #Accent } else { unmark item #Accent } }
            }
            // A folder listing and a file dialog spell the same path with different slashes. The entries are the
            // open file's own folder, so its name is what to compare.
            target $Owner #OpenEntry as item {
                target $Entry on item.Owner.ownerId as e { if baseName(e.Entry.path) == baseName(file) { mark item #Accent } else { unmark item #Accent } }
            }
            target $Button #ShowBoard as b { if mode == "board" { mark b #Accent } else { unmark b #Accent } }
            target $Button #ShowList as b { if mode == "list" { mark b #Accent } else { unmark b #Accent } }
            target $Toggle #HideDone as t { t.Toggle.checked = hide }

            // Done tasks hidden on both pages, when asked; the priority colour follows each dropdown.
            target $Owner #Tile as w { target $Card on w.Owner.ownerId as c { if hide and c.Card.done { mark w #Hidden } else { unmark w #Hidden } } }
            target $Owner #Line as w { target $Card on w.Owner.ownerId as c { if hide and c.Card.done { mark w #Hidden } else { unmark w #Hidden } } }
            target $Owner $Choice $Tint #Priority as chip { chip.Tint.a = intensity(chip.Choice.picked + 1) }

            // Counts, per lane and per project.
            target $Owner $Text #LaneCount as label { target $Lane on label.Owner.ownerId as l { label.Text.content = string(cardsIn(l)) } }
            target $Owner $Text #LaneStatus as label {
                target $Lane on label.Owner.ownerId as l { label.Text.content = string(cardsIn(l) - doneIn(l)) + " of " + string(cardsIn(l)) + " left" }
            }
            target $Owner $Progress #LaneBar as bar {
                target $Lane on bar.Owner.ownerId as l {
                    bar.Progress.value = float(doneIn(l))
                    bar.Progress.max = float(max1(cardsIn(l)))
                }
            }
            target $Owner $Text #ProjectProgress as label {
                target $Project on label.Owner.ownerId as p {
                    var all = 0
                    var done = 0
                    target p.Project.~lanes as l {
                        all += cardsIn(l)
                        done += doneIn(l)
                    }
                    label.Text.content = string(done) + " of " + string(all) + " tasks done"
                }
            }

            // The window's title and the status bar.
            var cards = 0
            var finished = 0
            target $Card as c {
                cards += 1
                if c.Card.done { finished += 1 }
            }
            var name = "untitled"
            if not (file == "") { name = baseName(file) }
            var dot = ""
            if dirty { dot = " •" }
            target $Owner $Window as w { w.Window.title = "Planner — " + name + dot }
            target $Text #FileLabel as t { t.Text.content = name }
            target $Text #CountLabel as t { t.Text.content = string(cards) + " cards, " + string(finished) + " done" }
            target $Text #SaveLabel as t {
                t.Text.content = "saved"
                if dirty { t.Text.content = "unsaved" }
                if warned { t.Text.content = "Unsaved changes — Save first, or do it again to discard them" }
            }
        }
    }

    // ---- small answers -------------------------------------------------------------------------------

    fn levels() return list<string> { return ["Low", "Medium", "High", "Very high"] }

    fn intensity(level: int) return float {
        if level >= 4 { return 1.0 }
        if level == 3 { return 0.7 }
        if level == 2 { return 0.42 }
        return 0.18
    }

    fn projectOfLane(lane: Entity) return Entity {
        var found = 0
        target $Project as p { if p.Project.~lanes has lane { found = p } }
        return found
    }

    fn projectOfCard(card: Entity) return Entity {
        var found = 0
        target $Lane as l { if l.Lane.~cards has card { found = projectOfLane(l) } }
        return found
    }

    fn cardsIn(lane: Entity) return int {
        var n = 0
        target $Lane on lane as l { target l.Lane.~cards as c { n += 1 } }
        return n
    }

    fn doneIn(lane: Entity) return int {
        var n = 0
        target $Lane on lane as l { target l.Lane.~cards as c { if c.Card.done { n += 1 } } }
        return n
    }

    fn max1(n: int) return int {
        if n < 1 { return 1 }
        return n
    }

    // A number no card, lane or project uses yet: one more than the largest after their first letter.
    fn nextNumber() return int {
        var top = 0
        target $Card as c { top = larger(top, numberIn(c.Card.id)) }
        target $Lane as l { top = larger(top, numberIn(l.Lane.id)) }
        target $Project as p { top = larger(top, numberIn(p.Project.id)) }
        return top + 1
    }

    fn numberIn(id: string) return int {
        let digits = substring(id, 1, len(id) - 1)
        if isNumber(digits) { return int(digits) }
        return 0
    }

    fn larger(a: int, b: int) return int {
        if a > b { return a }
        return b
    }

    fn baseName(path: string) return string {
        let parts = split(replace(path, "\\", "/"), "/")
        return parts[len(parts) - 1]
    }

    fn folderOf(path: string) return string {
        let parts = split(replace(path, "\\", "/"), "/")
        if len(parts) <= 1 { return "." }
        return join(slice(parts, 0, len(parts) - 1), "/")
    }
}
