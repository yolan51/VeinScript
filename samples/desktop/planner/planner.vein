// samples/desktop/planner/planner.vein — a project planner: projects in a sidebar and as TABS you can drag, each
// one's tasks as a BOARD (lanes, cards that move) or as a LIST (priorities, progress, hide done), saved to .plan
// files.
//
//   In the Workbench, press ▶ (F5): its window opens on example.plan beside it.
//   veinc run samples/desktop/planner/planner.vein --ticks 8      (its rules alone, with no window drawn)
//
// MOST OF THE APP IS THE STDLIB'S, TAKEN AS TEMPLATES (D27) — each a line here:
//
//   *Vein.Desktop.Document   the window, File menu and toolbar, dialogs, unsaved warning, recents, the folder, the title
//   *Vein.Desktop.Tabs       a tab per project: click, ×, drag to move, a dot while unsaved
//   *Vein.Desktop.Board      a project's lanes and cards, as a board or as a list: add, move, tick, prioritise, count
//
// WHAT THIS FILE WRITES is what only a planner has: a PLAN of projects (a project is a board with a tab), the sidebar
// of projects you can drag, the board/list switch, and the hooks the templates call — documentNew, documentLoaded,
// documentText for the file, boardChanged for an edit. A .plan file is {"cards", "lanes", "projects", "plan"}, each
// list one loom's toText<Json>, read back by the same loom: cards first, so a lane finds its cards by id.

bundle Planner by you {
    need "Vein.Desktop"
    need "Vein.UI"
    need "Vein.Core"
    need "Vein.Graphics"

    // ---- the data: the planner's own; boards, lanes, cards and tabs are the stdlib's ------------------------

    // A plan: its projects (boards) in order, and — from the stdlib's $TabStrip — its open tabs and the one showing.
    shape $Plan { id: string, ~<list> projects: owns $TaskBoard }

    // The planner's own state, on the same identity as the shell's $Document.
    shape $Planner { mode: string = "board", ~<list> plans: owns $Plan }

    builder Project { *Vein.Desktop.Board.$TaskBoard  *Vein.Desktop.Tabs.$Tab   mark #Project }
    builder Plan { $Plan  *Vein.Desktop.Tabs.$TabStrip   mark #Plan }

    loom<Json> SavedProject { *Vein.Desktop.Board.$TaskBoard   mark #Project }
    loom<Json> SavedPlan { $Plan  *Vein.Desktop.Tabs.$TabStrip   mark #Plan }

    event @LoadPlan { text: string }    // the old plan is gone; weave this one
    event @Fresh { }                     // the old plan is gone; start an empty one

    mark #Project
    mark #Plan
    mark #ShowBoard
    mark #ShowList
    mark #ToggleDone
    mark #HideDone
    mark #AddProject
    mark #ProjectName
    mark #DropOpenProject
    mark #OpenProject
    mark #DropProject
    mark #NoTabs
    mark #CountLabel

    // ---- the window: the shell's, with the planner's parts in its slots ------------------------------------

    ShardView PlannerWindow from *Vein.Desktop.Document.!DocumentWindow {
        Menus {
            Menu("View") {
                MenuItem("Board") mark #ShowBoard as boardItem
                attach $Shortcut to boardItem { keys: "Ctrl+1" }
                MenuItem("List") mark #ShowList as listItem
                attach $Shortcut to listItem { keys: "Ctrl+2" }
                MenuItem("-")
                MenuItem("Hide done tasks") mark #ToggleDone as doneItem
                attach $Shortcut to doneItem { keys: "Ctrl+H" }
            }
            Menu("Project") {
                MenuItem("Remove this project") mark #DropOpenProject
            }
        }
        Tools {
            Button("Board") mark #ShowBoard
            Button("List") mark #ShowList
            Spacer(16.0)
            Switch("Hide done", false) mark #HideDone
        }
        Sidebar { Column(2.0) socket !PlanSidebar(d.Planner.~plans) }
        Content { Column(8.0) socket !PlanPages(d.Planner.~plans) }
        Status { Label("") mark #CountLabel }
    }

    shard Files from *Vein.Desktop.Document.!DocumentFiles
    shard Tabs from *Vein.Desktop.Tabs.!TabActions
    shard Boards from *Vein.Desktop.Board.!BoardActions

    // ---- the sidebar: the plan's projects (drag one onto another to move it) ---------------------------------

    ShardView PlanSidebar on $Plan as plan {
        Column(2.0) {
            Heading("Projects", 14.0)
            Column(2.0) socket !ProjectItem(plan.Plan.~projects)
            Row(4.0) {
                Input("", "New project") mark #ProjectName
                Button("+") mark #AddProject
            }
        }
    }

    ShardView ProjectItem on $TaskBoard as p {
        Button(p.TaskBoard.name) mark #Flat #OpenProject #Draggable as item
        attach $Tip to item { text: "Drag onto another project to move it" }
    }

    // ---- the pages: the stdlib's tabs, and the open project as the stdlib's board or list ------------------

    ShardView PlanPages on $Plan as plan {
        Column(8.0) {
            Row(2.0) socket !ProjectTab(plan.TabStrip.~tabs)
            Divider(1.0)
            Label("No project open — pick one in the sidebar.") mark #NoTabs
            Column(8.0) socket !ProjectBoard(plan.Plan.~projects)
            Column(8.0) socket !ProjectList(plan.Plan.~projects)
        }
    }

    ShardView ProjectTab from *Vein.Desktop.Tabs.!TabItem
    ShardView ProjectBoard from *Vein.Desktop.Board.!BoardPage {
        Tools { Button("Remove project") mark #DropProject }
    }
    ShardView ProjectList from *Vein.Desktop.Board.!BoardList

    // ---- what the user does --------------------------------------------------------------------------------

    shard Start {
        run once {
            bring Document("Planner", "example.plan", "plan", false, false, [], []) as doc
            attach $Planner to doc { mode: "board" }
            attach $TaskBoardLooks to doc { hideDone: false }
        }
    }

    shard Actions {
        hear *Vein.UI.Interaction.@Clicked as k {
            target $Button #ShowBoard on k.target as b { target $Planner as a { a.Planner.mode = "board" } }
            target $Button #ShowList on k.target as b { target $Planner as a { a.Planner.mode = "list" } }
            target $Button #ToggleDone on k.target as b { target $TaskBoardLooks as looks { looks.TaskBoardLooks.hideDone = not looks.TaskBoardLooks.hideDone } }
            target $Button #DropOpenProject on k.target as b { target $Plan as plan { do dropProject(openTabOf(plan)) } }
            target $Button #AddProject on k.target as b { do addProject() }
            target $Owner #OpenProject on k.target as b { target $Plan as plan { do openTab(plan, b.Owner.ownerId) } }
            target $Owner #DropProject on k.target as b { do dropProject(b.Owner.ownerId) }
        }

        // A sidebar project dragged onto another takes its place in the plan.
        hear *Vein.Desktop.Events.@Dropped as d {
            target $Owner #OpenProject on d.target as dragged {
                target $Owner #OpenProject on d.onto as under { do moveProject(dragged.Owner.ownerId, under.Owner.ownerId) }
            }
            emit *Vein.Desktop.Document.@DocumentChanged { }
        }

        hear @Submitted as s {
            target $Field #ProjectName on s.target as f { do addProject() }
        }

        hear @Toggled as e {
            target $Toggle #HideDone on e.target as t { target $TaskBoardLooks as looks { looks.TaskBoardLooks.hideDone = e.checked } }
        }
    }

    // The board template's hook: the user changed this board. The document is unsaved; its tab shows a dot.
    SF boardChanged(board: Entity) {
        target $TaskBoard on board as p { mark p #TabUnsaved }
        emit *Vein.Desktop.Document.@DocumentChanged { }
    }

    SF moveProject(project: Entity, under: Entity) {
        target $Plan as plan {
            var at = -1
            target plan.Plan.~projects as x { if x == under { at = Index } }
            if at >= 0 { plan.Plan.~projects.move(project, at) }
        }
    }

    // A project with the three usual lanes, named by the sidebar's box, opened in a tab. A bring is not seen by a
    // query until its event commits, so the new ids are numbered once, here.
    SF addProject() {
        target $Field #ProjectName as f {
            if not (trim(f.Field.value) == "") {
                let n = nextNumber()
                let name = trim(f.Field.value)
                bring TaskLane("l" + n, "To do", []) as todo
                bring TaskLane("l" + (n + 1), "Doing", []) as doing
                bring TaskLane("l" + (n + 2), "Done", []) as done
                bring Project("p" + (n + 3), name, [todo, doing, done], name) as p
                target $Plan as plan {
                    plan.Plan.~projects.add(p)
                    do openTab(plan, p)
                }
                f.Field.value = ""
                emit *Vein.Desktop.Document.@DocumentChanged { }
            }
        }
    }

    // Its tab closes; out of the plan — and an `owns` list ends what leaves it: the project, its lanes, cards.
    SF dropProject(project: Entity) {
        target $Plan as plan {
            do closeTab(plan, project)
            if plan.Plan.~projects has project { plan.Plan.~projects.remove(project) }
        }
        emit *Vein.Desktop.Document.@DocumentChanged { }
    }

    // ---- the shell's hooks: how a plan becomes text and back ----------------------------------------------

    SF documentNew() {
        do closePlan()
        emit @Fresh { }
    }

    SF documentLoaded(text: string) {
        do closePlan()
        emit @LoadPlan { text: text }
    }

    // The four lists, each written by the loom that reads it back.
    fn documentText() return string {
        return "{\"cards\": " + toText<Json>(SavedTaskCard) + ", \"lanes\": " + toText<Json>(SavedTaskLane) + ", \"projects\": " +
            toText<Json>(SavedProject) + ", \"plan\": " + toText<Json>(SavedPlan) + "}\n"
    }

    // The plan goes, and with it — `owns` — every project, lane and card.
    SF closePlan() {
        target $Planner as a { a.Planner.~plans.clear() }
    }

    shard Loading {
        var pending = ""        // the plan being opened, woven one list at a time

        // The old plan's identities are gone by now (they ended at the last commit), so its ids are free again.
        hear @LoadPlan as l {
            pending = l.text
            weave SavedTaskCard(toJson(fromJson(pending).cards))
        }

        hear @Woven as w {
            if w.loom == "SavedTaskCard" { weave SavedTaskLane(toJson(fromJson(pending).lanes)) }
            if w.loom == "SavedTaskLane" { weave SavedProject(toJson(fromJson(pending).projects)) }
            if w.loom == "SavedProject" { weave SavedPlan(toJson(fromJson(pending).plan)) }
            if w.loom == "SavedPlan" { do adoptPlan() }
        }

        // A file from before plans had a record of their own has no usable "plan" list: that is not a problem.
        hear @Unwoven as u { if not (u.loom == "SavedPlan") { emit *Vein.Console.Io.@Print { text: "! " + u.why } } }

        hear @Fresh as x {
            let n = nextNumber()
            bring TaskLane("l" + n, "To do", []) as todo
            bring TaskLane("l" + (n + 1), "Doing", []) as doing
            bring TaskLane("l" + (n + 2), "Done", []) as done
            bring Project("p" + (n + 3), "My project", [todo, doing, done], "My project") as p
            bring Plan("plan", [p], 0, [p]) as plan
            target $Planner as a { a.Planner.~plans.add(plan) }
        }
    }

    // The woven plan becomes the planner's, each project given its tab's label. A file without a plan record gets
    // one: its projects in the file's order, each open in a tab.
    SF adoptPlan() {
        target $TaskBoard as b { attach $Tab to b { label: b.TaskBoard.name } }
        var plans = 0
        target $Plan as plan { plans += 1 }
        if plans == 0 {
            var all = []
            target $TaskBoard as b { all += b }
            bring Plan("plan", all, 0, all) as made
            target $Planner as a { a.Planner.~plans.add(made) }
        }
        target $Planner as a {
            target $Plan as plan { if not (a.Planner.~plans has plan) { a.Planner.~plans.add(plan) } }
        }
    }

    // ---- what is shown, derived -------------------------------------------------------------------------

    shard Looks {
        settled {
            var mode = "board"
            target $Planner as a { mode = a.Planner.mode }

            // The open project is the open tab's; one page shows it — its board or its list.
            var open = 0
            var tabs = 0
            target $Plan as plan {
                open = openTabOf(plan)
                target plan.TabStrip.~tabs as x { tabs += 1 }
            }
            target $Text #NoTabs as t { if tabs == 0 { unmark t #Hidden } else { mark t #Hidden } }
            target $Owner #BoardPage as page { if mode == "board" and page.Owner.ownerId == open { unmark page #Hidden } else { mark page #Hidden } }
            target $Owner #ListPage as page { if mode == "list" and page.Owner.ownerId == open { unmark page #Hidden } else { mark page #Hidden } }

            // Saved: no tab has a dot.
            target $Document as d { if not d.Document.dirty { target $TaskBoard #TabUnsaved as p { unmark p #TabUnsaved } } }

            target $Owner #OpenProject as item { if item.Owner.ownerId == open { mark item #Accent } else { unmark item #Accent } }
            target $Button #ShowBoard as b { if mode == "board" { mark b #Accent } else { unmark b #Accent } }
            target $Button #ShowList as b { if mode == "list" { mark b #Accent } else { unmark b #Accent } }
            target $TaskBoardLooks as looks { target $Toggle #HideDone as t { t.Toggle.checked = looks.TaskBoardLooks.hideDone } }

            var cards = 0
            var finished = 0
            target $TaskCard as c {
                cards += 1
                if c.TaskCard.done { finished += 1 }
            }
            target $Text #CountLabel as t { t.Text.content = string(cards) + " cards, " + string(finished) + " done" }
        }
    }
}
