// samples/event_strum/band.vein — three kits declare `@Strum`, and this bundle needs all three.
//
//   veinc run samples/event_strum/event_strum.app.vein --ticks 1
//
// THE QUESTION: three bundles in one app each declare an event called `@Strum`, each with its own
// payload. When this bundle says `@Strum`, which payload does it mean?
//
// THE ANSWER: whichever one it NAMES. `*Author.Bundle.Publicator.@Strum` is one exact event, with
// that bundle's payload, and the compiler checks the fields you write against it. The three are three
// different events that share a word: emitting one never wakes a `hear` of another.
//
// What you should see:
//
//     [guitar] heard its own Strum: note E on fret 3
//     [band]   heard bob's Strum: course 2, roll=true
//     [banjo]  heard its own Strum: course 2, roll=true
//     [harp]   heard its own Strum: C in octave 4
//     [band]   heard bob's Strum: course 9, roll=false
//     [banjo]  heard its own Strum: course 9, roll=false
//
// Only the Banjo's Strums reach the band's `hear`, because that is the only one it named.
//
// See also samples/bundle_collisions: the same idea with two kits, and why it is safe.

bundle Band by you {

    // TWO PLAIN NEEDS: both put their bare names in scope, so a bare `@Strum` here would be
    // ambiguous between them (see the commented line in `Lead`).
    need "alice.Guitar"
    need "bob.Banjo"

    // ONE ALIASED NEED (RULES 18b): Harp is reached as `*H.…` and adds NO bare name, so it is never
    // part of the ambiguity at all.
    need "carol.Harp" as H
    need "Vein.Console"

    shard Lead {
        run once {
            // ── 1. THE FULL PATH: author, bundle, publicator, event ─────────────────────────────
            // Each one takes ITS OWN payload. Writing `course:` on the Guitar's Strum gets VS0227
            // ("@Strum has no field 'course' … It takes: note, fret"), and the value is dropped.
            emit *alice.Guitar.Api.@Strum { note: "E", fret: 3 }
            emit *bob.Banjo.Api.@Strum { course: 2, roll: true }

            // ── 2. THE ALIAS: `H` stands for `carol.Harp` ───────────────────────────────────────
            emit *H.Api.@Strum { pluck: "C", octave: 4 }

            // ── 3. UNCOMMENT TO SEE THE AMBIGUITY (VS0216, a warning) ──────────────────────────
            // Guitar and Banjo both give `@Strum` as a bare name. Which payload is this? The
            // compiler cannot know: it warns once, at this line, and this event reaches nobody.
            //
            // emit @Strum { note: "A", fret: 5 }

            // ── 4. A SHORTENED PATH: as few segments as stay unique ────────────────────────────
            // Only one bundle in scope is a Banjo, so `*Banjo.Api.@Strum` is bob's. (Until
            // 2026-10-26 this compiled cleanly and reached nobody.)
            emit *Banjo.Api.@Strum { course: 9, roll: false }

            // ── 5. UNCOMMENT TO SEE A PATH SHORTENED TOO FAR (VS0306, an error) ─────────────────
            // All three kits have an `Api.@Strum`, so this names none of them. The error lists the
            // three, ready to copy.
            //
            // emit *Api.@Strum { course: 1, roll: false }
        }

        // HEAR EXACTLY ONE OF THEM. The Guitar's and the Harp's Strums never land here.
        hear *bob.Banjo.Api.@Strum as s {
            do print("[band]   heard bob's Strum: course \(s.course), roll=\(s.roll)")
        }
    }
}
