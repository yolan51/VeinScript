//   NOT RUN ON ITS OWN — it is one bundle of samples/event_strum/event_strum.app.vein. Run that (open it and press ▶), or set it as the
//   Entry with the button at the top right, and ▶ runs the app from here.
// samples/event_strum/bundles/Banjo.vein — the second `@Strum`.
//
// The same word, the same publicator name (`Api`), and a DIFFERENT payload: a course number and
// whether it was a roll. Neither the word nor the publicator tells the three apart; the author and
// the bundle do: this one is `bob.Banjo.Strum`.

bundle Banjo by bob {
    need "Vein.Console"

    publicator Api {
        shared("A banjo course was strummed, or rolled.")
        event @Strum { course: int, roll: bool }
    }

    shard Player {
        hear @Strum as s {
            do print("[banjo]  heard its own Strum: course \(s.course), roll=\(s.roll)")
        }
    }
}
