// samples/web_app.vein — a FULL site: five routes, a real stylesheet, working JavaScript, and a form.
//
//   veinc serve samples/web_app.vein --port 8080
//   then open http://localhost:8080/
//
// This exists to stress the three channels together. A builder's OUTPUT FIELD decides which event it
// emits, and that is the whole mechanism:
//
//     markup = …   →  @Html      (the page)
//     css    = …   →  @Style     (the stylesheet)
//     code   = …   →  @Script    (the behaviour)
//
// Three streams, three accumulators on the ShardView, one document at the end. Nothing here writes a
// page; every shard contributes a fragment and the view decides where each kind lands — CSS in <head>,
// scripts before </body>.
//
// Two things the language makes you do differently from a template engine:
//   * a newline ENDS a statement, so a long string stays on ONE line — there is no `+` continuation;
//   * there is no `!=`; inequality is `not (a == b)`.
//
// Compare samples/web_site.vein, which is the same idea with three routes and no styling.

bundle WebApp by you {

    // One `use` reaches all three channels: Elements (markup), Styles (css) and Scripts (code) are
    // publicators of the same bundle, so &Heading, &Rule and &Define all resolve by bare name.
    use Web

    // ---- page furniture, which is this SITE and not the library ------------------------------------
    // These stay local on purpose: a hero and a card are design decisions, not vocabulary. The library
    // gives the channels and the primitives; what a page looks like belongs to the page.

    builder Nav     { markup = "<nav><a href=\"/\">home</a><a href=\"/docs\">docs</a><a href=\"/counter\">counter</a><a href=\"/greet\">greet</a><span style=\"margin-left:auto\" class=\"clock\" id=\"clk\"></span><button onclick=\"theme()\">theme</button></nav>" }
    builder Card    { title: string, body: string   markup = "<div class=\"card\"><h3>" + title + "</h3><p>" + body + "</p></div>" }
    builder Hero    { title: string, sub: string    markup = "<header class=\"hero\"><h1>" + title + "</h1><p>" + sub + "</p></header>" }
    builder Footer  { note: string                  markup = "<footer>" + note + "</footer>" }

    // ---- the stylesheet ----------------------------------------------------------------------------
    // Emitted on EVERY request, before any page decides what it contains. A 404 still collects the CSS
    // and still answers 404, because the view keys "is there a page" off the HTML, not off the styles.

    shard Styles {
        hear @Request as r {
            // Every colour is a custom property, and that is what makes the theme toggle one line of
            // CSS instead of a parallel dark rule for each element. `.dark` redefines the variables on
            // <html>; everything below reads them, so one class swap restyles the whole document.
            bring Rule(":root", "--bg:#f6f7f9;--fg:#151a21;--muted:#5f6b7a;--card:#fff;--line:#e4e8ee;--brand:#3b6ea5;--ink:#fff;--shadow:0 1px 2px rgba(16,24,40,.05),0 6px 16px rgba(16,24,40,.06)")
            bring Rule(".dark", "--bg:#0e1218;--fg:#e7ebf0;--muted:#94a2b3;--card:#161d26;--line:#242e3a;--brand:#5b9bd8;--ink:#0e1218;--shadow:0 1px 2px rgba(0,0,0,.5),0 8px 24px rgba(0,0,0,.4)")

            bring Rule("*", "box-sizing:border-box")
            bring Rule("html", "scroll-behavior:smooth")
            bring Rule("body", "margin:0;font:16px/1.65 ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:var(--fg);background:var(--bg);transition:background .25s ease,color .25s ease")

            bring Rule("nav", "display:flex;align-items:center;gap:1.5rem;padding:1rem 2rem;background:color-mix(in srgb,var(--bg) 80%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:10")
            bring Rule("nav a", "color:var(--muted);text-decoration:none;font-weight:550;font-size:.95rem;transition:color .15s ease")
            bring Rule("nav a:hover", "color:var(--brand)")

            bring Rule(".hero", "padding:5rem 2rem 4rem;text-align:center;background:radial-gradient(120% 100% at 50% 0%,color-mix(in srgb,var(--brand) 18%,transparent),transparent 70%)")
            bring Rule(".hero h1", "margin:0 0 .6rem;font-size:clamp(2rem,5vw,3.2rem);line-height:1.1;letter-spacing:-.03em;font-weight:800")
            bring Rule(".hero p", "margin:0 auto;max-width:34rem;color:var(--muted);font-size:1.15rem")

            bring Rule("main", "max-width:56rem;margin:0 auto;padding:3rem 2rem 4rem")
            bring Rule(".grid", "display:grid;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));gap:1.1rem")

            bring Rule(".card", "background:var(--card);border:1px solid var(--line);border-radius:.85rem;padding:1.4rem;box-shadow:var(--shadow);transition:transform .18s ease,border-color .18s ease")
            bring Rule(".card:hover", "transform:translateY(-3px);border-color:var(--brand)")
            bring Rule(".card h3", "margin:0 0 .45rem;font-size:1rem;font-weight:700;color:var(--brand)")
            bring Rule(".card p", "margin:0;color:var(--muted);font-size:.94rem")

            bring Rule("button", "background:var(--brand);color:var(--ink);border:0;border-radius:.55rem;padding:.65rem 1.2rem;font:inherit;font-weight:600;cursor:pointer;transition:filter .15s ease,transform .1s ease")
            bring Rule("button:hover", "filter:brightness(1.12)")
            bring Rule("button:active", "transform:translateY(1px)")
            bring Rule("input", "padding:.65rem .8rem;border:1px solid var(--line);border-radius:.55rem;font:inherit;background:var(--card);color:var(--fg);min-width:14rem")
            bring Rule("input:focus", "outline:2px solid var(--brand);outline-offset:1px")

            bring Rule("ul", "padding-left:1.2rem;color:var(--muted)")
            bring Rule("li", "margin:.4rem 0")
            bring Rule("a", "color:var(--brand)")
            bring Rule("footer", "padding:2.5rem;text-align:center;color:var(--muted);font-size:.88rem;border-top:1px solid var(--line)")

            bring Rule(".count", "font-size:4rem;font-weight:800;letter-spacing:-.04em;color:var(--brand);margin:1.5rem 0;font-variant-numeric:tabular-nums")
            bring Rule(".row", "display:flex;gap:.6rem;flex-wrap:wrap;align-items:center")
            bring Rule(".clock", "font-variant-numeric:tabular-nums;color:var(--muted);font-size:.9rem")

            // A raw fragment for what a selector+declaration pair cannot express. Same channel, same
            // accumulator — this is why &Css exists beside &Rule.
            bring Css("@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto}}")
        }
    }

    // ---- behaviour that belongs to every page --------------------------------------------------------
    // The nav is on every page, so the theme toggle and the clock it contains have to be too. Same
    // shape as Styles: emitted on every request, before any route decides what the page contains.

    shard Behaviour {
        hear @Request as r {
            // Persisted, or the theme resets on every navigation — which on a multi-page site means it
            // never appears to work at all.
            bring Define("theme", "var d=document.documentElement.classList.toggle('dark');try{localStorage.setItem('theme',d?'dark':'light')}catch(e){}")
            bring Define("tick", "var e=document.getElementById('clk');if(e)e.innerText=new Date().toLocaleTimeString()")

            // &Js is the raw-script counterpart of &Css: this runs on load rather than defining
            // anything, restoring the saved theme before the first paint and starting the clock.
            bring Js("try{if(localStorage.getItem('theme')==='dark')document.documentElement.classList.add('dark')}catch(e){}tick();setInterval(tick,1000);")
        }
    }

    // ---- pages -------------------------------------------------------------------------------------

    shard Home {
        hear @Request as r {
            if r.path == "/" {
                bring Nav()
                bring Hero("VeinScript", "A website assembled entirely from events.")
                bring Raw("<main><div class=\"grid\">")
                bring Card("Shapes", "Data lives in $Shape — identity components with folds.")
                bring Card("Shards", "Behaviour reacts: hear an event, emit more.")
                bring Card("Builders", "A builder's output field picks its channel: markup, css or code.")
                bring Card("One page", "These four cards are four separate @Html fragments.")
                bring Raw("</div></main>")
                bring Footer("Served by veinc serve")
            }
        }
    }

    shard Docs {
        hear @Request as r {
            if r.path == "/docs" {
                bring Nav()
                bring Hero("Docs", "The three channels, and what reaches them.")
                bring Raw("<main><ul>")
                bring ListItem("markup = … emits @Html, and lands in the body")
                bring ListItem("css = … emits @Style, and lands in a &lt;style&gt; in the head")
                bring ListItem("code = … emits @Script, and lands before &lt;/body&gt;")
                bring ListItem("@Render fires after every fragment, so the view sees a complete page")
                bring Raw("</ul>")
                bring Link("/", "back home")
                bring Raw("</main>")
                bring Footer("Every list item above is its own event")
            }
        }
    }

    // ---- JavaScript, which is where the third channel earns its place -------------------------------

    shard Counter {
        hear @Request as r {
            if r.path == "/counter" {
                bring Nav()
                bring Hero("Counter", "The page reacts in the browser, not on the server.")
                bring Raw("<main>")
                bring Raw("<div class=\"count\" id=\"n\">0</div>")
                bring Raw("<div class=\"row\"><button onclick=\"inc()\">+1</button><button onclick=\"dec()\">-1</button><button onclick=\"reset()\">reset</button></div>")
                bring JumpLine()
                bring JumpLine()
                bring Link("/", "back home")
                bring Raw("</main>")

                // Each function is a fragment on the @Script channel — same shape as a CSS rule or a
                // paragraph, just a different output field.
                bring Define("inc", "var e=document.getElementById('n');e.innerText=(+e.innerText)+1")
                bring Define("dec", "var e=document.getElementById('n');e.innerText=(+e.innerText)-1")
                bring Define("reset", "document.getElementById('n').innerText='0'")
                bring Footer("Three functions, three @Script fragments")
            }
        }
    }

    // ---- a form: the part a path alone cannot express -----------------------------------------------

    shard Greet {
        hear @Request as r {
            if r.path == "/greet" {
                bring Nav()

                if r.method == "GET" {
                    bring Hero("Greet", "A form, posted back to the same path.")
                    bring Raw("<main>")
                    // &Form is self-contained because one fragment cannot wrap others: it carries its
                    // own input and submit. Anything richer than a single field is &Raw.
                    bring Form("/greet", "who", "send")
                    bring Raw("</main>")
                }

                if r.method == "POST" {
                    // `who` came from the form body. It is an ordinary payload field by the time it
                    // reaches here — the same place a query string would have put it.
                    bring Hero("Hello " + r.who, "Received by POST.")
                    bring Raw("<main>")
                    bring Card("method", r.method)
                    bring Card("raw body", r.body)
                    bring Link("/greet", "again")
                    bring Raw("</main>")
                }

                bring Footer("method and body arrive on @Request")
            }
        }
    }

    // ---- assembly ------------------------------------------------------------------------------------

    // The trigger has to be a separate event. `bring` QUEUES a fragment event rather than writing
    // anything, and the queue does not drain until every @Request handler has finished — so a view that
    // answered on @Request would always see an empty page. @Render queues behind the fragments.
    shard Kernel {
        hear @Request as r { emit @Render { path: r.path } }
    }

    ShardView Page {
        var html: string
        var css: string
        var js: string

        hear @Html as f   { html += f.markup }
        hear @Style as s  { css += s.css }
        hear @Script as c { js += c.code }

        hear @Render as v {
            // No HTML means no route matched, so stay silent and let serve answer 404. The stylesheet
            // arrived regardless, which is exactly why the check is on `html` and not on the page.
            if not (html == "") {
                emit @Response { status: 200, body: "<!doctype html><html><head><meta charset=\"utf-8\"><title>VeinScript</title><style>" + css + "</style></head><body>" + html + "<script>" + js + "</script></body></html>" }
            }
        }
    }
}
