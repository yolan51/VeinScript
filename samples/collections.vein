// samples/collections.vein — `~` collections: many of something, as a field (D24). The short tour.
//     veinc run samples/collections.vein
//
// `~` in front of a field makes it a COLLECTION, with its kind and its element type declared:
//
//     ~<list> exits: $Room             ordered, repeats allowed
//     ~<set>  members: $Person         each value once, in the order added
//     ~<ring 3> lines: string          only the last 3 — the oldest drops off
//     ~<map>  scores: string | int     a value per key
//
// Elements are int, float, string, bool, Entity — or `$Shape`: identities that carry that shape. The
// compiler checks every literal that goes in. `bring Guild("Owls", [ann, bob])` fills one, as any field is
// filled; a loom weaves one; an event can carry one.
//
// Going further:  collections_values.vein   (int, float, string, bool, and maps of them)
//                 collections_shapes.vein   ($Shape elements, links versus `owns`, identity keys)
//
// THREE THINGS TO SEE:
//
//   1. THE `~` IS WHERE YOU SEE IT. A collection is read as `g.Guild.~members` — a plain `.members` is an
//      error (VS0373) — so a reader always knows a value is many.
//   2. WALKS ARE FLAT. `target $Room.~exits as r, x` is ONE loop over every (room, exit), and `x.Room.name`
//      reads the exit's own data directly: no inner lookup loop. A map walks its pairs: `e.key`, `e.value`.
//   3. CHANGES LAND AT THE COMMIT, like `attach` and `mark`: `.add(…)`, `.remove(…)`, `.clear()`, `.put(k, v)`.
//      Two shards adding to one guild in the same event BOTH land — a collection merges, where a plain field
//      would fight over one slot. A destroyed identity leaves every collection that named it.
//
// Expected output:
//
//     Hall -> Cellar
//     Hall -> Tower
//     Cellar -> Hall
//     Owls: Ann
//     Owls: Bob
//     Owls: Cy
//     Owls: Dee
//     Cy is an Owl: true
//     chat: c d e
//     ann = 3
//     bob = 5
//     Owls after Bob left: Ann Cy Dee
//     Owls after Cy is gone: Ann Dee
//     chat after clear: 0 lines

bundle Collections by you {

    need "Vein.Console"

    shape $Room   { name: string, ~<list> exits: $Room }
    shape $Person { name: string }
    shape $Guild  { name: string, ~<set> members: $Person }
    shape $Chat   { ~<ring 3> lines: string }
    shape $Board  { name: string, ~<map> scores: string | int }

    mark #Room
    mark #Person
    mark #Guild
    mark #Chat

    builder Room   { $Room    mark #Room }
    builder Person { $Person  mark #Person }
    builder Guild  { $Guild   mark #Guild }
    builder Chat   { $Chat    mark #Chat }
    builder Board  { $Board   mark #Chat }

    event @Recruit { }
    event @Show { }
    event @Leave { }
    event @Gone { }

    shard World {
        run once {
            bring Room("Hall", []) as hall
            bring Room("Cellar", [hall]) as cellar
            bring Room("Tower", []) as tower
            bring Person("Ann") as ann
            bring Person("Bob") as bob
            bring Person("Cy") as cy
            bring Person("Dee") as dee
            bring Guild("Owls", [ann, bob, ann]) as owls          // a set: Ann once
            bring Chat([]) as chat
            bring Board("Arena") as board                          // a map starts empty: no argument
            board.Board.~scores.put("ann", 3)
            board.Board.~scores.put("bob", 5)

            // bring Guild("Bad", [1])        ← VS0371: Guild.~members holds identities, and `1` is a value

            emit @Recruit { }
        }

        // Hall's exits were written before the other rooms existed; add them now.
        hear @Recruit as r {
            target $Room as room {
                if room.Room.name == "Hall" {
                    target $Room as other { if not (other == room) { room.Room.~exits.add(other) } }
                }
            }
            target $Chat as c { c.Chat.~lines.add("a", "b", "c", "d", "e") }   // a ring of 3: c d e stay
            emit @Show { }
        }

        hear @Show as s {
            target $Room.~exits as r, x { do print(r.Room.name + " -> " + x.Room.name) }      // one flat loop
            target $Guild.~members as g, m { do print(g.Guild.name + ": " + m.Person.name) }  // one line per member
        }
    }

    // TWO SHARDS ADD TO ONE GUILD IN THE SAME EVENT — and both land.
    shard RecruiterA {
        hear @Recruit as r {
            target $Guild as g { target $Person as p { if p.Person.name == "Cy" { g.Guild.~members.add(p) } } }
        }
    }
    shard RecruiterB {
        hear @Recruit as r {
            target $Guild as g { target $Person as p { if p.Person.name == "Dee" { g.Guild.~members.add(p) } } }
        }
        hear @Show as s {
            target $Guild as g {
                target $Person as p { if p.Person.name == "Cy" { do print("Cy is an Owl: " + g.Guild.~members.has(p)) } }
                target $Person as p { if p.Person.name == "Bob" { g.Guild.~members.remove(p) } }
            }
            target $Chat as c { do print("chat: " + join(c.Chat.~lines, " ")) }
            target $Board.~scores as b, e { do print(e.key + " = " + e.value) }
            emit @Leave { }
        }
        hear @Leave as l {
            target $Guild as g { do print("Owls after Bob left: " + names(g)) }
            target $Person as p { if p.Person.name == "Cy" { destroy p } }
            target $Chat as c { c.Chat.~lines.clear() }
            emit @Gone { }
        }
        hear @Gone as gone {
            target $Guild as g { do print("Owls after Cy is gone: " + names(g)) }
            target $Chat as c { do print("chat after clear: " + len(c.Chat.~lines) + " lines") }
        }
    }

    // The members' names on one line — joined into one string, so ONE print.
    fn names(g: Entity) return string {
        var all = ""
        target g.Guild.~members as m {
            if not (all == "") { all = all + " " }
            all = all + m.Person.name
        }
        return all
    }
}
