}

shard Reference {
    hear @Request as r {
        if r.path == "/docs" {
            bring Nav()
            bring Hero("Language Reference", "Every keyword, shape and event, as one page.")
            bring Open("main")
                bring Open("article")

                bring Raw("<div class='callout'>" +
                          "<strong>A snapshot, reproduced unchanged.</strong> Generated 2026-08-29 " +
                          "and transcribed verbatim. Parts have since drifted from the language: " +
                          "several examples close blocks with " +
                          "<code class='inline-code'>end</code>, which is not a keyword &mdash; " +
                          "blocks use braces. The runtime section describes " +
                          "<code class='inline-code'>push</code> buffers, which were removed. " +
                          "<code class='inline-code'>@Request</code> now also carries " +
                          "<code class='inline-code'>method</code> and " +
                          "<code class='inline-code'>body</code>. For what the compiler actually " +
                          "accepts, read stdlib/ and docs/LANGUAGE.md.</div>")

                // Contents — a QUERY, not a list. Nothing below is written twice: add a `$Section`
                // and it appears here, in spawn order, with its anchor. The body of the page cannot
                // work this way (see `shape $Section` in web_app.vein), but its index can.
                bring Subheading("Contents")
                bring Open("ul")
                    target $Section #Doc as self {
                        bring Open("li")
                            bring Link("#sec" + self.Section.ord, self.Section.title)
                        bring Close("li")
                    }
                bring Close("ul")

            bring Heading("VeinScript Language Reference")
            bring Paragraph("*Auto-compiled from 28 source files and discussion history.*")
            bring Raw("<span id='sec1'></span>")
            bring Subheading("File: console_chat.vein")
            bring Paragraph("This reference documentation describes the <code class=\"inline-code\">console_chat.vein</code> " +
                            "source file, which demonstrates inter-process communication between multiple console " +
                            "applications using the VeinScript standard library. The file illustrates how to spawn named " +
                            "console windows and route messages between them via process-boundary events.")
            bring Subsubheading("bundle")
            bring Paragraph("<strong>Signature:</strong> <code class=\"inline-code\">bundle &lt;Name&gt; by &lt;Author&gt; { " +
                            "... }</code>")
            bring Paragraph("The <code class=\"inline-code\">bundle</code> keyword defines the top-level container for the " +
                            "application code. It serves as a namespace and deployment unit for all contained shards and " +
                            "events. In this file, it encapsulates the messaging logic and the application's entry point.")
            bring CodeBlock("bundle ConsoleChat by you {\n" +
                            "    // Shards and events are defined within this scope.\n" +
                            "}")
            bring Subsubheading("start")
            bring Paragraph("<strong>Signature:</strong> <code class=\"inline-code\">start @&lt;FlowName&gt; { }</code>")
            bring Paragraph("The <code class=\"inline-code\">start</code> keyword declares a system-level flow that the runtime " +
                            "executes upon initialization. It identifies which event triggers the start of the application's " +
                            "lifecycle. In this file, it links the execution start to the <code " +
                            "class=\"inline-code\">@Boot</code> event.")
            bring CodeBlock("start @Boot { }")
            bring Subsubheading("event")
            bring Paragraph("<strong>Signature:</strong> <code class=\"inline-code\">event @&lt;EventName&gt; { }</code>")
            bring Paragraph("The <code class=\"inline-code\">event</code> keyword defines a signal that can be emitted or heard " +
                            "within the bundle. Local events are declared without a namespace, while system events are fully " +
                            "qualified. This file defines a local <code class=\"inline-code\">@Boot</code> event to trigger " +
                            "initial process spawning.")
            bring CodeBlock("event @Boot { }")
            bring Subsubheading("shard")
            bring Paragraph("<strong>Signature:</strong> <code class=\"inline-code\">shard &lt;ShardName&gt; { ... }</code>")
            bring Paragraph("A <code class=\"inline-code\">shard</code> is a logic container that groups related event " +
                            "listeners (<code class=\"inline-code\">hear</code> blocks). Shards allow for modularity within a " +
                            "bundle, separating concerns like initialization logic from ongoing message handling logic.")
            bring CodeBlock("shard Launcher {\n" +
                            "    // Hear blocks for initialization\n" +
                            "}\n" +
                            "\n" +
                            "shard Chat {\n" +
                            "    // Hear blocks for messaging\n" +
                            "}")
            bring Subsubheading("hear")
            bring Paragraph("<strong>Signature:</strong> <code class=\"inline-code\">hear &lt;Event&gt; as &lt;Alias&gt; { ... " +
                            "}</code>")
            bring Paragraph("The <code class=\"inline-code\">hear</code> keyword creates a reactive listener for a specific " +
                            "event. When the event is emitted, the code block is executed. The <code " +
                            "class=\"inline-code\">as</code> keyword assigns the event's data payload to a local variable " +
                            "(alias) for use inside the block.")
            bring CodeBlock("hear *Vein.Console.Io.@Input as i {\n" +
                            "    emit *Vein.Console.Io.@Send { to: #Server,  text: i.text }\n" +
                            "}")
            bring Subsubheading("emit")
            bring Paragraph("<strong>Signature:</strong> <code class=\"inline-code\">emit &lt;Event&gt; { &lt;Property&gt;: " +
                            "&lt;Value&gt; }</code>")
            bring Paragraph("The <code class=\"inline-code\">emit</code> keyword triggers an event and passes a data structure " +
                            "to any listeners. In this file, it is used to call standard library functions for printing text, " +
                            "spawning consoles, and sending data across named pipes to other processes.")
            bring CodeBlock("emit *Vein.Console.Io.@Print { text: &quot;Main — type here; it goes to Server.&quot; }")
            bring Subsubheading("*Vein.Console.Io.@Console")
            bring Paragraph("<strong>Signature:</strong> <code class=\"inline-code\">emit *Vein.Console.Io.@Console { name: " +
                            "#&lt;Identifier&gt;, firsttext: &quot;&lt;String&gt;&quot; }</code>")
            bring Paragraph("This standard library event spawns a new, independent console window. The <code " +
                            "class=\"inline-code\">name</code> property uses a hash identifier to name the process, and <code " +
                            "class=\"inline-code\">firsttext</code> provides the initial string displayed in that new window.")
            bring CodeBlock("emit *Vein.Console.Io.@Console { name: #Server,  firsttext: &quot;Server ready — messages appear here.&quot; }\n" +
                            "emit *Vein.Console.Io.@Console { name: #Client1, firsttext: &quot;Client1 ready — type to message Server.&quot; }")
            bring Subsubheading("*Vein.Console.Io.@Print")
            bring Paragraph("<strong>Signature:</strong> <code class=\"inline-code\">emit *Vein.Console.Io.@Print { text: " +
                            "&quot;&lt;String&gt;&quot; }</code>")
            bring Paragraph("This standard library event outputs a string of text to the current console window. It is the " +
                            "primary method for displaying information to the user within the active process.")
            bring CodeBlock("emit *Vein.Console.Io.@Print { text: &quot;Main — type here; it goes to Server.&quot; }")
            bring Subsubheading("*Vein.Console.Io.@Input")
            bring Paragraph("<strong>Signature:</strong> <code class=\"inline-code\">hear *Vein.Console.Io.@Input as " +
                            "&lt;Alias&gt;</code>")
            bring Paragraph("This standard library event is triggered whenever a user types a line of text and presses Enter " +
                            "in the current console window. The captured text is available via the <code " +
                            "class=\"inline-code\">.text</code> property of the event alias.")
            bring CodeBlock("hear *Vein.Console.Io.@Input as i {\n" +
                            "    emit *Vein.Console.Io.@Send { to: #Server,  text: i.text }\n" +
                            "}")
            bring Subsubheading("*Vein.Console.Io.@Send")
            bring Paragraph("<strong>Signature:</strong> <code class=\"inline-code\">emit *Vein.Console.Io.@Send { to: " +
                            "#&lt;Identifier&gt;, text: &quot;&lt;String&gt;&quot; }</code>")
            bring Paragraph("This standard library event facilitates inter-process communication. It sends a text payload to " +
                            "a specific named console (identified by the <code class=\"inline-code\">to</code> property). This " +
                            "allows one shard in one process to trigger logic in a different process.")
            bring CodeBlock("emit *Vein.Console.Io.@Send { to: #Server,  text: i.text }\n" +
                            "emit *Vein.Console.Io.@Send { to: #Client4, text: i.text }")
            bring Subsubheading("*Vein.Console.Io.@Message")
            bring Paragraph("<strong>Signature:</strong> <code class=\"inline-code\">hear *Vein.Console.Io.@Message as " +
                            "&lt;Alias&gt;</code>")
            bring Paragraph("This standard library event is triggered when a process receives a transmission sent via <code " +
                            "class=\"inline-code\">@Send</code>. The event payload contains a <code " +
                            "class=\"inline-code\">.from</code> property (the identifier of the sender) and a <code " +
                            "class=\"inline-code\">.text</code> property (the message content).")
            bring CodeBlock("hear *Vein.Console.Io.@Message as m {\n" +
                            "    emit *Vein.Console.Io.@Print { text: m.from + &quot; says: &quot; + m.text }\n" +
                            "}")
            bring Subsubheading("Property Access and Concatenation")
            bring Paragraph("<strong>Signature:</strong> <code class=\"inline-code\">&lt;Alias&gt;.&lt;Property&gt;</code> and " +
                            "<code class=\"inline-code\">&lt;String&gt; + &lt;String&gt;</code>")
            bring Paragraph("VeinScript allows accessing data fields on event payloads using dot notation. Strings can be " +
                            "joined using the <code class=\"inline-code\">+</code> operator. This is demonstrated by formatting " +
                            "incoming messages for display.")
            bring CodeBlock("emit *Vein.Console.Io.@Print { text: m.from + &quot; says: &quot; + m.text }")
            bring Raw("<span id='sec2'></span>")
            bring Subheading("File: console_builder.vein")
            bring Paragraph("This reference page documents the constructs and syntax demonstrated in <code " +
                            "class=\"inline-code\">console_builder.vein</code>, which serves as a demonstration of cross-bundle " +
                            "Builder resolution using the <code class=\"inline-code\">&amp;</code> sigil. The file specifically " +
                            "highlights how to invoke standard library builders to spawn environment-level resources like " +
                            "console windows during a boot sequence.")
            bring Subsubheading("bundle")
            bring Open("ul")
                bring ListItem("<strong>Syntax</strong>: <code class=\"inline-code\">bundle [BundleName] by [Author] { ... " +
                               "}</code>")
                bring ListItem("<strong>Description</strong>: The <code class=\"inline-code\">bundle</code> keyword defines the " +
                               "highest level of code organization in VeinScript. It encapsulates all shards, events, and logic " +
                               "within a named namespace and attributes ownership to a specific author or entity. In this file, " +
                               "it establishes the <code class=\"inline-code\">ConsoleBuilderDemo</code> scope.")
                bring ListItem("<strong>Example</strong>:")
            bring Close("ul")
            bring CodeBlock("bundle ConsoleBuilderDemo by you {\n" +
                            "    // Bundle contents reside here\n" +
                            "}")
            bring Subsubheading("start")
            bring Open("ul")
                bring ListItem("<strong>Syntax</strong>: <code class=\"inline-code\">start @[EventName] { }</code>")
                bring ListItem("<strong>Description</strong>: The <code class=\"inline-code\">start</code> keyword designates the " +
                               "entry point for the bundle's execution. It specifies which event trigger the Vein Runtime should " +
                               "fire immediately upon loading the bundle. In this specific file, the <code " +
                               "class=\"inline-code\">start</code> block initializes the <code class=\"inline-code\">@Boot</code> " +
                               "lifecycle event.")
                bring ListItem("<strong>Example</strong>:")
            bring Close("ul")
            bring CodeBlock("bundle ConsoleBuilderDemo by you {\n" +
                            "    start @Boot { }\n" +
                            "}")
            bring Subsubheading("event")
            bring Open("ul")
                bring ListItem("<strong>Syntax</strong>: <code class=\"inline-code\">event @[EventName] { }</code>")
                bring ListItem("<strong>Description</strong>: The <code class=\"inline-code\">event</code> keyword defines a " +
                               "signal or a lifecycle hook that can be listened to by shards. Events are prefixed with the <code " +
                               "class=\"inline-code\">@</code> sigil. Defining the event here ensures that the <code " +
                               "class=\"inline-code\">Launcher</code> shard has a valid handle to react to during the system " +
                               "initialization phase.")
                bring ListItem("<strong>Example</strong>:")
            bring Close("ul")
            bring CodeBlock("bundle ConsoleBuilderDemo by you {\n" +
                            "    event @Boot { }\n" +
                            "}")
            bring Subsubheading("shard")
            bring Open("ul")
                bring ListItem("<strong>Syntax</strong>: <code class=\"inline-code\">shard [ShardName] { ... }</code>")
                bring ListItem("<strong>Description</strong>: A <code class=\"inline-code\">shard</code> is a fundamental unit of " +
                               "logic and state in VeinScript. Shards act as reactive containers that contain event listeners " +
                               "(<code class=\"inline-code\">hear</code> blocks) and maintain the behaviors of the system. The " +
                               "<code class=\"inline-code\">Launcher</code> shard in this file is responsible for executing the " +
                               "builder calls when the boot event occurs.")
                bring ListItem("<strong>Example</strong>:")
            bring Close("ul")
            bring CodeBlock("shard Launcher {\n" +
                            "    hear @Boot as b {\n" +
                            "        // Logic for launching consoles\n" +
                            "    }\n" +
                            "}")
            bring Subsubheading("hear")
            bring Open("ul")
                bring ListItem("<strong>Syntax</strong>: <code class=\"inline-code\">hear @[EventName] as [Alias] { ... }</code>")
                bring ListItem("<strong>Description</strong>: The <code class=\"inline-code\">hear</code> keyword defines an event " +
                               "handler within a shard. It listens for the specified event (e.g., <code " +
                               "class=\"inline-code\">@Boot</code>) and provides an alias (e.g., <code " +
                               "class=\"inline-code\">b</code>) to access event data. The code block following the <code " +
                               "class=\"inline-code\">hear</code> declaration executes as soon as the event is triggered by the " +
                               "runtime.")
                bring ListItem("<strong>Example</strong>:")
            bring Close("ul")
            bring CodeBlock("shard Launcher {\n" +
                            "    hear @Boot as b {\n" +
                            "        bring *Vein.Console.Io.&amp;Console(#Server,  &quot;Server ready.&quot;)\n" +
                            "        bring *Vein.Console.Io.&amp;Console(#Client1, &quot;Client 1 ready.&quot;)\n" +
                            "    }\n" +
                            "}")
            bring Subsubheading("bring (Builder Sigil &amp;)")
            bring Open("ul")
                bring ListItem("<strong>Syntax</strong>: <code class=\"inline-code\">bring " +
                               "*[Namespace].&amp;[BuilderName]([Arguments])</code>")
                bring ListItem("<strong>Description</strong>: The <code class=\"inline-code\">bring</code> keyword, when combined " +
                               "with the <code class=\"inline-code\">&amp;</code> sigil, invokes a Builder. A Builder is a special " +
                               "construct that lowers to an <code class=\"inline-code\">emit</code> instruction, typically used " +
                               "for cross-bundle resource allocation. The <code class=\"inline-code\">&amp;</code> sigil " +
                               "identifies the target as a builder rather than a standard event or shape. In this file, it " +
                               "resolves the standard library <code class=\"inline-code\">Console</code> builder to spawn two " +
                               "named console windows: one for a server and one for a client.")
                bring ListItem("<strong>Example</strong>:")
            bring Close("ul")
            bring CodeBlock("bring *Vein.Console.Io.&amp;Console(#Server,  &quot;Server ready.&quot;)\n" +
                            "bring *Vein.Console.Io.&amp;Console(#Client1, &quot;Client 1 ready.&quot;)")
            bring Subsubheading("Mark (#)")
            bring Open("ul")
                bring ListItem("<strong>Syntax</strong>: <code class=\"inline-code\">#[Identifier]</code>")
                bring ListItem("<strong>Description</strong>: The <code class=\"inline-code\">#</code> sigil denotes a Mark, which " +
                               "is a unique symbolic constant or label used to identify specific instances or resources within " +
                               "the runtime. Unlike strings, Marks are often treated as distinct tokens by the compiler and " +
                               "runtime. Here, <code class=\"inline-code\">#Server</code> and <code " +
                               "class=\"inline-code\">#Client1</code> are used as unique identifiers for the spawned console " +
                               "windows.")
                bring ListItem("<strong>Example</strong>:")
            bring Close("ul")
            bring CodeBlock("bring *Vein.Console.Io.&amp;Console(#Server,  &quot;Server ready.&quot;)")
            bring Subsubheading("Qualified Path (*)")
            bring Open("ul")
                bring ListItem("<strong>Syntax</strong>: <code class=\"inline-code\">*[Path]</code>")
                bring ListItem("<strong>Description</strong>: The <code class=\"inline-code\">*</code> sigil indicates a qualified " +
                               "path resolution that looks outside the current bundle, typically into the standard library or " +
                               "linked dependencies. It tells the compiler to resolve the identifier (like <code " +
                               "class=\"inline-code\">Vein.Console.Io</code>) globally.")
                bring ListItem("<strong>Example</strong>:")
            bring Close("ul")
            bring CodeBlock("bring *Vein.Console.Io.&amp;Console(#Server,  &quot;Server ready.&quot;)")
            bring Raw("<span id='sec3'></span>")
            bring Subheading("File: console.vein")
            bring Paragraph("The <code class=\"inline-code\">console.vein</code> file demonstrates a standard interactive " +
                            "console application. It serves as a reference for handling standard input/output (I/O) using the " +
                            "VeinScript standard library events. The program prompts the user for input and echoes that input " +
                            "back to the terminal until an end-of-file (EOF) signal is received.")
            bring Subsubheading("Bundle Definition (<code class=\"inline-code\">bundle</code>)")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">bundle Name { ... }</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">bundle</code> is the primary unit of " +
                               "encapsulation in VeinScript. It organizes related events, shards, and entry points into a single " +
                               "deployable package. In this file, the <code class=\"inline-code\">App</code> bundle contains the " +
                               "logic for the console interaction.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("bundle App {\n" +
                            "    start @Boot { }\n" +
                            "    event @Boot { }\n" +
                            "    shard Main {\n" +
                            "        hear @Boot as b {\n" +
                            "            emit *Vein.Console.Io.@Print { text: &quot;Type something (Ctrl+Z / Ctrl+D to end):&quot; }\n" +
                            "        }\n" +
                            "        hear *Vein.Console.Io.@Input as i {\n" +
                            "            emit *Vein.Console.Io.@Print { text: &quot;you said &quot; + i.text }\n" +
                            "        }\n" +
                            "    }\n" +
                            "}")
            bring Subsubheading("Entry Point Declaration (<code class=\"inline-code\">start</code>)")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">start @EventName { }</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">start</code> keyword designates the " +
                               "initial entry point for the bundle. It tells the VeinScript runtime which event should be fired " +
                               "automatically when the program begins execution.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("start @Boot { }")
            bring Subsubheading("Event Definition (<code class=\"inline-code\">event</code>)")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">event @EventName { }</code>")
                bring ListItem("<strong>Description:</strong> Defines a custom event structure within the bundle. While this " +
                               "specific definition is empty, it establishes the <code class=\"inline-code\">@Boot</code> " +
                               "identifier as a valid event type that can be heard or emitted within the <code " +
                               "class=\"inline-code\">App</code> bundle scope.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("event @Boot { }")
            bring Subsubheading("Shard Definition (<code class=\"inline-code\">shard</code>)")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">shard Name { ... }</code>")
                bring ListItem("<strong>Description:</strong> A <code class=\"inline-code\">shard</code> is a logical component " +
                               "within a bundle that contains event handlers. Shards maintain the active logic of the " +
                               "application, responding to events as they are emitted by the runtime or other parts of the " +
                               "script.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("shard Main {\n" +
                            "    hear @Boot as b {\n" +
                            "        emit *Vein.Console.Io.@Print { text: &quot;Type something (Ctrl+Z / Ctrl+D to end):&quot; }\n" +
                            "    }\n" +
                            "    hear *Vein.Console.Io.@Input as i {\n" +
                            "        emit *Vein.Console.Io.@Print { text: &quot;you said &quot; + i.text }\n" +
                            "    }\n" +
                            "}")
            bring Subsubheading("Event Listener (<code class=\"inline-code\">hear</code>)")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">hear @EventName as identifier { ... " +
                               "}</code> or <code class=\"inline-code\">hear *Namespace.@EventName as identifier { ... }</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">hear</code> construct creates a " +
                               "reactive block that executes whenever a specific event is emitted. The <code " +
                               "class=\"inline-code\">as</code> keyword binds the incoming event's data payload to a local " +
                               "variable (an identifier), allowing the block to access the event's properties.")
                bring ListItem("<strong>Example (Internal Event):</strong>")
            bring Close("ul")
            bring CodeBlock("hear @Boot as b {\n" +
                            "    emit *Vein.Console.Io.@Print { text: &quot;Type something (Ctrl+Z / Ctrl+D to end):&quot; }\n" +
                            "}")
            bring Open("ul")
                bring ListItem("<strong>Example (External Event):</strong>")
            bring Close("ul")
            bring CodeBlock("hear *Vein.Console.Io.@Input as i {\n" +
                            "    emit *Vein.Console.Io.@Print { text: &quot;you said &quot; + i.text }\n" +
                            "}")
            bring Subsubheading("Event Emission (<code class=\"inline-code\">emit</code>)")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">emit *Path.@EventName { field: value " +
                               "}</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">emit</code> keyword sends an event " +
                               "to a target. In this file, it is used to communicate with the runtime's console system by " +
                               "emitting the <code class=\"inline-code\">@Print</code> event defined in the standard library. The " +
                               "data is passed as an anonymous object containing the necessary fields, such as <code " +
                               "class=\"inline-code\">text</code>.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("emit *Vein.Console.Io.@Print { text: &quot;you said &quot; + i.text }")
            bring Subsubheading("Namespaced Event Reference (<code class=\"inline-code\">*</code>)")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">*Namespace.Path.@EventName</code>")
                bring ListItem("<strong>Description:</strong> The asterisk prefix indicates a reference to a global or standard " +
                               "library namespace rather than a local event. This allows the script to trigger or listen to " +
                               "functionality provided by the VeinScript runtime, such as <code " +
                               "class=\"inline-code\">Vein.Console.Io</code>.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("*Vein.Console.Io.@Print")
            bring Subsubheading("String Concatenation (<code class=\"inline-code\">+</code>)")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">string + string</code>")
                bring ListItem("<strong>Description:</strong> The plus operator is used to join two string values together. In " +
                               "this file, it combines a literal string &quot;you said &quot; with the <code " +
                               "class=\"inline-code\">text</code> property found on the incoming <code " +
                               "class=\"inline-code\">@Input</code> event payload.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("&quot;you said &quot; + i.text")
            bring Subsubheading("Input Event Data Access")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">i.text</code>")
                bring ListItem("<strong>Description:</strong> When hearing the <code " +
                               "class=\"inline-code\">*Vein.Console.Io.@Input</code> event, the payload is bound to the variable " +
                               "<code class=\"inline-code\">i</code>. The <code class=\"inline-code\">text</code> property of this " +
                               "object contains the string content entered by the user in the terminal.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("hear *Vein.Console.Io.@Input as i {\n" +
                            "    emit *Vein.Console.Io.@Print { text: &quot;you said &quot; + i.text }\n" +
                            "}")
            bring Raw("<span id='sec4'></span>")
            bring Subheading("File: Web.vein")
            bring Paragraph("The <code class=\"inline-code\">Web.vein</code> file defines the <code " +
                            "class=\"inline-code\">Vein.Web</code> namespace within the standard library. It serves as the " +
                            "primary domain for web-related operations, encompassing HTTP event structures and reusable HTML " +
                            "builders. This file is architectural and vocabulary-focused; it does not contain shard logic, " +
                            "but rather provides the public interface used by developers to construct reactive web pages and " +
                            "handle HTTP lifecycle events.")
            bring Subsubheading("Bundle: Web")
            bring Paragraph("The <code class=\"inline-code\">bundle</code> keyword defines a logical grouping of related " +
                            "functionality under a specific authorship. In this file, the <code " +
                            "class=\"inline-code\">Web</code> bundle is authored <code class=\"inline-code\">by Vein</code>, " +
                            "establishing the root namespace <code class=\"inline-code\">Vein.Web</code>. All publicators " +
                            "within this bundle are reachable via this qualified path.")
            bring CodeBlock("bundle Web by Vein {\n" +
                            "    // Contents of the Web bundle\n" +
                            "}")
            bring Subsubheading("Publicator: Http")
            bring Paragraph("A <code class=\"inline-code\">publicator</code> acts as a container for public API members that " +
                            "can be accessed by other shards or scripts. The <code class=\"inline-code\">Http</code> publicator " +
                            "defines the events necessary for a reactive web request-response lifecycle. These events allow " +
                            "different shards to contribute fragments of a page before final assembly.")
            bring CodeBlock("publicator Http {\n" +
                            "    shared(&quot;An inbound HTTP request.&quot;)\n" +
                            "    event @Request { path: string }\n" +
                            "\n" +
                            "    shared(&quot;A fragment of HTML contributed by some shard.&quot;)\n" +
                            "    event @Html { markup: string }\n" +
                            "\n" +
                            "    shared(&quot;A fragment of CSS.&quot;)\n" +
                            "    event @Style { css: string }\n" +
                            "\n" +
                            "    shared(&quot;A fragment of JavaScript.&quot;)\n" +
                            "    event @Script { code: string }\n" +
                            "\n" +
                            "    shared(&quot;All fragments are in — assemble and send the page for this path.&quot;)\n" +
                            "    event @Render { path: string }\n" +
                            "\n" +
                            "    shared(&quot;The response to send back.&quot;)\n" +
                            "    event @Response { status: int, body: string }\n" +
                            "}")
            bring Open("ul")
                bring ListItem("<strong>event @Request</strong>: Captures an incoming HTTP request. It carries a <code " +
                               "class=\"inline-code\">path</code> string representing the URL requested by the client.")
                bring ListItem("<strong>event @Html</strong>: Represents a reactive fragment of HTML. Multiple shards can emit " +
                               "this event to build a page piece by piece.")
                bring ListItem("<strong>event @Style</strong>: Used to contribute CSS rules to the final page assembly. It " +
                               "carries a <code class=\"inline-code\">css</code> string.")
                bring ListItem("<strong>event @Script</strong>: Used to contribute client-side JavaScript code to the final page " +
                               "assembly. It carries a <code class=\"inline-code\">code</code> string.")
                bring ListItem("<strong>event @Render</strong>: A signal event indicating that all fragments (HTML, Style, " +
                               "Script) for a specific <code class=\"inline-code\">path</code> have been gathered and the page is " +
                               "ready for final rendering.")
                bring ListItem("<strong>event @Response</strong>: The terminal event in the web flow, containing the integer " +
                               "<code class=\"inline-code\">status</code> code (e.g., 200, 404) and the final <code " +
                               "class=\"inline-code\">body</code> string to be returned to the client.")
            bring Close("ul")
            bring Subsubheading("Publicator: Elements")
            bring Paragraph("The <code class=\"inline-code\">Elements</code> publicator contains <code " +
                            "class=\"inline-code\">builder</code> constructs. In VeinScript, builders are specialized templates " +
                            "that generate markup. When invoked with the <code class=\"inline-code\">bring</code> keyword, " +
                            "these builders emit <code class=\"inline-code\">@Html</code> fragments into the current execution " +
                            "flow.")
            bring CodeBlock("publicator Elements {\n" +
                            "    shared(&quot;A top-level heading element.&quot;)\n" +
                            "    builder Heading { text: string   markup = &quot;&lt;h1&gt;&quot; + text + &quot;&lt;/h1&gt;&quot; }\n" +
                            "\n" +
                            "    shared(&quot;A paragraph of text.&quot;)\n" +
                            "    builder Paragraph { body: string   markup = &quot;&lt;p&gt;&quot; + body + &quot;&lt;/p&gt;&quot; }\n" +
                            "\n" +
                            "    shared(&quot;A clickable button element.&quot;)\n" +
                            "    builder Button { label: string   markup = &quot;&lt;button&gt;&quot; + label + &quot;&lt;/button&gt;&quot; }\n" +
                            "\n" +
                            "    shared(&quot;An anchor / hyperlink.&quot;)\n" +
                            "    builder Link { href: string, label: string   markup = &quot;&lt;a href=\\&quot;&quot; + href + &quot;\\&quot;&gt;&quot; + label + &quot;&lt;/a&gt;&quot; }\n" +
                            "\n" +
                            "    shared(&quot;An image element.&quot;)\n" +
                            "    builder Image { source: string, alt: string   markup = &quot;&lt;img src=\\&quot;&quot; + source + &quot;\\&quot; alt=\\&quot;&quot; + alt + &quot;\\&quot;&gt;&quot; }\n" +
                            "\n" +
                            "    shared(&quot;A list item.&quot;)\n" +
                            "    builder ListItem { text: string   markup = &quot;&lt;li&gt;&quot; + text + &quot;&lt;/li&gt;&quot; }\n" +
                            "}")
            bring Open("ul")
                bring ListItem("<strong>builder Heading</strong>: Takes a <code class=\"inline-code\">text</code> string and " +
                               "produces an <code class=\"inline-code\">&lt;h1&gt;</code> HTML element.")
                bring ListItem("<strong>builder Paragraph</strong>: Takes a <code class=\"inline-code\">body</code> string and " +
                               "produces a <code class=\"inline-code\">&lt;p&gt;</code> HTML element.")
                bring ListItem("<strong>builder Button</strong>: Takes a <code class=\"inline-code\">label</code> string and " +
                               "produces a <code class=\"inline-code\">&lt;button&gt;</code> HTML element.")
                bring ListItem("<strong>builder Link</strong>: Takes an <code class=\"inline-code\">href</code> (URL) and a <code " +
                               "class=\"inline-code\">label</code>, producing an <code class=\"inline-code\">&lt;a&gt;</code> anchor " +
                               "tag.")
                bring ListItem("<strong>builder Image</strong>: Takes a <code class=\"inline-code\">source</code> URL and <code " +
                               "class=\"inline-code\">alt</code> text, producing an <code class=\"inline-code\">&lt;img&gt;</code> " +
                               "tag with the appropriate attributes.")
                bring ListItem("<strong>builder ListItem</strong>: Takes a <code class=\"inline-code\">text</code> string and " +
                               "produces an <code class=\"inline-code\">&lt;li&gt;</code> element, typically used within list " +
                               "structures.")
            bring Close("ul")
            bring Subsubheading("The shared Keyword")
            bring Paragraph("The <code class=\"inline-code\">shared</code> keyword is used before events and builders to mark " +
                            "them as part of the public API. It accepts a string literal which serves as documentation for " +
                            "the member. Items not marked as <code class=\"inline-code\">shared</code> within a publicator " +
                            "would remain internal to the bundle, though this file marks all primary constructs as shared to " +
                            "facilitate web development.")
            bring CodeBlock("shared(&quot;A paragraph of text.&quot;)\n" +
                            "builder Paragraph { body: string   markup = &quot;&lt;p&gt;&quot; + body + &quot;&lt;/p&gt;&quot; }")
            bring Raw("<span id='sec5'></span>")
            bring Subheading("File: Vein.app.vein")
            bring Paragraph("This file serves as the primary manifest and entry point for the VeinScript Standard Library. It " +
                            "utilizes the <code class=\"inline-code\">app</code> construct to aggregate various modular " +
                            "components of the language's core functionality into a single, discoverable bundle. By composing " +
                            "multiple <code class=\"inline-code\">.vein</code> files, it allows the compiler (<code " +
                            "class=\"inline-code\">veinc</code>) to generate a complete symbol table for the entire standard " +
                            "library, facilitating validation, tooling support, and library distribution.")
            bring Subsubheading("The <code class=\"inline-code\">app</code> Keyword")
            bring Open("ul")
                bring ListItem("<strong>Syntax:</strong> <code class=\"inline-code\">app &lt;Identifier&gt; { &lt;Body&gt; " +
                               "}</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">app</code> keyword defines the " +
                               "top-level container for a VeinScript application or library bundle. It establishes a named scope " +
                               "that groups related source files together, serving as the root configuration for the compiler. " +
                               "In this specific file, the <code class=\"inline-code\">app</code> keyword is used to define the " +
                               "<code class=\"inline-code\">Vein</code> bundle, which acts as the umbrella for the standard " +
                               "library modules. This construct is essential for the linker to understand the boundaries of the " +
                               "package and for tools to perform symbol discovery across the entire project.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("app Vein {\n" +
                            "    load &quot;Core.vein&quot;\n" +
                            "    load &quot;Math.vein&quot;\n" +
                            "    load &quot;Transform.vein&quot;\n" +
                            "    load &quot;Input.vein&quot;\n" +
                            "    load &quot;UI.vein&quot;\n" +
                            "    load &quot;Time.vein&quot;\n" +
                            "    load &quot;Game.vein&quot;\n" +
                            "    load &quot;Web.vein&quot;\n" +
                            "    load &quot;Diagnostics.vein&quot;\n" +
                            "    load &quot;Console.vein&quot;\n" +
                            "}")
            bring Subsubheading("The <code class=\"inline-code\">load</code> Directive")
            bring Open("ul")
                bring ListItem("<strong>Syntax:</strong> <code class=\"inline-code\">load " +
                               "&quot;&lt;StringLiteral&gt;.vein&quot;</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">load</code> directive is used within " +
                               "the body of an <code class=\"inline-code\">app</code> declaration to include external VeinScript " +
                               "source files into the current bundle. Each <code class=\"inline-code\">load</code> statement " +
                               "instructs the compiler to locate the specified file and integrate its types, functions, " +
                               "behaviors, and flows into the global symbol table of the application. This allows for modularity " +
                               "by splitting the standard library into logical domains such as mathematics, user interface, and " +
                               "hardware input while maintaining a single point of entry for the compiler.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("load &quot;Core.vein&quot;")
            bring Subsubheading("Core Module Load")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">load &quot;Core.vein&quot;</code>")
                bring ListItem("<strong>Description:</strong> This directive imports the fundamental building blocks of the " +
                               "VeinScript language. The <code class=\"inline-code\">Core.vein</code> file typically contains " +
                               "basic data types, essential primitive behaviors, and the foundational logic required for any " +
                               "VeinScript program to execute. It is the first dependency loaded within the <code " +
                               "class=\"inline-code\">Vein</code> app to ensure all subsequent modules have access to basic " +
                               "language constructs.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("app Vein {\n" +
                            "    load &quot;Core.vein&quot;\n" +
                            "}")
            bring Subsubheading("Math Module Load")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">load &quot;Math.vein&quot;</code>")
                bring ListItem("<strong>Description:</strong> This directive includes the mathematical library into the standard " +
                               "bundle. The <code class=\"inline-code\">Math.vein</code> file provides common constants, " +
                               "trigonometric functions, algebraic operations, and vector math logic. By loading this file, the " +
                               "application gains the ability to perform complex calculations necessary for physics, graphics, " +
                               "and data processing.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("app Vein {\n" +
                            "    load &quot;Math.vein&quot;\n" +
                            "}")
            bring Subsubheading("Transform Module Load")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">load &quot;Transform.vein&quot;</code>")
                bring ListItem("<strong>Description:</strong> This directive imports definitions related to spatial positioning " +
                               "and coordinate systems. The <code class=\"inline-code\">Transform.vein</code> file defines " +
                               "structures and functions for handling rotation, translation, and scaling of objects, which is " +
                               "critical for 3D rendering and engine-level spatial management.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("app Vein {\n" +
                            "    load &quot;Transform.vein&quot;\n" +
                            "}")
            bring Subsubheading("Input Module Load")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">load &quot;Input.vein&quot;</code>")
                bring ListItem("<strong>Description:</strong> This directive incorporates the hardware abstraction layer for " +
                               "user input. The <code class=\"inline-code\">Input.vein</code> file defines how the application " +
                               "listens for and processes events from keyboards, mice, gamepads, and touch interfaces, providing " +
                               "a unified API for interaction handling across different platforms.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("app Vein {\n" +
                            "    load &quot;Input.vein&quot;\n" +
                            "}")
            bring Subsubheading("UI Module Load")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">load &quot;UI.vein&quot;</code>")
                bring ListItem("<strong>Description:</strong> This directive loads the User Interface framework. The <code " +
                               "class=\"inline-code\">UI.vein</code> file contains definitions for layout engines, widget types, " +
                               "styling systems, and event propagation models used to build graphical interfaces within the " +
                               "VeinScript environment.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("app Vein {\n" +
                            "    load &quot;UI.vein&quot;\n" +
                            "}")
            bring Subsubheading("Time Module Load")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">load &quot;Time.vein&quot;</code>")
                bring ListItem("<strong>Description:</strong> This directive includes utilities for temporal management. The " +
                               "<code class=\"inline-code\">Time.vein</code> file provides access to system clocks, delta-time " +
                               "calculations for frame-rate independence, timers, and scheduling logic required for " +
                               "time-sensitive operations and animations.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("app Vein {\n" +
                            "    load &quot;Time.vein&quot;\n" +
                            "}")
            bring Subsubheading("Game Module Load")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">load &quot;Game.vein&quot;</code>")
                bring ListItem("<strong>Description:</strong> This directive imports high-level game engine abstractions. The " +
                               "<code class=\"inline-code\">Game.vein</code> file defines entity-component systems, scene " +
                               "management, and game loop structures that facilitate the development of interactive " +
                               "entertainment software.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("app Vein {\n" +
                            "    load &quot;Game.vein&quot;\n" +
                            "}")
            bring Subsubheading("Web Module Load")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">load &quot;Web.vein&quot;</code>")
                bring ListItem("<strong>Description:</strong> This directive includes networking and web integration " +
                               "capabilities. The <code class=\"inline-code\">Web.vein</code> file provides protocols for HTTP " +
                               "requests, WebSocket communication, and interoperability with browser-based APIs when running in " +
                               "a web-targeted environment.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("app Vein {\n" +
                            "    load &quot;Web.vein&quot;\n" +
                            "}")
            bring Subsubheading("Diagnostics Module Load")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">load &quot;Diagnostics.vein&quot;</code>")
                bring ListItem("<strong>Description:</strong> This directive imports tools for debugging and performance " +
                               "monitoring. The <code class=\"inline-code\">Diagnostics.vein</code> file contains functions for " +
                               "logging, assertion checking, memory profiling, and error reporting to assist developers in " +
                               "identifying and resolving issues during development.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("app Vein {\n" +
                            "    load &quot;Diagnostics.vein&quot;\n" +
                            "}")
            bring Subsubheading("Console Module Load")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">load &quot;Console.vein&quot;</code>")
                bring ListItem("<strong>Description:</strong> This directive loads the standard input/output interface for " +
                               "text-based communication. The <code class=\"inline-code\">Console.vein</code> file defines the " +
                               "methods for writing to the terminal and reading user input from a command-line interface, " +
                               "providing a basic bridge for text-based interaction.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("app Vein {\n" +
                            "    load &quot;Console.vein&quot;\n" +
                            "}")
            bring Raw("<span id='sec6'></span>")
            bring Subheading("File: UI.vein")
            bring Paragraph("This file defines the standard library for platform-independent User Interface primitives in " +
                            "VeinScript. It organizes visual states as shapes and interaction occurrences as events, " +
                            "separating the identity of UI components from their platform-specific rendering logic.")
            bring Subsubheading("Bundle: UI")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">bundle UI by Vein { ... }</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">bundle</code> keyword defines the " +
                               "primary namespace for the UI library. By using the <code class=\"inline-code\">by Vein</code> " +
                               "suffix, it identifies this as a core standard library component managed by the Vein environment. " +
                               "It acts as the root container for all widgets and interaction definitions.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("bundle UI by Vein {\n" +
                            "    // UI definitions reside here\n" +
                            "}")
            bring Subsubheading("Publicator: Widgets")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">publicator Widgets { ... }</code>")
                bring ListItem("<strong>Description:</strong> A <code class=\"inline-code\">publicator</code> is a logical " +
                               "grouping that exposes a set of related definitions to the rest of the application. The <code " +
                               "class=\"inline-code\">Widgets</code> publicator specifically contains the &quot;Shapes&quot; that " +
                               "define the visual state and data requirements for standard UI elements.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("publicator Widgets {\n" +
                            "    shape $Text { content: string }\n" +
                            "}")
            bring Subsubheading("Shape: $Text")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">shape $Text { content: string }</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">$Text</code> shape represents a " +
                               "static run of displayable text. It contains a single field, <code " +
                               "class=\"inline-code\">content</code>, which holds the actual string to be rendered by the backend. " +
                               "It is the most basic building block for displaying information.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("shape $Text { \n" +
                            "    content: &quot;A run of display text.&quot; \n" +
                            "}")
            bring Subsubheading("Shape: $Button")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">shape $Button { label: string }</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">$Button</code> shape defines the " +
                               "state for a clickable interface element. It includes a <code class=\"inline-code\">label</code> " +
                               "field intended to provide text instructions or descriptions inside the button's boundaries.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("shape $Button { \n" +
                            "    label: &quot;A button's label.&quot; \n" +
                            "}")
            bring Subsubheading("Shape: $Field")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">shape $Field { value: string, placeholder: " +
                               "string }</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">$Field</code> shape represents a " +
                               "text input widget. It tracks two string properties: the current text typed by the user (<code " +
                               "class=\"inline-code\">value</code>) and a decorative hint text (<code " +
                               "class=\"inline-code\">placeholder</code>) displayed when the value is empty.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("shape $Field { \n" +
                            "    value: &quot;Current input&quot;, \n" +
                            "    placeholder: &quot;A text input field with current value and placeholder.&quot; \n" +
                            "}")
            bring Subsubheading("Shape: $Image")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">shape $Image { source: string }</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">$Image</code> shape provides a " +
                               "mechanism for displaying visual assets. The <code class=\"inline-code\">source</code> field " +
                               "contains the path, filename, or URL identifying where the image data is located for the renderer " +
                               "to fetch.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("shape $Image { \n" +
                            "    source: &quot;An image element, by source path/url.&quot; \n" +
                            "}")
            bring Subsubheading("Publicator: Interaction")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">publicator Interaction { ... }</code>")
                bring ListItem("<strong>Description:</strong> This publicator groups together the event definitions used to " +
                               "handle user input. By separating interactions from widgets, the system allows any entity to " +
                               "receive and react to these signals regardless of how they are rendered.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("publicator Interaction {\n" +
                            "    event @Clicked { target: Entity }\n" +
                            "}")
            bring Subsubheading("Event: @Clicked")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">event @Clicked { target: Entity }</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">@Clicked</code> event is emitted " +
                               "when a user successfully activates an interactive element, such as via a mouse click or a touch " +
                               "tap. The <code class=\"inline-code\">target</code> field identifies the specific <code " +
                               "class=\"inline-code\">Entity</code> that was interacted with.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("event @Clicked { \n" +
                            "    target: Entity \n" +
                            "}")
            bring Subsubheading("Event: @Focused")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">event @Focused { target: Entity }</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">@Focused</code> event signifies that " +
                               "an element has become the primary target for input, often occurring when a user clicks into a " +
                               "text field or tabs to a button using a keyboard.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("event @Focused { \n" +
                            "    target: Entity \n" +
                            "}")
            bring Subsubheading("Event: @Blurred")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">event @Blurred { target: Entity }</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">@Blurred</code> event is the inverse " +
                               "of <code class=\"inline-code\">@Focused</code>. It is emitted when an element loses its active " +
                               "input status, typically because the user has interacted with a different part of the interface.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("event @Blurred { \n" +
                            "    target: Entity \n" +
                            "}")
            bring Subsubheading("Event: @Hovered")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">event @Hovered { target: Entity }</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">@Hovered</code> event occurs when a " +
                               "pointing device, such as a mouse cursor, enters the visual boundary of an entity. This is " +
                               "commonly used to trigger visual feedback like tooltips or highlight states.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("event @Hovered { \n" +
                            "    target: Entity \n" +
                            "}")
            bring Raw("<span id='sec7'></span>")
            bring Subheading("File: Transform.vein")
            bring Paragraph("This reference page documents the <code class=\"inline-code\">Transform.vein</code> source file, " +
                            "which defines the core spatial primitives and movement signals for the VeinScript Standard " +
                            "Library. This file establishes the standard for how entities exist and move within a 3D " +
                            "coordinate system, providing a common interface for both desktop windowing layouts and game " +
                            "engine logic.")
            bring Subsubheading("Bundle Definition")
            bring Paragraph("The file is organized into a primary bundle, which serves as the top-level namespace for the " +
                            "library's transform logic.")
            bring Open("ul")
                bring ListItem("<strong>bundle Transform by Vein</strong>")
            bring Close("ul")
            bring Paragraph("The <code class=\"inline-code\">bundle</code> keyword defines the namespace and ownership of the " +
                            "following code. In this file, the <code class=\"inline-code\">Transform</code> bundle is authored " +
                            "by <code class=\"inline-code\">Vein</code>, signaling its status as a standard library component. " +
                            "It acts as the container for all spatial and motion-related definitions.")
            bring CodeBlock("bundle Transform by Vein {\n" +
                            "    // ... contents ...\n" +
                            "}")
            bring Subsubheading("Publicators")
            bring Paragraph("Publicators are used to group related definitions and expose them to other bundles. This file " +
                            "uses two distinct publicators to categorize state versus signals.")
            bring Open("ul")
                bring ListItem("<strong>publicator Spatial</strong>")
            bring Close("ul")
            bring Paragraph("The <code class=\"inline-code\">Spatial</code> publicator groups the fundamental shapes that " +
                            "define an identity's physical presence in a coordinate system. It encapsulates position, " +
                            "rotation, scale, and velocity.")
            bring CodeBlock("publicator Spatial {\n" +
                            "    // ... spatial shapes ...\n" +
                            "}")
            bring Open("ul")
                bring ListItem("<strong>publicator Motion</strong>")
            bring Close("ul")
            bring Paragraph("The <code class=\"inline-code\">Motion</code> publicator is dedicated to reactive signals and " +
                            "occurrences related to changes in an identity's spatial state, such as displacement events.")
            bring CodeBlock("publicator Motion {\n" +
                            "    // ... motion events ...\n" +
                            "}")
            bring Subsubheading("Shapes")
            bring Paragraph("Shapes in VeinScript are structured data containers. The shapes defined in <code " +
                            "class=\"inline-code\">Transform.vein</code> use the <code class=\"inline-code\">$</code> prefix and " +
                            "the <code class=\"inline-code\">shared</code> metadata tag to indicate they are accessible across " +
                            "different system boundaries.")
            bring Open("ul")
                bring ListItem("<strong>shape $Position</strong>")
            bring Close("ul")
            bring Paragraph("The <code class=\"inline-code\">$Position</code> shape represents a point in 3D space, typically " +
                            "used for either world-space or local-space coordinates. It consists of three floating-point " +
                            "values for the X, Y, and Z axes.")
            bring CodeBlock("shared(&quot;World/local position.&quot;)\n" +
                            "shape $Position { x: float, y: float, z: float }")
            bring Open("ul")
                bring ListItem("<strong>shape $Rotation</strong>")
            bring Close("ul")
            bring Paragraph("The <code class=\"inline-code\">$Rotation</code> shape defines the orientation of an identity " +
                            "using Euler angles. These values are stored as floats and are interpreted by the standard " +
                            "library as being in radians.")
            bring CodeBlock("shared(&quot;Euler rotation (radians).&quot;)\n" +
                            "shape $Rotation { x: float, y: float, z: float }")
            bring Open("ul")
                bring ListItem("<strong>shape $Scale</strong>")
            bring Close("ul")
            bring Paragraph("The <code class=\"inline-code\">$Scale</code> shape allows for non-uniform scaling of an identity. " +
                            "It provides independent floating-point multipliers for the X, Y, and Z axes to adjust the size " +
                            "of the entity.")
            bring CodeBlock("shared(&quot;Non-uniform scale.&quot;)\n" +
                            "shape $Scale { x: float, y: float, z: float }")
            bring Open("ul")
                bring ListItem("<strong>shape $Velocity</strong>")
            bring Close("ul")
            bring Paragraph("The <code class=\"inline-code\">$Velocity</code> shape tracks the rate of change in an identity's " +
                            "position. It utilizes a specific folding strategy to handle contributions from multiple systems " +
                            "simultaneously.")
            bring CodeBlock("shared(&quot;Velocity — many systems contribute, so each axis folds additively.&quot;)\n" +
                            "shape $Velocity {\n" +
                            "    x: float folds sum\n" +
                            "    y: float folds sum\n" +
                            "    z: float folds sum\n" +
                            "}")
            bring Subsubheading("Events")
            bring Paragraph("Events (or occurrences) represent discrete signals that something has happened within the " +
                            "environment. They are prefixed with the <code class=\"inline-code\">@</code> symbol.")
            bring Open("ul")
                bring ListItem("<strong>event @Moved</strong>")
            bring Close("ul")
            bring Paragraph("The <code class=\"inline-code\">@Moved</code> event is triggered whenever an identity's position " +
                            "is updated. It carries the identity of the entity that moved along with its new X, Y, and Z " +
                            "coordinates, allowing other systems to react to the change.")
            bring CodeBlock("shared(&quot;An identity's position changed.&quot;)\n" +
                            "event @Moved { entity: Entity, x: float, y: float, z: float }")
            bring Subsubheading("Logic Modifiers and Keywords")
            bring Paragraph("Several specific modifiers and syntax patterns are demonstrated in this file to control how data " +
                            "is processed by the VeinScript runtime.")
            bring Open("ul")
                bring ListItem("<strong>shared(&quot;description&quot;)</strong>")
            bring Close("ul")
            bring Paragraph("This attribute is used to provide metadata to the compiler and runtime. It signals that the " +
                            "following construct is part of a shared state accessible by the broader environment and includes " +
                            "a human-readable description for the discovery system.")
            bring CodeBlock("shared(&quot;World/local position.&quot;)")
            bring Open("ul")
                bring ListItem("<strong>folds sum</strong>")
            bring Close("ul")
            bring Paragraph("The <code class=\"inline-code\">folds sum</code> modifier is applied to the fields within the " +
                            "<code class=\"inline-code\">$Velocity</code> shape. This instruction tells the VeinScript engine " +
                            "that if multiple independent systems attempt to write to this field during the same execution " +
                            "frame, their values should be added together (summed) rather than overwriting one another. This " +
                            "allows forces, impulses, and manual controls to all contribute to a single velocity vector " +
                            "without conflict.")
            bring CodeBlock("x: float folds sum")
            bring Open("ul")
                bring ListItem("<strong>float</strong>")
            bring Close("ul")
            bring Paragraph("The <code class=\"inline-code\">float</code> type is the standard data type used for all spatial " +
                            "dimensions and magnitudes in this file, providing the necessary precision for coordinate " +
                            "geometry.")
            bring CodeBlock("x: float")
            bring Raw("<span id='sec8'></span>")
            bring Subheading("File: Time.vein")
            bring Paragraph("The <code class=\"inline-code\">Time.vein</code> file is the foundational module of the VeinScript " +
                            "Standard Library responsible for time management. It establishes an event-driven time system " +
                            "that is platform-independent, ensuring that time-based logic is decoupled from specific hardware " +
                            "or frame-rate assumptions. It defines how the runtime communicates time progression to scripts " +
                            "through shared state and events.")
            bring Subsubheading("bundle Time by Vein")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">bundle Time by Vein { ... }</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">bundle</code> keyword defines the " +
                               "highest-level organizational unit in VeinScript, acting as a container for related functionality " +
                               "and identifying the namespace. In this file, the <code class=\"inline-code\">Time</code> bundle " +
                               "serves as the entry point for the standard library's time concepts, ensuring all contained " +
                               "symbols are associated with the <code class=\"inline-code\">Vein</code> namespace for consistent " +
                               "discovery and linking.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("bundle Time by Vein {\n" +
                            "    // All time-related publicators, shapes, and events are defined here\n" +
                            "}")
            bring Subsubheading("publicator Clock")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">publicator Clock { ... }</code>")
                bring ListItem("<strong>Description:</strong> A <code class=\"inline-code\">publicator</code> is a declaration " +
                               "block that manages and broadcasts shared resources, specifically state shapes and events. The " +
                               "<code class=\"inline-code\">Clock</code> publicator serves as the central authority for timing " +
                               "information, grouping the data structures and signals that scripts use to determine the current " +
                               "time and react to the passage of time across different environments.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("publicator Clock {\n" +
                            "    shared(&quot;The current time: wall-clock now and the delta since the previous tick (seconds).&quot;)\n" +
                            "    shape $Clock { now: float, delta: float }\n" +
                            "    shared(&quot;A time step advanced — carries the frame index and elapsed delta.&quot;)\n" +
                            "    event @Ticked { frame: int, delta: float }\n" +
                            "}")
            bring Subsubheading("shared(...)")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">shared(&quot;description " +
                               "string&quot;)</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">shared</code> keyword is a modifier " +
                               "used within a publicator to indicate that the subsequent construct—such as a shape or an " +
                               "event—is a globally accessible member of that publicator. It typically includes a string literal " +
                               "that serves as documentation, describing the purpose of the shared construct to the runtime and " +
                               "other developers.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("shared(&quot;The current time: wall-clock now and the delta since the previous tick (seconds).&quot;)\n" +
                            "shape $Clock { now: float, delta: float }")
            bring Subsubheading("shape $Clock")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">shape $Clock { now: float, delta: float " +
                               "}</code>")
                bring ListItem("<strong>Description:</strong> A <code class=\"inline-code\">shape</code> defines the structure of " +
                               "a data object, and the <code class=\"inline-code\">$</code> prefix denotes a state-carrying " +
                               "instance. The <code class=\"inline-code\">$Clock</code> shape provides two specific fields: <code " +
                               "class=\"inline-code\">now</code>, a float representing the absolute wall-clock time, and <code " +
                               "class=\"inline-code\">delta</code>, a float representing the time elapsed in seconds since the " +
                               "last update; this allows any script to poll the current temporal state of the system.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("shape $Clock {\n" +
                            "    now: float,\n" +
                            "    delta: float\n" +
                            "}")
            bring Subsubheading("event @Ticked")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">event @Ticked { frame: int, delta: float " +
                               "}</code>")
                bring ListItem("<strong>Description:</strong> An <code class=\"inline-code\">event</code> is a reactive signal " +
                               "emitted by the runtime, identified by the <code class=\"inline-code\">@</code> prefix. The <code " +
                               "class=\"inline-code\">@Ticked</code> event is the primary pulse of a VeinScript application; it is " +
                               "fired whenever a time step advances, carrying the <code class=\"inline-code\">frame</code> index " +
                               "as an integer for sequencing and the <code class=\"inline-code\">delta</code> time as a float to " +
                               "allow for frame-rate-independent calculations.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("event @Ticked {\n" +
                            "    frame: int,\n" +
                            "    delta: float\n" +
                            "}")
            bring Subsubheading("float (Type)")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">float</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">float</code> keyword denotes a " +
                               "32-bit floating-point number. In the context of <code class=\"inline-code\">Time.vein</code>, it " +
                               "is used to provide high-precision timing information for both absolute time and incremental " +
                               "changes, ensuring that movement or logic updates can be calculated with the necessary decimal " +
                               "accuracy.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("now: float\n" +
                            "delta: float")
            bring Subsubheading("int (Type)")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">int</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">int</code> keyword denotes a " +
                               "standard integer type. In this file, it is utilized within the <code " +
                               "class=\"inline-code\">@Ticked</code> event to represent the <code class=\"inline-code\">frame</code> " +
                               "count, providing a whole-number index that increments with every discrete step the runtime " +
                               "takes, which is useful for logic that requires frame-perfect sequencing or modulo-based " +
                               "triggers.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("frame: int")
            bring Raw("<span id='sec9'></span>")
            bring Subheading("File: Math.vein")
            bring Paragraph("The <code class=\"inline-code\">Math.vein</code> file defines the foundational value types and " +
                            "scalar computation utilities for the VeinScript Standard Library. It is organized into the <code " +
                            "class=\"inline-code\">Vein.Math</code> namespace, providing platform-independent shapes like " +
                            "vectors and rectangles, alongside pure functions for common mathematical operations. These " +
                            "constructs are designed to be reused across all domains, from physics to rendering.")
            bring Subsubheading("Structural Constructs")
            bring Open("ul")
                bring ListItem("<strong>bundle</strong>")
            bring Close("ul")
            bring Paragraph("The <code class=\"inline-code\">bundle</code> keyword defines a high-level package or module " +
                            "identity. In this file, it establishes the <code class=\"inline-code\">Math</code> bundle under " +
                            "the <code class=\"inline-code\">Vein</code> authority, serving as the root container for all " +
                            "mathematical logic and types.")
            bring CodeBlock("bundle Math by Vein {\n" +
                            "    // ... contents ...\n" +
                            "}")
            bring Open("ul")
                bring ListItem("<strong>publicator</strong>")
            bring Close("ul")
            bring Paragraph("A <code class=\"inline-code\">publicator</code> acts as a named scope or category within a bundle, " +
                            "used to organize and export related symbols. This file uses two publicators: <code " +
                            "class=\"inline-code\">Values</code> for data structures and <code " +
                            "class=\"inline-code\">Scalars</code> for mathematical functions.")
            bring CodeBlock("publicator Values {\n" +
                            "    // ... shapes ...\n" +
                            "}")
            bring Open("ul")
                bring ListItem("<strong>shared</strong>")
            bring Close("ul")
            bring Paragraph("The <code class=\"inline-code\">shared</code> keyword is a decorator used to attach documentation " +
                            "strings or metadata to a definition. It ensures that the purpose of shapes and functions is " +
                            "discoverable by the compiler and external tooling.")
            bring CodeBlock("shared(&quot;A 2D vector / point.&quot;)\n" +
                            "shape $Vec2 { x: float, y: float }")
            bring Subsubheading("Value Shapes (Data Types)")
            bring Open("ul")
                bring ListItem("<strong>shape $Vec2</strong>")
            bring Close("ul")
            bring Paragraph("Defines a two-dimensional vector or coordinate point. It contains two floating-point fields, " +
                            "<code class=\"inline-code\">x</code> and <code class=\"inline-code\">y</code>, and is used for 2D " +
                            "positioning and layout.")
            bring CodeBlock("shape $Vec2 { x: float, y: float }")
            bring Open("ul")
                bring ListItem("<strong>shape $Vec3</strong>")
            bring Close("ul")
            bring Paragraph("Defines a three-dimensional vector or coordinate point. It extends the spatial representation to " +
                            "include a <code class=\"inline-code\">z</code> axis, commonly used for 3D translations or color " +
                            "representations without alpha.")
            bring CodeBlock("shape $Vec3 { x: float, y: float, z: float }")
            bring Open("ul")
                bring ListItem("<strong>shape $Vec4</strong>")
            bring Close("ul")
            bring Paragraph("Defines a four-dimensional vector or homogeneous coordinate. It includes <code " +
                            "class=\"inline-code\">x</code>, <code class=\"inline-code\">y</code>, <code " +
                            "class=\"inline-code\">z</code>, and <code class=\"inline-code\">w</code> fields, typically utilized " +
                            "for 3D transformations or calculations involving quaternions.")
            bring CodeBlock("shape $Vec4 { x: float, y: float, z: float, w: float }")
            bring Open("ul")
                bring ListItem("<strong>shape $Color</strong>")
            bring Close("ul")
            bring Paragraph("A specialized shape representing an RGBA color. It defines four channels (<code " +
                            "class=\"inline-code\">r</code>, <code class=\"inline-code\">g</code>, <code " +
                            "class=\"inline-code\">b</code>, <code class=\"inline-code\">a</code>) where each value is expected " +
                            "to be a float ranging from 0.0 to 1.0.")
            bring CodeBlock("shape $Color { r: float, g: float, b: float, a: float }")
            bring Open("ul")
                bring ListItem("<strong>shape $Rect</strong>")
            bring Close("ul")
            bring Paragraph("Defines an axis-aligned rectangle. It stores the top-left position (<code " +
                            "class=\"inline-code\">x</code>, <code class=\"inline-code\">y</code>) and the extents (<code " +
                            "class=\"inline-code\">width</code>, <code class=\"inline-code\">height</code>) of the rectangular " +
                            "area.")
            bring CodeBlock("shape $Rect { x: float, y: float, width: float, height: float }")
            bring Subsubheading("Scalar Functions")
            bring Open("ul")
                bring ListItem("<strong>fn clamp</strong>")
            bring Close("ul")
            bring Paragraph("Restricts a value <code class=\"inline-code\">v</code> to a specified range defined by <code " +
                            "class=\"inline-code\">lo</code> and <code class=\"inline-code\">hi</code>. If the value is outside " +
                            "the range, it returns the nearest boundary.")
            bring CodeBlock("fn clamp(v: float, lo: float, hi: float) -&gt; float {\n" +
                            "    if v &lt; lo { return lo }\n" +
                            "    if v &gt; hi { return hi }\n" +
                            "    return v\n" +
                            "}")
            bring Open("ul")
                bring ListItem("<strong>fn lerp</strong>")
            bring Close("ul")
            bring Paragraph("Performs linear interpolation between two values <code class=\"inline-code\">a</code> and <code " +
                            "class=\"inline-code\">b</code> based on the factor <code class=\"inline-code\">t</code>. It does not " +
                            "clamp <code class=\"inline-code\">t</code>, allowing for extrapolation if <code " +
                            "class=\"inline-code\">t</code> is outside the 0.0 to 1.0 range.")
            bring CodeBlock("fn lerp(a: float, b: float, t: float) -&gt; float {\n" +
                            "    return a + (b - a) * t\n" +
                            "}")
            bring Open("ul")
                bring ListItem("<strong>fn min</strong>")
            bring Close("ul")
            bring Paragraph("Compares two floating-point numbers and returns the smaller of the two.")
            bring CodeBlock("fn min(a: float, b: float) -&gt; float {\n" +
                            "    if a &lt; b { return a }\n" +
                            "    return b\n" +
                            "}")
            bring Open("ul")
                bring ListItem("<strong>fn max</strong>")
            bring Close("ul")
            bring Paragraph("Compares two floating-point numbers and returns the larger of the two.")
            bring CodeBlock("fn max(a: float, b: float) -&gt; float {\n" +
                            "    if a &gt; b { return a }\n" +
                            "    return b\n" +
                            "}")
            bring Open("ul")
                bring ListItem("<strong>fn abs</strong>")
            bring Close("ul")
            bring Paragraph("Calculates the absolute value of a number, ensuring the result is non-negative.")
            bring CodeBlock("fn abs(v: float) -&gt; float {\n" +
                            "    if v &lt; 0.0 { return -v }\n" +
                            "    return v\n" +
                            "}")
            bring Open("ul")
                bring ListItem("<strong>fn distance2</strong>")
            bring Close("ul")
            bring Paragraph("Computes the squared Euclidean distance between two 2D points. By omitting the square root " +
                            "operation, this function provides a computationally cheap way to compare distances.")
            bring CodeBlock("fn distance2(x1: float, y1: float, x2: float, y2: float) -&gt; float {\n" +
                            "    return (x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1)\n" +
                            "}")
            bring Subsubheading("Logic and Operators")
            bring Open("ul")
                bring ListItem("<strong>if / return</strong>")
            bring Close("ul")
            bring Paragraph("The file demonstrates standard control flow using <code class=\"inline-code\">if</code> statements " +
                            "for conditional logic and <code class=\"inline-code\">return</code> to exit a function with a " +
                            "computed value.")
            bring CodeBlock("if v &lt; lo { return lo }")
            bring Open("ul")
                bring ListItem("<strong>Arithmetic Operators</strong>")
            bring Close("ul")
            bring Paragraph("The functions utilize standard infix notation for arithmetic: <code class=\"inline-code\">+</code> " +
                            "(addition), <code class=\"inline-code\">-</code> (subtraction), and <code " +
                            "class=\"inline-code\">*</code> (multiplication), as seen in the <code " +
                            "class=\"inline-code\">lerp</code> and <code class=\"inline-code\">distance2</code> implementations.")
            bring CodeBlock("return a + (b - a) * t")
            bring Raw("<span id='sec10'></span>")
            bring Subheading("File: Input.vein")
            bring Paragraph("This file defines the <code class=\"inline-code\">Vein.Input</code> bundle, which serves as the " +
                            "standard interface for platform-independent input handling in VeinScript. It abstracts " +
                            "hardware-specific signals into universal events that allow application code to behave " +
                            "consistently across desktop, web, and mobile environments.")
            bring Subsubheading("Bundle Declaration")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">bundle Input by Vein { ... }</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">bundle</code> keyword defines a " +
                               "top-level namespace and a unit of distribution. The <code class=\"inline-code\">by</code> clause " +
                               "specifies the naming authority, in this case <code class=\"inline-code\">Vein</code>, which is the " +
                               "standard library provider. This construct encapsulates all input-related logic, ensuring that " +
                               "symbols like <code class=\"inline-code\">Mouse</code> and <code " +
                               "class=\"inline-code\">Keyboard</code> are qualified under the <code " +
                               "class=\"inline-code\">Vein.Input</code> path.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("bundle Input by Vein {\n" +
                            "    // Bundle contents defining input behaviors\n" +
                            "}")
            bring Subsubheading("Publicator: Mouse")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">publicator Mouse { ... }</code>")
                bring ListItem("<strong>Description:</strong> A <code class=\"inline-code\">publicator</code> is a specialized " +
                               "container that acts as a source for events. The <code class=\"inline-code\">Mouse</code> " +
                               "publicator organizes all signals related to pointing devices. It serves as the bridge between " +
                               "the runtime (which captures native OS mouse movements) and the application shard, allowing " +
                               "listeners to &quot;hear&quot; mouse activity.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("publicator Mouse {\n" +
                            "    shared(&quot;The pointer moved.&quot;)\n" +
                            "    event @MouseMove { *Vein.Math.Values.$Vec2 }\n" +
                            "}")
            bring Subsubheading("Shared Annotation")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code " +
                               "class=\"inline-code\">shared(&quot;&lt;description&gt;&quot;)</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">shared</code> keyword is used as a " +
                               "metadata annotation to provide human-readable documentation for events, shapes, or fields. These " +
                               "strings are processed by the compiler and are often surfaced in IDE tooling or documentation " +
                               "generators to explain the intent of a specific input signal.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("shared(&quot;A mouse/pointer button was pressed.&quot;)\n" +
                            "event @MouseDown { *Vein.Math.Values.$Vec2, button: int }")
            bring Subsubheading("Event: @MouseDown")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">event @MouseDown { " +
                               "*Vein.Math.Values.$Vec2, button: int }</code>")
                bring ListItem("<strong>Description:</strong> This event represents the action of a user pressing a button on a " +
                               "pointing device. It includes the spatial coordinates of the event and an integer identifier for " +
                               "the specific button. It uses a shape inclusion to pull in standard coordinate fields.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("event @MouseDown { *Vein.Math.Values.$Vec2, button: int }")
            bring Subsubheading("Event: @MouseUp")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">event @MouseUp { *Vein.Math.Values.$Vec2, " +
                               "button: int }</code>")
                bring ListItem("<strong>Description:</strong> This event is triggered when a mouse button is released. It " +
                               "provides the same data structure as the press event, including the location of the pointer and " +
                               "the button index, allowing developers to calculate click durations or identify where a " +
                               "drag-and-drop operation concluded.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("event @MouseUp { *Vein.Math.Values.$Vec2, button: int }")
            bring Subsubheading("Event: @MouseMove")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">event @MouseMove { *Vein.Math.Values.$Vec2 " +
                               "}</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">@MouseMove</code> event is " +
                               "dispatched whenever the pointing device changes its location on the screen. It focuses strictly " +
                               "on the positional data, providing the updated coordinates relative to the application's " +
                               "coordinate system.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("event @MouseMove { *Vein.Math.Values.$Vec2 }")
            bring Subsubheading("Shape Inclusion (Expansion)")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">*Vein.Math.Values.$Vec2</code>")
                bring ListItem("<strong>Description:</strong> The asterisk <code class=\"inline-code\">*</code> followed by a " +
                               "shape path denotes a compile-time field-group expansion. Instead of creating a nested object, " +
                               "the compiler takes the fields defined in the <code class=\"inline-code\">$Vec2</code> shape " +
                               "(typically <code class=\"inline-code\">x</code> and <code class=\"inline-code\">y</code> floats) and " +
                               "flattens them directly into the event's data structure. This provides a shared vocabulary for " +
                               "data without the overhead of runtime object linking.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("// In the context of @MouseMove:\n" +
                            "*Vein.Math.Values.$Vec2")
            bring Subsubheading("Publicator: Keyboard")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">publicator Keyboard { ... }</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">Keyboard</code> publicator is the " +
                               "central source for all keyboard-related interactions. It defines how physical key presses, " +
                               "releases, and composed text entries are represented within the VeinScript ecosystem, providing a " +
                               "consistent interface regardless of the underlying hardware layout.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("publicator Keyboard {\n" +
                            "    shared(&quot;A key was pressed.&quot;)\n" +
                            "    event @KeyDown { $Key }\n" +
                            "}")
            bring Subsubheading("Shape: $Key")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">shape $Key { key: string }</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">$Key</code> shape is a reusable data " +
                               "template that defines the identity of a keyboard key. By wrapping the <code " +
                               "class=\"inline-code\">key</code> string in a shape, the library ensures that both press and " +
                               "release events use the exact same field name and data type, simplifying the logic for event " +
                               "listeners.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("shared(&quot;The key a keyboard event concerns.&quot;)\n" +
                            "shape $Key { key: string }")
            bring Subsubheading("Event: @KeyDown")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">event @KeyDown { $Key }</code>")
                bring ListItem("<strong>Description:</strong> This event is fired the moment a physical key is depressed. It " +
                               "utilizes the <code class=\"inline-code\">$Key</code> shape to identify the character or function " +
                               "key involved. It is primarily used for handling game controls, shortcuts, or any logic that " +
                               "requires immediate feedback on physical key state.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("event @KeyDown { $Key }")
            bring Subsubheading("Event: @KeyUp")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">event @KeyUp { $Key }</code>")
                bring ListItem("<strong>Description:</strong> The <code class=\"inline-code\">@KeyUp</code> event occurs when a " +
                               "previously held key is released. By embedding the <code class=\"inline-code\">$Key</code> shape, " +
                               "it provides symmetry with the <code class=\"inline-code\">@KeyDown</code> event, allowing " +
                               "applications to track the state of specific keys by matching the string identifier.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("event @KeyUp { $Key }")
            bring Subsubheading("Event: @TextInput")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">event @TextInput { text: string }</code>")
                bring ListItem("<strong>Description:</strong> Unlike raw key events, <code class=\"inline-code\">@TextInput</code> " +
                               "provides composed text. This event accounts for modifier keys (like Shift or AltGr) and Input " +
                               "Method Editors (IMEs), delivering the final string of characters intended for a text field " +
                               "rather than individual hardware codes.")
                bring ListItem("<strong>Example:</strong>")
            bring Close("ul")
            bring CodeBlock("shared(&quot;Text was entered (already composed — not raw key codes).&quot;)\n" +
                            "event @TextInput { text: string }")
            bring Raw("<span id='sec11'></span>")
            bring Subheading("File: Game.vein")
            bring Paragraph("This reference documents the <code class=\"inline-code\">Game.vein</code> standard library file, " +
                            "which defines the core vocabulary for game-specific interactions within the VeinScript " +
                            "ecosystem. This file focuses on providing shared data structures (shapes) and signals (events) " +
                            "for collision, physics, and combat, allowing different bundles to communicate using a unified " +
                            "API without forcing specific implementation behaviors.")
            bring Subsubheading("bundle")
            bring Paragraph("The <code class=\"inline-code\">bundle</code> keyword defines a modular container for VeinScript " +
                            "code, acting as the primary unit of distribution and organization. In this file, the <code " +
                            "class=\"inline-code\">bundle Game by Vein</code> declaration establishes a namespace specifically " +
                            "for game-related logic, ensuring that non-game applications do not inadvertently load physics or " +
                            "combat overhead.")
            bring CodeBlock("bundle Game by Vein {\n" +
                            "    // Bundle contents including publicators, shapes, and events\n" +
                            "}")
            bring Subsubheading("publicator")
            bring Paragraph("A <code class=\"inline-code\">publicator</code> is a declaration block used to expose specific " +
                            "shapes and events to other bundles. It acts as a contract or interface, allowing the standard " +
                            "library to define the &quot;what&quot; (data and signals) while leaving the &quot;how&quot; " +
                            "(system behavior and shards) to the individual game implementation.")
            bring CodeBlock("publicator Collision {\n" +
                            "    shared(&quot;A collision box (half-extents in world units).&quot;)\n" +
                            "    shape $Collider { width: float, height: float }\n" +
                            "\n" +
                            "    shared(&quot;Two identities overlapped this step.&quot;)\n" +
                            "    event @Collided { a: Entity, b: Entity }\n" +
                            "}")
            bring Subsubheading("shared")
            bring Paragraph("The <code class=\"inline-code\">shared</code> keyword is a modifier applied to shapes and events " +
                            "within a publicator to indicate they are part of the cross-bundle API. It often accepts a string " +
                            "literal which serves as documentation or a descriptor for the shared identity, ensuring that any " +
                            "bundle importing the <code class=\"inline-code\">Game</code> bundle can recognize and utilize " +
                            "these constructs.")
            bring CodeBlock("shared(&quot;A rigid body: mass and bounciness.&quot;)\n" +
                            "shape $Body { mass: float, restitution: float }")
            bring Subsubheading("shape $Collider")
            bring Paragraph("The <code class=\"inline-code\">$Collider</code> shape is a data structure representing a " +
                            "rectangular collision area in world units. It is defined with two <code " +
                            "class=\"inline-code\">float</code> fields, <code class=\"inline-code\">width</code> and <code " +
                            "class=\"inline-code\">height</code>, which typically represent the half-extents of an entity's " +
                            "physical presence for the purpose of overlap detection.")
            bring CodeBlock("shape $Collider { width: float, height: float }")
            bring Subsubheading("event @Collided")
            bring Paragraph("The <code class=\"inline-code\">@Collided</code> event is a signal emitted when two entities " +
                            "overlap during a simulation step. It carries two fields of type <code " +
                            "class=\"inline-code\">Entity</code>, named <code class=\"inline-code\">a</code> and <code " +
                            "class=\"inline-code\">b</code>, representing the two specific identities that have intersected, " +
                            "allowing systems to react to physical touches or triggers.")
            bring CodeBlock("event @Collided { a: Entity, b: Entity }")
            bring Subsubheading("shape $Body")
            bring Paragraph("The <code class=\"inline-code\">$Body</code> shape defines the physical properties of a rigid body " +
                            "within the game world. It includes a <code class=\"inline-code\">mass</code> field to determine " +
                            "how the entity responds to forces and a <code class=\"inline-code\">restitution</code> field to " +
                            "define its &quot;bounciness&quot; or energy retention during collisions, both represented as " +
                            "<code class=\"inline-code\">float</code> values.")
            bring CodeBlock("shape $Body { mass: float, restitution: float }")
            bring Subsubheading("event @Damaged")
            bring Paragraph("The <code class=\"inline-code\">@Damaged</code> event is a combat-specific signal used to notify " +
                            "the system that an entity has lost health or taken a hit. It contains a <code " +
                            "class=\"inline-code\">target</code> field of type <code class=\"inline-code\">Entity</code> to " +
                            "identify who was hit and an <code class=\"inline-code\">amount</code> field of type <code " +
                            "class=\"inline-code\">int</code> to specify the magnitude of the damage dealt.")
            bring CodeBlock("event @Damaged { target: Entity, amount: int }")
            bring Subsubheading("Type: float")
            bring Paragraph("The <code class=\"inline-code\">float</code> type is a primitive numeric type used within shapes " +
                            "like <code class=\"inline-code\">$Collider</code> and <code class=\"inline-code\">$Body</code>. It " +
                            "represents floating-point numbers, suitable for continuous values such as world coordinates, " +
                            "mass, and physical extents where precision beyond whole integers is required.")
            bring CodeBlock("width: float\n" +
                            "height: float\n" +
                            "mass: float\n" +
                            "restitution: float")
            bring Subsubheading("Type: int")
            bring Paragraph("The <code class=\"inline-code\">int</code> type is a primitive numeric type used for whole " +
                            "numbers. In the context of <code class=\"inline-code\">Game.vein</code>, it is utilized in the " +
                            "<code class=\"inline-code\">@Damaged</code> event to represent discrete values such as health " +
                            "points or damage ticks.")
            bring CodeBlock("amount: int")
            bring Subsubheading("Type: Entity")
            bring Paragraph("The <code class=\"inline-code\">Entity</code> type represents a unique identity within the " +
                            "VeinScript runtime. It is used in events like <code class=\"inline-code\">@Collided</code> and " +
                            "<code class=\"inline-code\">@Damaged</code> to identify which specific game objects are " +
                            "participating in an interaction or receiving an effect.")
            bring CodeBlock("a: Entity\n" +
                            "b: Entity\n" +
                            "target: Entity")
            bring Raw("<span id='sec12'></span>")
            bring Subheading("File: Diagnostics.vein")
            bring Paragraph("This file defines the standard diagnostic messaging system for the VeinScript ecosystem. It " +
                            "provides a common language for the compiler, integrated development environments, and external " +
                            "tools to communicate information, warnings, and errors through structured shapes and events.")
            bring Subsubheading("Bundle: <code class=\"inline-code\">Diagnostics</code>")
            bring Paragraph("The <code class=\"inline-code\">bundle</code> keyword defines the primary namespace and deployment " +
                            "unit for this library. In this file, the <code class=\"inline-code\">Diagnostics</code> bundle is " +
                            "scoped to the <code class=\"inline-code\">Vein</code> author, establishing it as a core component " +
                            "of the standard library. It serves as the container for all diagnostic-related logic and data " +
                            "structures.")
            bring CodeBlock("bundle Diagnostics by Vein {\n" +
                            "    // Contents of the bundle\n" +
                            "}")
            bring Subsubheading("Publicator: <code class=\"inline-code\">Report</code>")
            bring Paragraph("The <code class=\"inline-code\">publicator</code> keyword defines a group of related functions, " +
                            "shapes, and events that are exposed for public use by other shards or bundles. The <code " +
                            "class=\"inline-code\">Report</code> publicator acts as the primary interface for raising and " +
                            "describing diagnostic information within the VeinScript environment.")
            bring CodeBlock("publicator Report {\n" +
                            "    // Diagnostic constructs\n" +
                            "}")
            bring Subsubheading("Metadata: <code class=\"inline-code\">shared(&quot;&quot;)</code>")
            bring Paragraph("The <code class=\"inline-code\">shared</code> keyword is used to attach documentation strings or " +
                            "metadata to specific constructs like shapes, events, or functions. This information is intended " +
                            "to be consumed by the compiler or IDE tools to provide context-sensitive help and descriptions " +
                            "to the developer during the coding process.")
            bring CodeBlock("shared(&quot;A diagnostic was produced by some tool/shard.&quot;)\n" +
                            "event @DiagnosticRaised { severity: int, message: string }")
            bring Subsubheading("Shape: <code class=\"inline-code\">$Diagnostic</code>")
            bring Paragraph("A <code class=\"inline-code\">shape</code> defines a structured data format, similar to a record " +
                            "or a struct, used to represent complex information. The <code " +
                            "class=\"inline-code\">$Diagnostic</code> shape specifically encapsulates a source code location " +
                            "(line and column) alongside a severity level and a descriptive message, allowing tools to " +
                            "pinpoint exactly where an issue occurs.")
            bring Open("ul")
                bring ListItem("<strong>Syntax:</strong> <code class=\"inline-code\">shape $Diagnostic { severity: int, message: " +
                               "string, line: int, column: int }</code>")
                bring ListItem("<strong>Fields:</strong>")
                bring ListItem("<code class=\"inline-code\">severity</code>: An integer representing the level of importance (0 " +
                               "for info, 1 for warning, 2 for error).")
                bring ListItem("<code class=\"inline-code\">message</code>: A string containing the human-readable description of " +
                               "the diagnostic.")
                bring ListItem("<code class=\"inline-code\">line</code>: An integer indicating the source line number.")
                bring ListItem("<code class=\"inline-code\">column</code>: An integer indicating the source column number.")
            bring Close("ul")
            bring CodeBlock("shared(&quot;A diagnostic at a source location: severity (0 info / 1 warning / 2 error) + message.&quot;)\n" +
                            "shape $Diagnostic {\n" +
                            "    severity: int\n" +
                            "    message: string\n" +
                            "    line: int\n" +
                            "    column: int\n" +
                            "}")
            bring Subsubheading("Event: <code class=\"inline-code\">@DiagnosticRaised</code>")
            bring Paragraph("The <code class=\"inline-code\">event</code> keyword defines a signal that can be emitted by the " +
                            "code to notify the system or an external observer that an action has occurred. The <code " +
                            "class=\"inline-code\">@DiagnosticRaised</code> event is used to broadcast that a diagnostic " +
                            "message has been generated, carrying the severity and the message text as its payload.")
            bring Open("ul")
                bring ListItem("<strong>Syntax:</strong> <code class=\"inline-code\">event @DiagnosticRaised { severity: int, " +
                               "message: string }</code>")
                bring ListItem("<strong>Fields:</strong>")
                bring ListItem("<code class=\"inline-code\">severity</code>: An integer representing the level of importance (0 " +
                               "for info, 1 for warning, 2 for error).")
                bring ListItem("<code class=\"inline-code\">message</code>: A string containing the content of the diagnostic " +
                               "message.")
            bring Close("ul")
            bring CodeBlock("shared(&quot;A diagnostic was produced by some tool/shard.&quot;)\n" +
                            "event @DiagnosticRaised { severity: int, message: string }")
            bring Subsubheading("Function: <code class=\"inline-code\">SF info</code>")
            bring Paragraph("The <code class=\"inline-code\">SF</code> (Shared Function) keyword defines a static helper " +
                            "function that can be called to perform a specific task. The <code " +
                            "class=\"inline-code\">info</code> function is a convenience wrapper that emits a <code " +
                            "class=\"inline-code\">@DiagnosticRaised</code> event with a severity level of 0, signaling a " +
                            "purely informational message to the diagnostic collector.")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">SF info(message: string)</code>")
                bring ListItem("<strong>Logic:</strong> Emits <code class=\"inline-code\">@DiagnosticRaised</code> with <code " +
                               "class=\"inline-code\">severity: 0</code>.")
            bring Close("ul")
            bring CodeBlock("shared(&quot;Raise an informational diagnostic (severity 0).&quot;)\n" +
                            "SF info(message: string) { \n" +
                            "    emit @DiagnosticRaised { severity: 0, message: message } \n" +
                            "}")
            bring Subsubheading("Function: <code class=\"inline-code\">SF warn</code>")
            bring Paragraph("The <code class=\"inline-code\">warn</code> function is a shared function designed to signal a " +
                            "non-critical issue that may require attention but does not halt execution. It emits a <code " +
                            "class=\"inline-code\">@DiagnosticRaised</code> event with a severity level of 1, providing a " +
                            "standardized way to report warnings across different shards.")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">SF warn(message: string)</code>")
                bring ListItem("<strong>Logic:</strong> Emits <code class=\"inline-code\">@DiagnosticRaised</code> with <code " +
                               "class=\"inline-code\">severity: 1</code>.")
            bring Close("ul")
            bring CodeBlock("shared(&quot;Raise a warning diagnostic (severity 1).&quot;)\n" +
                            "SF warn(message: string) { \n" +
                            "    emit @DiagnosticRaised { severity: 1, message: message } \n" +
                            "}")
            bring Subsubheading("Function: <code class=\"inline-code\">SF error</code>")
            bring Paragraph("The <code class=\"inline-code\">error</code> function is a shared function used to signal critical " +
                            "failures or invalid states. By calling this function, the system emits a <code " +
                            "class=\"inline-code\">@DiagnosticRaised</code> event with a severity level of 2, indicating that a " +
                            "significant error has occurred which typically requires immediate correction.")
            bring Open("ul")
                bring ListItem("<strong>Signature:</strong> <code class=\"inline-code\">SF error(message: string)</code>")
                bring ListItem("<strong>Logic:</strong> Emits <code class=\"inline-code\">@DiagnosticRaised</code> with <code " +
                               "class=\"inline-code\">severity: 2</code>.")
            bring Close("ul")
            bring CodeBlock("shared(&quot;Raise an error diagnostic (severity 2).&quot;)\n" +
                            "SF error(message: string) { \n" +
                            "    emit @DiagnosticRaised { severity: 2, message: message } \n" +
                            "}")
            bring Subsubheading("Keyword: <code class=\"inline-code\">emit</code>")
            bring Paragraph("The <code class=\"inline-code\">emit</code> keyword is used within a function body to trigger an " +
                            "event. In this file, <code class=\"inline-code\">emit</code> is used to instantiate and broadcast " +
                            "the <code class=\"inline-code\">@DiagnosticRaised</code> event, passing the appropriate severity " +
                            "and message data to any active listeners or collectors in the environment.")
            bring CodeBlock("emit @DiagnosticRaised { severity: 2, message: message }")
            bring Raw("<span id='sec13'></span>")
            bring Subheading("File: Core.vein")
            bring Paragraph("The <code class=\"inline-code\">Core.vein</code> file defines the <code " +
                            "class=\"inline-code\">Vein.Core</code> bundle, which serves as the universal, platform-independent " +
                            "foundation for the VeinScript Standard Library. It establishes the fundamental patterns for " +
                            "identity lifecycle management, metadata tagging, additive numerical quantities via the folds " +
                            "mechanism, and entity-to-entity relationships. As a core library file, it focuses on state " +
                            "definitions (Shapes) and message types (Events) rather than specific logic shards.")
            bring Subsubheading("Bundle Declaration: <code class=\"inline-code\">bundle</code>")
            bring Paragraph("The <code class=\"inline-code\">bundle</code> keyword defines the highest-level organizational " +
                            "unit in VeinScript. In this file, it identifies the <code class=\"inline-code\">Core</code> bundle " +
                            "and attributes its authorship to the <code class=\"inline-code\">Vein</code> authority using the " +
                            "<code class=\"inline-code\">by</code> keyword. Bundles act as the primary container for " +
                            "publicators and logic, and they are the unit of distribution and linking within the Vein " +
                            "ecosystem.")
            bring CodeBlock("bundle Core by Vein {\n" +
                            "    // Content of the core standard library\n" +
                            "}")
            bring Subsubheading("Publicator Declaration: <code class=\"inline-code\">publicator</code>")
            bring Paragraph("A <code class=\"inline-code\">publicator</code> is a scoped container within a bundle that defines " +
                            "a public API consisting of shapes and events. It organizes related data structures and signals " +
                            "that are intended to be reachable by other bundles through a shared interface. In <code " +
                            "class=\"inline-code\">Core.vein</code>, publicators like <code " +
                            "class=\"inline-code\">Lifecycle</code> and <code class=\"inline-code\">Meta</code> categorize " +
                            "different domains of the standard library.")
            bring CodeBlock("publicator Meta {\n" +
                            "    shared(&quot;A human-readable name for an identity.&quot;)\n" +
                            "    shape $Name { text: string }\n" +
                            "}")
            bring Subsubheading("Shared Annotation: <code class=\"inline-code\">shared</code>")
            bring Paragraph("The <code class=\"inline-code\">shared</code> keyword provides a human-readable description for an " +
                            "API element that is exposed to the cross-bundle public API. It functions as both documentation " +
                            "and a visibility modifier, ensuring that the annotated event or shape is discoverable by the " +
                            "<code class=\"inline-code\">veinc</code> compiler and listed in symbol lookups across different " +
                            "software bundles.")
            bring CodeBlock("shared(&quot;An identity came into existence.&quot;)\n" +
                            "event @Spawned { entity: Entity }")
            bring Subsubheading("Event Declaration: <code class=\"inline-code\">event</code>")
            bring Paragraph("Events, denoted by the <code class=\"inline-code\">@</code> prefix, are message types used for " +
                            "communication between different parts of a system. They represent occurrences at a specific " +
                            "point in time. In the <code class=\"inline-code\">Lifecycle</code> publicator, events carry an " +
                            "<code class=\"inline-code\">entity</code> field of type <code class=\"inline-code\">Entity</code> to " +
                            "inform listeners which specific identity the event concerns, such as when an object is created " +
                            "or activated.")
            bring CodeBlock("publicator Lifecycle {\n" +
                            "    event @Spawned { entity: Entity }\n" +
                            "    event @Destroyed { entity: Entity }\n" +
                            "    event @Enabled { entity: Entity }\n" +
                            "    event @Disabled { entity: Entity }\n" +
                            "}")
            bring Subsubheading("Shape Declaration: <code class=\"inline-code\">shape</code>")
            bring Paragraph("Shapes, denoted by the <code class=\"inline-code\">$</code> prefix, define the structure of state " +
                            "or metadata associated with an identity. Unlike events, which are transient messages, shapes " +
                            "represent persistent data. They are used to model attributes like names, tags, layers, and " +
                            "quantities. In VeinScript, shapes are components in an Identity-Oriented Programming (IOP) " +
                            "model.")
            bring CodeBlock("publicator Meta {\n" +
                            "    shape $Name { text: string }\n" +
                            "    shape $Tag { value: string }\n" +
                            "    shape $Layer { index: int }\n" +
                            "}")
            bring Subsubheading("Lifecycle Event: <code class=\"inline-code\">@Spawned</code>")
            bring Paragraph("The <code class=\"inline-code\">@Spawned</code> event is triggered when a new identity comes into " +
                            "existence within the runtime. It provides a standard signal that allows disparate systems to " +
                            "initialize resources or logic associated with the newly created entity.")
            bring CodeBlock("event @Spawned { entity: Entity }")
            bring Subsubheading("Lifecycle Event: <code class=\"inline-code\">@Destroyed</code>")
            bring Paragraph("The <code class=\"inline-code\">@Destroyed</code> event signals that an identity has been removed " +
                            "from the system. This event is critical for cleanup operations, as it allows observers to tear " +
                            "down references or state associated with the entity before it is fully purged from memory.")
            bring CodeBlock("event @Destroyed { entity: Entity }")
            bring Subsubheading("Lifecycle Event: <code class=\"inline-code\">@Enabled</code>")
            bring Paragraph("The <code class=\"inline-code\">@Enabled</code> event indicates that an identity has been " +
                            "activated. This is distinct from creation; an identity can exist in a disabled state and later " +
                            "be enabled to participate in system behaviors or rendering loops.")
            bring CodeBlock("event @Enabled { entity: Entity }")
            bring Subsubheading("Lifecycle Event: <code class=\"inline-code\">@Disabled</code>")
            bring Paragraph("The <code class=\"inline-code\">@Disabled</code> event indicates that an identity has been " +
                            "deactivated without being destroyed. This allows systems to pause processing or interactions for " +
                            "a specific entity while still retaining its data and state for potential reactivation.")
            bring CodeBlock("event @Disabled { entity: Entity }")
            bring Subsubheading("Meta Shape: <code class=\"inline-code\">$Name</code>")
            bring Paragraph("The <code class=\"inline-code\">$Name</code> shape provides a canonical way to assign a " +
                            "human-readable string identifier to an entity. It is used primarily for debugging, editor " +
                            "tooling, or UI displays where a descriptive label is required for a specific identity.")
            bring CodeBlock("shape $Name { text: string }")
            bring Subsubheading("Meta Shape: <code class=\"inline-code\">$Tag</code>")
            bring Paragraph("The <code class=\"inline-code\">$Tag</code> shape allows for free-form category labeling. By " +
                            "attaching a tag to an identity, developers can group entities into arbitrary categories that can " +
                            "be queried or filtered by other systems during runtime.")
            bring CodeBlock("shape $Tag { value: string }")
            bring Subsubheading("Meta Shape: <code class=\"inline-code\">$Layer</code>")
            bring Paragraph("The <code class=\"inline-code\">$Layer</code> shape defines a sorting or rendering index for an " +
                            "identity. This is commonly used in graphical or organizational systems to determine the priority " +
                            "or depth at which an entity should be processed or displayed.")
            bring CodeBlock("shape $Layer { index: int }")
            bring Subsubheading("Quantity Shape: <code class=\"inline-code\">$Pool</code>")
            bring Paragraph("The <code class=\"inline-code\">$Pool</code> shape represents a numerical resource that has both a " +
                            "current value and a maximum capacity, such as health or energy. It utilizes the <code " +
                            "class=\"inline-code\">folds sum</code> keyword on the <code class=\"inline-code\">current</code> " +
                            "field, meaning that multiple independent contributors can add to or subtract from the pool " +
                            "simultaneously, and the engine will reconcile these into a single sum.")
            bring CodeBlock("shape $Pool { current: int folds sum, max: int }")
            bring Subsubheading("Quantity Shape: <code class=\"inline-code\">$Counter</code>")
            bring Paragraph("The <code class=\"inline-code\">$Counter</code> shape is a simplified additive data structure. It " +
                            "defines a single integer value that uses the <code class=\"inline-code\">folds sum</code> " +
                            "mechanic, allowing various systems to increment the total value without needing to coordinate or " +
                            "read the previous state, ensuring order-independent reconciliation.")
            bring CodeBlock("shape $Counter { value: int folds sum }")
            bring Subsubheading("Folds Mechanism: <code class=\"inline-code\">folds sum</code>")
            bring Paragraph("The <code class=\"inline-code\">folds sum</code> construct is a specialized modifier for shape " +
                            "fields. It enables the &quot;folds&quot; domain logic, where the final value of a field is the " +
                            "additive sum of all concurrent writes across all contributors. This allows for distributed, " +
                            "conflict-free state updates where the order of operations does not affect the final result.")
            bring CodeBlock("// Inside a shape definition\n" +
                            "value: int folds sum")
            bring Subsubheading("Relation Shape: <code class=\"inline-code\">$Parent</code>")
            bring Paragraph("The <code class=\"inline-code\">$Parent</code> shape establishes a hierarchical relationship " +
                            "between identities. By storing an <code class=\"inline-code\">Entity</code> reference in the <code " +
                            "class=\"inline-code\">of</code> field, it explicitly links the current identity to another " +
                            "identity that acts as its logical parent in a hierarchy.")
            bring CodeBlock("shape $Parent { of: Entity }")
            bring Subsubheading("Relation Shape: <code class=\"inline-code\">$Owner</code>")
            bring Paragraph("The <code class=\"inline-code\">$Owner</code> shape defines an ownership link, indicating which " +
                            "<code class=\"inline-code\">Entity</code> is responsible for or &quot;owns&quot; the identity " +
                            "carrying this shape. This is distinct from a parent/child hierarchy and is often used for " +
                            "authorization, lifetime management, or attribution.")
            bring CodeBlock("shape $Owner { by: Entity }")
            bring Subsubheading("Primitive Types: <code class=\"inline-code\">int</code>, <code class=\"inline-code\">string</code>, " +
                                "<code class=\"inline-code\">Entity</code>")
            bring Paragraph("<code class=\"inline-code\">Core.vein</code> utilizes the fundamental primitive types of " +
                            "VeinScript. <code class=\"inline-code\">int</code> represents signed integers used for indices and " +
                            "quantities; <code class=\"inline-code\">string</code> represents UTF-8 text data; and <code " +
                            "class=\"inline-code\">Entity</code> is the built-in type representing a unique identity handle " +
                            "within the runtime environment.")
            bring CodeBlock("shape $Example {\n" +
                            "    id: Entity,\n" +
                            "    count: int,\n" +
                            "    label: string\n" +
                            "}")
            bring Raw("<span id='sec14'></span>")
            bring Subheading("File: Console.vein")
            bring Paragraph("The <code class=\"inline-code\">Console.vein</code> file defines the standard interface for " +
                            "terminal-based I/O within the VeinScript environment. Rather than using traditional blocking " +
                            "function calls, this implementation treats the console as an event-driven system. The runtime " +
                            "bridges standard output (stdout) and standard input (stdin) to specific events defined within " +
                            "the <code class=\"inline-code\">Io</code> publicator, allowing programs to communicate with users " +
                            "and other console processes via a messaging architecture.")
            bring Subsubheading("Bundle: Console")
            bring Paragraph("The <code class=\"inline-code\">bundle</code> keyword defines the top-level namespace for the " +
                            "console library. It organizes the code under the <code class=\"inline-code\">Console</code> name, " +
                            "attributed to the <code class=\"inline-code\">Vein</code> authoring entity. All console-related " +
                            "logic is encapsulated within this block.")
            bring CodeBlock("bundle Console by Vein {\n" +
                            "    // Console logic is defined here\n" +
                            "}")
            bring Subsubheading("Publicator: Io")
            bring Paragraph("A <code class=\"inline-code\">publicator</code> acts as the primary container for shared events " +
                            "and static functions. The <code class=\"inline-code\">Io</code> publicator handles the core logic " +
                            "for writing text, reading input, and managing multiple console windows.")
            bring CodeBlock("publicator Io {\n" +
                            "    // Events and functions for I/O\n" +
                            "}")
            bring Subsubheading("Event: @Print")
            bring Paragraph("The <code class=\"inline-code\">@Print</code> event is the primary mechanism for writing text to " +
                            "the standard output. When a program emits this event, the runtime captures the <code " +
                            "class=\"inline-code\">text</code> field and displays it in the terminal window.")
            bring CodeBlock("shared(&quot;Write a line of text to the console (stdout).&quot;)\n" +
                            "event @Print { text: string }")
            bring Subsubheading("Event: @Input")
            bring Paragraph("The <code class=\"inline-code\">@Input</code> event represents data coming into the program from " +
                            "the user. The runtime triggers this event every time a user types a line into the terminal and " +
                            "presses enter, passing the resulting string into the <code class=\"inline-code\">text</code> " +
                            "field.")
            bring CodeBlock("shared(&quot;A line of text the user typed at the console (stdin).&quot;)\n" +
                            "event @Input { text: string }")
            bring Subsubheading("Builder: Line")
            bring Paragraph("The <code class=\"inline-code\">Line</code> builder provides a declarative way to emit print " +
                            "events. Using the <code class=\"inline-code\">bring</code> keyword with this builder allows a " +
                            "developer to treat a line of text as a resource to be realized in the console output.")
            bring CodeBlock("shared(&quot;Write a line to the console — `bring Line(\\&quot;…\\&quot;)` emits @Print { text }.&quot;)\n" +
                            "builder Line { text: string   line = text }")
            bring Subsubheading("Event: @Console")
            bring Paragraph("This event is used to spawn new named console applications. It uses the <code " +
                            "class=\"inline-code\">Mark</code> type to identify the new console. Unlike strings, a <code " +
                            "class=\"inline-code\">Mark</code> represents a unique identity (e.g., <code " +
                            "class=\"inline-code\">#Server</code>). The <code class=\"inline-code\">firsttext</code> parameter " +
                            "specifies the initial message displayed when the new console launches.")
            bring CodeBlock("shared(&quot;A named console application to spawn (name identifies it; firsttext is printed on start).&quot;)\n" +
                            "event @Console { name: Mark, firsttext: string }")
            bring Subsubheading("Event: @Send")
            bring Paragraph("The <code class=\"inline-code\">@Send</code> event enables inter-console communication. By " +
                            "emitting this event with a destination <code class=\"inline-code\">Mark</code>, a program can " +
                            "route a line of text to a different console process that has been spawned by the runtime.")
            bring CodeBlock("shared(&quot;Send a line to another console — emit @Send { to, text } delivers it to console `to`.&quot;)\n" +
                            "event @Send { to: Mark, text: string }")
            bring Subsubheading("Event: @Message")
            bring Paragraph("The <code class=\"inline-code\">@Message</code> event is the counterpart to <code " +
                            "class=\"inline-code\">@Send</code>. A program &quot;hears&quot; this event whenever another " +
                            "console process sends it a message. It includes the <code class=\"inline-code\">from</code> field " +
                            "to identify the sender and the <code class=\"inline-code\">text</code> field for the message " +
                            "content.")
            bring CodeBlock("shared(&quot;A message received from another console — hear @Message { from, text }.&quot;)\n" +
                            "event @Message { from: Mark, text: string }")
            bring Subsubheading("Builder: Console")
            bring Paragraph("The <code class=\"inline-code\">Console</code> builder is the declarative constructor for new " +
                            "console windows. Invoking <code class=\"inline-code\">bring Console</code> with a <code " +
                            "class=\"inline-code\">Mark</code> identity and initial text will trigger the runtime to spawn a " +
                            "separate terminal interface for that identity.")
            bring CodeBlock("shared(&quot;Build a named console application — `bring Console(#Server, \\&quot;ready\\&quot;)` spawns its own window.&quot;)\n" +
                            "builder Console { name: Mark, firsttext: string }")
            bring Subsubheading("Static Function: print")
            bring Paragraph("This static function (SF) provides a standard procedural wrapper around the <code " +
                            "class=\"inline-code\">@Print</code> event. It simplifies the syntax for writing to the console by " +
                            "allowing a direct function call instead of a manual event emission.")
            bring CodeBlock("shared(&quot;Write a line to this console.&quot;)\n" +
                            "SF print(text: string) { emit @Print { text: text } }")
            bring Subsubheading("Static Function: send")
            bring Paragraph("The <code class=\"inline-code\">send</code> static function is a helper for communicating with " +
                            "other console identities. It wraps the <code class=\"inline-code\">@Send</code> event, taking a " +
                            "destination <code class=\"inline-code\">Mark</code> and the string content as arguments.")
            bring CodeBlock("shared(&quot;Send a line to another console by address.&quot;)\n" +
                            "SF send(dest: Mark, text: string) { emit @Send { to: dest, text: text } }")
            bring Subsubheading("Static Function: spawn")
            bring Paragraph("The <code class=\"inline-code\">spawn</code> static function programmatically triggers the " +
                            "creation of a new console window. It acts as a functional wrapper for the <code " +
                            "class=\"inline-code\">@Console</code> event, requiring a unique identity and starting text.")
            bring CodeBlock("shared(&quot;Spawn a named console window.&quot;)\n" +
                            "SF spawn(name: Mark, firsttext: string) { emit @Console { name: name, firsttext: firsttext } }")
            bring Paragraph("---")
            bring Heading("Consolidated Reference")
            bring Raw("<span id='sec15'></span>")
            bring Subheading("Keywords")
            bring Subsubheading("and")
            bring Paragraph("Syntax: <code class=\"inline-code\">expr and expr</code>")
            bring Paragraph("Description: A logical conjunction operator that evaluates to true only if both expressions are " +
                            "true. It uses short-circuit evaluation.")
            bring Paragraph("Example:")
            bring CodeBlock("if hp &gt; 0 and alive == true\n" +
                            "    emit @Update\n" +
                            "end")
            bring Subsubheading("app")
            bring Paragraph("Syntax: <code class=\"inline-code\">app Name { ... }</code>")
            bring Paragraph("Description: Defines a project manifest that lists the bundles composing a program. Used for " +
                            "cross-bundle discovery.")
            bring Paragraph("Example:")
            bring CodeBlock("app MyGame {\n" +
                            "    load &quot;Core.vein&quot;\n" +
                            "    load &quot;Math.vein&quot;\n" +
                            "}")
            bring Subsubheading("as")
            bring Paragraph("Syntax: <code class=\"inline-code\">target X as name</code>, <code class=\"inline-code\">use X as " +
                            "Y</code>, <code class=\"inline-code\">hear @E as e</code>")
            bring Paragraph("Description: Used to create an alias or bind an identity/event payload to a local name within a " +
                            "block. In <code class=\"inline-code\">target</code> blocks, it is mandatory.")
            bring Paragraph("Example:")
            bring CodeBlock("target $Health as self\n" +
                            "    self.Health.hp -= 1\n" +
                            "end")
            bring Subsubheading("attach")
            bring Paragraph("Syntax: <code class=\"inline-code\">attach $Shape to entity { ... }</code>")
            bring Paragraph("Description: Adds a component shape to an identity. If the shape has fields, an initialization " +
                            "block can follow.")
            bring Paragraph("Example:")
            bring CodeBlock("attach $Position to self { x: 0.0, y: 0.0, z: 0.0 }")
            bring Subsubheading("break")
            bring Paragraph("Syntax: <code class=\"inline-code\">break</code>")
            bring Paragraph("Description: Immediately terminates the nearest enclosing loop (<code " +
                            "class=\"inline-code\">while</code>, <code class=\"inline-code\">repeat</code>, or <code " +
                            "class=\"inline-code\">target</code>).")
            bring Paragraph("Example:")
            bring CodeBlock("while true\n" +
                            "    if found { break }\n" +
                            "end")
            bring Subsubheading("bring")
            bring Paragraph("Syntax: <code class=\"inline-code\">bring BuilderName(...)</code>, <code class=\"inline-code\">bring " +
                            "N BuilderName(...)</code>, <code class=\"inline-code\">bring " +
                            "*Author.Bundle.&amp;Builder(...)</code>")
            bring Paragraph("Description: Instantiates a builder. It desugars to emitting the event associated with the " +
                            "builder. Supports the <code class=\"inline-code\">?</code> fill-the-rest sigil.")
            bring Paragraph("Example:")
            bring CodeBlock("bring 10 &amp;Button(&quot;Click Me&quot;)\n" +
                            "bring *Vein.Console.Io.&amp;Console(#Server, &quot;Ready&quot;)")
            bring Subsubheading("bundle")
            bring Paragraph("Syntax: <code class=\"inline-code\">bundle Name [by Author] { ... }</code>")
            bring Paragraph("Description: The primary unit of code organization. Contains publicators, shards, and data " +
                            "declarations. The <code class=\"inline-code\">by</code> keyword allows for collision-safe naming.")
            bring Paragraph("Example:")
            bring CodeBlock("bundle Combat by yolan {\n" +
                            "    publicator Stats { ... }\n" +
                            "}")
            bring Subsubheading("by")
            bring Paragraph("Syntax: <code class=\"inline-code\">bundle Name by Author</code>")
            bring Paragraph("Description: Specifies the author of a bundle to create a fully qualified namespace path (<code " +
                            "class=\"inline-code\">*Author.Bundle</code>).")
            bring Paragraph("Example:")
            bring CodeBlock("bundle Core by Vein { ... }")
            bring Subsubheading("chance")
            bring Paragraph("Syntax: <code class=\"inline-code\">chance N% { ... }</code>")
            bring Paragraph("Description: A probabilistic branching statement. The block inside only executes if the random " +
                            "roll (0.0 to 1.0) is less than the specified percentage.")
            bring Paragraph("Example:")
            bring CodeBlock("chance 30%\n" +
                            "    emit @CriticalHit { multiplier: 2.0 }\n" +
                            "end")
            bring Subsubheading("continue")
            bring Paragraph("Syntax: <code class=\"inline-code\">continue</code>")
            bring Paragraph("Description: Skips the remaining statements in the current iteration of a loop and moves to the " +
                            "next step.")
            bring Paragraph("Example:")
            bring CodeBlock("repeat 10 as i\n" +
                            "    if i % 2 == 0 { continue }\n" +
                            "    print(i)\n" +
                            "end")
            bring Subsubheading("count")
            bring Paragraph("Syntax: <code class=\"inline-code\">count(collection)</code>")
            bring Paragraph("Description: A built-in function or property used to retrieve the number of items in a " +
                            "collection or query.")
            bring Paragraph("Example:")
            bring CodeBlock("let n = count(enemies)")
            bring Subsubheading("destroy")
            bring Paragraph("Syntax: <code class=\"inline-code\">destroy entity</code>")
            bring Paragraph("Description: Removes an identity from the runtime environment. Triggers lifecycle events like " +
                            "<code class=\"inline-code\">@Destroyed</code>.")
            bring Paragraph("Example:")
            bring CodeBlock("target $Health as self\n" +
                            "    if self.Health.hp &lt;= 0 { destroy self }\n" +
                            "end")
            bring Subsubheading("each")
            bring Paragraph("Syntax: <code class=\"inline-code\">each tick { ... }</code>, <code class=\"inline-code\">each frame " +
                            "{ ... }</code>")
            bring Paragraph("Description: Defines a shard schedule that executes every simulation tick or every render frame.")
            bring Paragraph("Example:")
            bring CodeBlock("shard Mover {\n" +
                            "    each tick {\n" +
                            "        target $Position as self { ... }\n" +
                            "    }\n" +
                            "}")
            bring Subsubheading("else")
            bring Paragraph("Syntax: <code class=\"inline-code\">if cond { ... } else { ... }</code>, <code " +
                            "class=\"inline-code\">match x { when p { ... } else { ... } }</code>")
            bring Paragraph("Description: Provides a fallback block for conditional statements when the primary condition or " +
                            "pattern matches fail.")
            bring Paragraph("Example:")
            bring CodeBlock("if active { stop() } else { start() }")
            bring Subsubheading("emit")
            bring Paragraph("Syntax: <code class=\"inline-code\">emit @Event { field: value, ... }</code>")
            bring Paragraph("Description: Sends a message to the event loop. Can target specific identities or broadcast " +
                            "globally.")
            bring Paragraph("Example:")
            bring CodeBlock("emit @Print { text: &quot;Hello World&quot; }")
            bring Subsubheading("enum")
            bring Paragraph("Syntax: <code class=\"inline-code\">enum Name { Case1, Case2 }</code>")
            bring Paragraph("Description: Declares a set of discrete named constants. In VeinScript, enums must be declared " +
                            "inside a <code class=\"inline-code\">shape</code>.")
            bring Paragraph("Example:")
            bring CodeBlock("shape $Movement {\n" +
                            "    enum Direction { North, South, East, West }\n" +
                            "    facing: Direction\n" +
                            "}")
            bring Subsubheading("event")
            bring Paragraph("Syntax: <code class=\"inline-code\">event @Name { fields }</code>")
            bring Paragraph("Description: Declares a message type. Events are the primary mechanism for cross-shard and " +
                            "cross-identity communication.")
            bring Paragraph("Example:")
            bring CodeBlock("event @Damaged { amount: int, target: Entity }")
            bring Subsubheading("false")
            bring Paragraph("Syntax: <code class=\"inline-code\">false</code>")
            bring Paragraph("Description: A boolean literal representing the negative logical state.")
            bring Paragraph("Example:")
            bring CodeBlock("let isReady = false")
            bring Subsubheading("fn")
            bring Paragraph("Syntax: <code class=\"inline-code\">fn Name(params) -&gt; Type { ... }</code>")
            bring Paragraph("Description: Declares a reusable computation function. It can return values but cannot emit " +
                            "events or modify identity state directly.")
            bring Paragraph("Example:")
            bring CodeBlock("fn add(a: int, b: int) -&gt; int { return a + b }")
            bring Subsubheading("folds")
            bring Paragraph("Syntax: <code class=\"inline-code\">field: Type folds Reducer</code>")
            bring Paragraph("Description: A field modifier used in <code class=\"inline-code\">shape</code> declarations to " +
                            "specify how concurrent writes to the same field in the same tick are resolved.")
            bring Paragraph("Example:")
            bring CodeBlock("shape $Health {\n" +
                            "    hp: int folds sum\n" +
                            "}")
            bring Subsubheading("from")
            bring Paragraph("Syntax: <code class=\"inline-code\">unattach $Shape from entity</code>")
            bring Paragraph("Description: Used with <code class=\"inline-code\">unattach</code> to specify which identity is " +
                            "losing a component.")
            bring Paragraph("Example:")
            bring CodeBlock("unattach $Shield from self")
            bring Subsubheading("hear")
            bring Paragraph("Syntax: <code class=\"inline-code\">hear @Event [as name] [audience #Mark] { ... }</code>")
            bring Paragraph("Description: Registers a reaction to an event. The <code class=\"inline-code\">audience</code> " +
                            "keyword can be used to filter events by the emitter's marks.")
            bring Paragraph("Example:")
            bring CodeBlock("hear @Print as p {\n" +
                            "    // handle p.text\n" +
                            "}")
            bring Subsubheading("if")
            bring Paragraph("Syntax: <code class=\"inline-code\">if cond { ... }</code>")
            bring Paragraph("Description: A standard conditional branching statement.")
            bring Paragraph("Example:")
            bring CodeBlock("if v &lt; 0 { return 0 }")
            bring Subsubheading("let")
            bring Paragraph("Syntax: <code class=\"inline-code\">let name = expr</code>, <code class=\"inline-code\">let name: " +
                            "Type = expr</code>")
            bring Paragraph("Description: Creates an immutable local binding.")
            bring Paragraph("Example:")
            bring CodeBlock("let pi = 3.14159")
            bring Subsubheading("load")
            bring Paragraph("Syntax: <code class=\"inline-code\">load &quot;file.vein&quot; [start { ... }]</code>")
            bring Paragraph("Description: Used within an <code class=\"inline-code\">app</code> manifest to include a bundle. " +
                            "Can override the bundle's <code class=\"inline-code\">start</code> payload.")
            bring Paragraph("Example:")
            bring CodeBlock("load &quot;Combat.vein&quot; start { difficulty: 2 }")
            bring Subsubheading("map")
            bring Paragraph("Syntax: <code class=\"inline-code\">map&lt;Key, Value&gt;</code>")
            bring Paragraph("Description: A built-in generic collection type for key-value pairs.")
            bring Paragraph("Example:")
            bring CodeBlock("var scores: map&lt;string, int&gt;")
            bring Subsubheading("mark")
            bring Paragraph("Syntax: <code class=\"inline-code\">mark entity #Mark</code>")
            bring Paragraph("Description: Adds a tag (mark) to an identity. Marks represent boolean state and capabilities.")
            bring Paragraph("Example:")
            bring CodeBlock("mark self #Visible")
            bring Subsubheading("match")
            bring Paragraph("Syntax: <code class=\"inline-code\">match expr { when pattern { ... } }</code>")
            bring Paragraph("Description: A pattern matching statement, primarily used with enums.")
            bring Paragraph("Example:")
            bring CodeBlock("match facing {\n" +
                            "    when North { y -= 1 }\n" +
                            "    when South { y += 1 }\n" +
                            "}")
            bring Subsubheading("not")
            bring Paragraph("Syntax: <code class=\"inline-code\">not expr</code>")
            bring Paragraph("Description: A logical negation operator.")
            bring Paragraph("Example:")
            bring CodeBlock("if not alive { return }")
            bring Subsubheading("or")
            bring Paragraph("Syntax: <code class=\"inline-code\">expr or expr</code>")
            bring Paragraph("Description: A logical disjunction operator with short-circuit evaluation.")
            bring Paragraph("Example:")
            bring CodeBlock("if isDead or isExhausted { stop() }")
            bring Subsubheading("publicator")
            bring Paragraph("Syntax: <code class=\"inline-code\">publicator Name { ... }</code>")
            bring Paragraph("Description: A grouping construct within a bundle used to organize exported members. Shards " +
                            "cannot be <code class=\"inline-code\">shared</code> and thus cannot be inside publicators.")
            bring Paragraph("Example:")
            bring CodeBlock("publicator Io {\n" +
                            "    shared(&quot;Write to console&quot;)\n" +
                            "    event @Print { text: string }\n" +
                            "}")
            bring Subsubheading("random")
            bring Paragraph("Syntax: <code class=\"inline-code\">random()</code>")
            bring Paragraph("Description: A built-in function that returns a random float between 0.0 and 1.0.")
            bring Paragraph("Example:")
            bring CodeBlock("if random() &lt; 0.5 { flip() }")
            bring Subsubheading("repeat")
            bring Paragraph("Syntax: <code class=\"inline-code\">repeat N [as i] { ... }</code>")
            bring Paragraph("Description: A counted loop that executes a block N times.")
            bring Paragraph("Example:")
            bring CodeBlock("repeat 5 as i {\n" +
                            "    spawnParticle(i)\n" +
                            "}")
            bring Subsubheading("return")
            bring Paragraph("Syntax: <code class=\"inline-code\">return expr</code>")
            bring Paragraph("Description: Exits the current <code class=\"inline-code\">fn</code> and provides a result to the " +
                            "caller.")
            bring Paragraph("Example:")
            bring CodeBlock("fn square(n: int) -&gt; int { return n * n }")
            bring Subsubheading("settled")
            bring Paragraph("Syntax: <code class=\"inline-code\">settled { ... }</code>")
            bring Paragraph("Description: A shard schedule that runs once per tick, specifically after all <code " +
                            "class=\"inline-code\">each tick</code> contributions have been folded.")
            bring Paragraph("Example:")
            bring CodeBlock("shard Reaper {\n" +
                            "    settled {\n" +
                            "        target $Health as self {\n" +
                            "            if self.Health.hp &lt;= 0 { destroy self }\n" +
                            "        }\n" +
                            "    }\n" +
                            "}")
            bring Subsubheading("SF")
            bring Paragraph("Syntax: <code class=\"inline-code\">SF Name(params) { ... }</code>")
            bring Paragraph("Description: Declares a &quot;Shard Function.&quot; It can emit events but cannot return values. " +
                            "Used for reusable side-effect sequences.")
            bring Paragraph("Example:")
            bring CodeBlock("SF warn(msg: string) {\n" +
                            "    emit @DiagnosticRaised { severity: 1, message: msg }\n" +
                            "}")
            bring Subsubheading("shape")
            bring Paragraph("Syntax: <code class=\"inline-code\">shape $Name { fields }</code>")
            bring Paragraph("Description: Declares a data component that can be attached to an identity.")
            bring Paragraph("Example:")
            bring CodeBlock("shape $Position { x: float, y: float }")
            bring Subsubheading("shard")
            bring Paragraph("Syntax: <code class=\"inline-code\">shard Name { ... }</code>")
            bring Paragraph("Description: The primary unit of behavior. Shards target identities and react to events.")
            bring Paragraph("Example:")
            bring CodeBlock("shard Gravity {\n" +
                            "    each tick {\n" +
                            "        target $Velocity as v { v.y -= 9.8 }\n" +
                            "    }\n" +
                            "}")
            bring Subsubheading("shared")
            bring Paragraph("Syntax: <code class=\"inline-code\">shared(&quot;doc string&quot;)</code>")
            bring Paragraph("Description: An annotation used inside a publicator to export a member (shape, event, builder, " +
                            "fn, SF) across bundle boundaries.")
            bring Paragraph("Example:")
            bring CodeBlock("publicator Math {\n" +
                            "    shared(&quot;Absolute value&quot;)\n" +
                            "    fn abs(n: float) -&gt; float { ... }\n" +
                            "}")
            bring Subsubheading("start")
            bring Paragraph("Syntax: <code class=\"inline-code\">start @Event { payload }</code>")
            bring Paragraph("Description: Defines the entry point of a bundle. Fired when the bundle is loaded.")
            bring Paragraph("Example:")
            bring CodeBlock("start @Boot { message: &quot;System Ready&quot; }")
            bring Subsubheading("sync")
            bring Paragraph("Syntax: <code class=\"inline-code\">sync</code>")
            bring Paragraph("Description: A shard modifier used to provide scheduling hints to the runtime, typically related " +
                            "to parallelism or ordering.")
            bring Paragraph("Example:")
            bring CodeBlock("shard Physics sync { ... }")
            bring Subsubheading("target")
            bring Paragraph("Syntax: <code class=\"inline-code\">target Filter as Name { ... }</code>")
            bring Paragraph("Description: Iterates over every identity in the world that matches the specified filter (Shapes " +
                            "and Marks).")
            bring Paragraph("Example:")
            bring CodeBlock("target $Health #Enemy as target {\n" +
                            "    target.Health.hp -= 10\n" +
                            "}")
            bring Subsubheading("tick")
            bring Paragraph("Syntax: <code class=\"inline-code\">each tick { ... }</code>")
            bring Paragraph("Description: Contextual keyword used with <code class=\"inline-code\">each</code> to define the " +
                            "simulation frame cadence.")
            bring Paragraph("Example:")
            bring CodeBlock("each tick { step() }")
            bring Subsubheading("to")
            bring Paragraph("Syntax: <code class=\"inline-code\">attach $Shape to entity</code>")
            bring Paragraph("Description: Used with <code class=\"inline-code\">attach</code> to specify the identity receiving " +
                            "a component.")
            bring Paragraph("Example:")
            bring CodeBlock("attach $Velocity to self")
            bring Subsubheading("true")
            bring Paragraph("Syntax: <code class=\"inline-code\">true</code>")
            bring Paragraph("Description: A boolean literal representing the positive logical state.")
            bring Paragraph("Example:")
            bring CodeBlock("let running = true")
            bring Subsubheading("type")
            bring Paragraph("Syntax: <code class=\"inline-code\">type Name { fields }</code>")
            bring Paragraph("Description: Declares a plain value-type structure (struct). Unlike shapes, these are not " +
                            "attached to identities as components but used as data containers.")
            bring Paragraph("Example:")
            bring CodeBlock("type Config { version: int, debug: bool }")
            bring Subsubheading("unattach")
            bring Paragraph("Syntax: <code class=\"inline-code\">unattach $Shape from entity</code>")
            bring Paragraph("Description: Removes a component shape from an identity.")
            bring Paragraph("Example:")
            bring CodeBlock("unattach $Poison from self")
            bring Subsubheading("unmark")
            bring Paragraph("Syntax: <code class=\"inline-code\">unmark entity #Mark</code>")
            bring Paragraph("Description: Removes a tag (mark) from an identity.")
            bring Paragraph("Example:")
            bring CodeBlock("unmark self #Poisoned")
            bring Subsubheading("use")
            bring Paragraph("Syntax: <code class=\"inline-code\">use BundleName</code>")
            bring Paragraph("Description: Directs the compiler to resolve symbols from another bundle.")
            bring Paragraph("Example:")
            bring CodeBlock("use Vein.Math")
            bring Subsubheading("var")
            bring Paragraph("Syntax: <code class=\"inline-code\">var name = expr</code>, <code class=\"inline-code\">var name: " +
                            "Type = expr</code>")
            bring Paragraph("Description: Creates a mutable local binding or state field.")
            bring Paragraph("Example:")
            bring CodeBlock("var score = 0\n" +
                            "score += 10")
            bring Subsubheading("when")
            bring Paragraph("Syntax: <code class=\"inline-code\">when pattern { ... }</code>")
            bring Paragraph("Description: Defines an arm within a <code class=\"inline-code\">match</code> block.")
            bring Paragraph("Example:")
            bring CodeBlock("match status {\n" +
                            "    when Active { doWork() }\n" +
                            "}")
            bring Subsubheading("while")
            bring Paragraph("Syntax: <code class=\"inline-code\">while cond { ... }</code>")
            bring Paragraph("Description: A conditional loop that repeats as long as the condition evaluates to true.")
            bring Paragraph("Example:")
            bring CodeBlock("while count &gt; 0 {\n" +
                            "    process()\n" +
                            "    count -= 1\n" +
                            "}")
            bring Raw("<span id='sec16'></span>")
            bring Subheading("Syntax")
            bring Subsubheading("Identity Declarations")
            bring Paragraph("Identities in VeinScript are represented by the <code class=\"inline-code\">Entity</code> type. " +
                            "They are not declared as static classes but come into existence through spawning (via <code " +
                            "class=\"inline-code\">start</code> or <code class=\"inline-code\">bring</code>). Every identity is a " +
                            "unique integer ID in the runtime registry.")
            bring CodeBlock("event @Spawned { entity: Entity }")
            bring Subsubheading("Trait/Shape Composition")
            bring Paragraph("Traits are represented by Marks (<code class=\"inline-code\">#Mark</code>), and data is " +
                            "represented by Shapes (<code class=\"inline-code\">$Shape</code>). Composition is dynamic. An " +
                            "identity &quot;is&quot; what it currently carries.")
            bring CodeBlock("shape $Position { x: float, y: float }\n" +
                            "builder Player {\n" +
                            "    $Position x: 0.0 y: 0.0\n" +
                            "    mark #Player\n" +
                            "}")
            bring Subsubheading("Behavior Definitions")
            bring Paragraph("All behavior lives in <code class=\"inline-code\">shard</code> blocks. A shard contains triggers " +
                            "(schedules or event listeners) and logic that targets identities.")
            bring CodeBlock("shard Movement {\n" +
                            "    each tick {\n" +
                            "        target $Position $Velocity as self {\n" +
                            "            self.Position.x += self.Velocity.x\n" +
                            "        }\n" +
                            "    }\n" +
                            "}")
            bring Subsubheading("Vein Flow Statements")
            bring Paragraph("Logic flows through <code class=\"inline-code\">emit</code> and <code " +
                            "class=\"inline-code\">hear</code>. Emitters do not know their hearers; they simply publish an " +
                            "occurrence.")
            bring CodeBlock("shard Logger {\n" +
                            "    hear @Print as p {\n" +
                            "        // execute log logic\n" +
                            "    }\n" +
                            "}\n" +
                            "\n" +
                            "shard App {\n" +
                            "    hear @Boot {\n" +
                            "        emit @Print { text: &quot;Starting...&quot; }\n" +
                            "    }\n" +
                            "}")
            bring Subsubheading("Target and Bring")
            bring Paragraph("<code class=\"inline-code\">target</code> is the primary iteration verb. It queries the world for " +
                            "matches. <code class=\"inline-code\">bring</code> is the primary instantiation verb.")
            bring CodeBlock("shard Spawner {\n" +
                            "    hear @RequestSpawn {\n" +
                            "        bring 5 &amp;EnemyWarrior\n" +
                            "    }\n" +
                            "}\n" +
                            "\n" +
                            "shard AI {\n" +
                            "    each tick {\n" +
                            "        target $Position #Enemy as foe {\n" +
                            "            // logic per foe\n" +
                            "        }\n" +
                            "    }\n" +
                            "}")
            bring Subsubheading("Attach and Unattach")
            bring Paragraph("These keywords modify the &quot;archetype&quot; of an identity at runtime by adding or removing " +
                            "component shapes.")
            bring CodeBlock("shard PowerUp {\n" +
                            "    hear @Pickup as p {\n" +
                            "        attach $Shield to p.target { strength: 100 }\n" +
                            "    }\n" +
                            "}")
            bring Subsubheading("Imports and Exports")
            bring Paragraph("Members are exported using the <code class=\"inline-code\">shared</code> keyword inside a <code " +
                            "class=\"inline-code\">publicator</code>. They are imported using the <code " +
                            "class=\"inline-code\">use</code> keyword or referenced via fully qualified star-paths (<code " +
                            "class=\"inline-code\">*Author.Bundle.Publicator.Member</code>).")
            bring CodeBlock("use Vein.Math\n" +
                            "let v = *Vein.Math.Scalars.clamp(x, 0, 1)")
            bring Subsubheading("Type Annotations")
            bring Paragraph("VeinScript uses <code class=\"inline-code\">name: Type</code> syntax. Types can be primitives " +
                            "(<code class=\"inline-code\">int</code>, <code class=\"inline-code\">float</code>, <code " +
                            "class=\"inline-code\">string</code>, <code class=\"inline-code\">bool</code>), sigil-types (<code " +
                            "class=\"inline-code\">Entity</code>, <code class=\"inline-code\">Mark</code>), or generic " +
                            "collections.")
            bring CodeBlock("var items: list&lt;string&gt;\n" +
                            "fn process(id: Entity, msg: string) -&gt; bool { ... }")
            bring Subsubheading("Pattern Matching")
            bring Paragraph("The <code class=\"inline-code\">match</code> keyword branches based on enum values or literals.")
            bring CodeBlock("match state {\n" +
                            "    when Idle { wait() }\n" +
                            "    when Busy { work() }\n" +
                            "    else { reset() }\n" +
                            "}")
            bring Subsubheading("Combinators (AND/NOT)")
            bring Paragraph("<code class=\"inline-code\">target</code> filters allow combining multiple shapes and marks. By " +
                            "default, multiple sigils are AND-ed. <code class=\"inline-code\">NOT</code> (often represented by " +
                            "the absence or explicit negative constraints in future dialects) filters out identities.")
            bring CodeBlock("target $Health #Enemy #Moving as e { ... } // AND")
            bring Subsubheading("Folds and Determinism")
            bring Paragraph("The <code class=\"inline-code\">folds</code> keyword handles the &quot;Multi-Writer&quot; problem. " +
                            "When multiple shards write to <code class=\"inline-code\">hp: int folds sum</code> in the same " +
                            "tick, the values are added together rather than overwriting each other.")
            bring CodeBlock("shape $Stats {\n" +
                            "    score: int folds sum\n" +
                            "}")
            bring Raw("<span id='sec17'></span>")
            bring Subheading("IR")
            bring Subsubheading("ASCII Tree Format")
            bring Paragraph("VeinIR is rendered as an ASCII tree where structure is shown via vertical pipes and dashes.")
            bring Open("ul")
                bring ListItem("<code class=\"inline-code\">|--- </code> : Child with siblings.")
                bring ListItem("`<code class=\"inline-code\"> </code>--- `` : Last child.")
                bring ListItem("<code class=\"inline-code\">|    </code> : Continuation of a non-last child.")
            bring Close("ul")
            bring Subsubheading("Line Grammar")
            bring Paragraph("Each line follows: <code class=\"inline-code\">&lt;Kind&gt; &lt;primary&gt; [= " +
                            "&lt;inline-value&gt;]  [attr=val]*  @line:col</code>.")
            bring Open("ul")
                bring ListItem("Kinds: <code class=\"inline-code\">Bundle</code>, <code class=\"inline-code\">Publicator</code>, " +
                               "<code class=\"inline-code\">Shape</code>, <code class=\"inline-code\">Event</code>, <code " +
                               "class=\"inline-code\">Shard</code>, <code class=\"inline-code\">Target</code>, <code " +
                               "class=\"inline-code\">EachTick</code>, etc.")
                bring ListItem("Primary: The name or identifier of the node.")
                bring ListItem("Inline value: Leaf values like <code class=\"inline-code\">Int 5</code>.")
                bring ListItem("Attributes: Metadata like <code class=\"inline-code\">folds=sum</code> or <code " +
                               "class=\"inline-code\">audience=[#Mark]</code>.")
            bring Close("ul")
            bring Subsubheading("Kind-Attribute Catalog")
            bring Open("ul")
                bring ListItem("<code class=\"inline-code\">Field</code>: <code class=\"inline-code\">folds=&lt;reducer&gt;</code> " +
                               "(sum, min, max, replace, first, all, any).")
                bring ListItem("<code class=\"inline-code\">Shard</code>: <code class=\"inline-code\">carries=[$Shape #Mark " +
                               "...]</code> (match set).")
                bring ListItem("<code class=\"inline-code\">Hear</code>: <code class=\"inline-code\">audience=[#Mark ...]</code> " +
                               "(barrier filter).")
                bring ListItem("<code class=\"inline-code\">Bring</code>: <code class=\"inline-code\">count=&lt;n&gt;</code>.")
                bring ListItem("<code class=\"inline-code\">Builder</code>: <code " +
                               "class=\"inline-code\">kind=&lt;html|script|style&gt;</code>, <code " +
                               "class=\"inline-code\">params=(...)</code>.")
            bring Close("ul")
            bring Subsubheading("IR Example (Full Shard)")
            bring CodeBlock("Shard Drain  carries=[$Health #Enemy] @10:5\n" +
                            "|--- Target @11:9\n" +
                            "|    `--- Body @11:23\n" +
                            "|         |--- Assign -= @12:13\n" +
                            "|         |    |--- Path @12:13\n" +
                            "|         |    |    |--- Ref self @12:13\n" +
                            "|         |    |    `--- Ref Health.hp @12:18\n" +
                            "|         |    `--- Int 1 @12:31\n" +
                            "|         `--- Chance @13:13\n" +
                            "|              |--- Percent 0.3 @13:20\n" +
                            "|              `--- Body @13:25\n" +
                            "|                   `--- Emit @Damaged @13:32\n" +
                            "|                        |--- Arg amount = Int 5 @13:48\n" +
                            "|                        `--- Arg victim = Ref self @13:59\n" +
                            "`--- Settled @15:5\n" +
                            "     `--- Body @15:13\n" +
                            "          `--- Target @16:9\n" +
                            "               `--- If @16:25\n" +
                            "                    |--- Cond &lt;= @16:28\n" +
                            "                    |    |--- Path @16:28\n" +
                            "                    |    |    |--- Ref self @16:28\n" +
                            "                    |    |    `--- Ref Health.hp @16:33\n" +
                            "                    |    `--- Int 0 @16:46\n" +
                            "                    `--- Then @16:49\n" +
                            "                         `--- Mark #Dead @16:51\n" +
                            "                              `--- Ref self @16:56")
            bring Raw("<span id='sec18'></span>")
            bring Subheading("Runtime")
            bring Subsubheading("Execution Models")
            bring Paragraph("VeinScript utilizes two runtime modes:")
            bring Paragraph("1. <strong>Reactive Event Loop:</strong> Used for web and messaging. Events are queued; <code " +
                            "class=\"inline-code\">hear</code> handlers are invoked sequentially per event.")
            bring Paragraph("2. <strong>ECS Tick Loop:</strong> Used for simulations. Operations occur in phases: <code " +
                            "class=\"inline-code\">each tick</code> (parallel contributions) -&gt; <code " +
                            "class=\"inline-code\">barrier</code> (folding) -&gt; <code class=\"inline-code\">settled</code> " +
                            "(resolution).")
            bring Subsubheading("Scheduler and Threading")
            bring Open("ul")
                bring ListItem("<strong>Slots as Threads:</strong> A slot represents a hardware thread (typically 16).")
                bring ListItem("<strong>Steps:</strong> Each slot processes ~120 steps per tick.")
                bring ListItem("<strong>Concurrency:</strong> Concurrency occurs across slots. Same-slot execution is sequential " +
                               "and safe.")
                bring ListItem("<strong>Barrier:</strong> A &quot;Thread-Join Barrier&quot; occurs after all threads finish " +
                               "their work. This is when <code class=\"inline-code\">folds</code> and <code " +
                               "class=\"inline-code\">push</code> buffers are reconciled.")
            bring Close("ul")
            bring Subsubheading("Memory and State")
            bring Open("ul")
                bring ListItem("<strong>Registry:</strong> A global map of <code class=\"inline-code\">IdentityID -&gt; " +
                               "Archetype</code>.")
                bring ListItem("<strong>Archetype:</strong> A collection of component shapes and marks currently active on an " +
                               "identity.")
                bring ListItem("<strong>Columns:</strong> Shape data is stored in contiguous arrays (SoA - Structure of Arrays) " +
                               "for cache-efficient processing.")
            bring Close("ul")
            bring Subsubheading("Event Provenance")
            bring Paragraph("Every event automatically carries a metadata envelope:")
            bring Open("ul")
                bring ListItem("<code class=\"inline-code\">id</code>: Unique event ID.")
                bring ListItem("<code class=\"inline-code\">from</code>: The identity or shard that emitted the event.")
                bring ListItem("<code class=\"inline-code\">cause</code>: The ID of the event that triggered this logic.")
                bring ListItem("<code class=\"inline-code\">bundle</code>: The originating bundle name.")
            bring Close("ul")
            bring Subsubheading("Boot Model")
            bring Paragraph("Bundles declare a <code class=\"inline-code\">start @Event { ... }</code>. When an app is run, it " +
                            "loads every bundle and fires their respective <code class=\"inline-code\">start</code> events. App " +
                            "manifests can override these payloads at the <code class=\"inline-code\">load</code> site.")
            bring Raw("<span id='sec19'></span>")
            bring Subheading("Standard Library")
            bring Subsubheading("Vein.Core")
            bring Open("ul")
                bring ListItem("<strong>Lifecycle:</strong>")
                bring ListItem("<code class=\"inline-code\">event @Spawned { entity: Entity }</code>")
                bring ListItem("<code class=\"inline-code\">event @Destroyed { entity: Entity }</code>")
                bring ListItem("<code class=\"inline-code\">event @Enabled { entity: Entity }</code>")
                bring ListItem("<code class=\"inline-code\">event @Disabled { entity: Entity }</code>")
                bring ListItem("<strong>Meta:</strong>")
                bring ListItem("<code class=\"inline-code\">shape $Name { text: string }</code>")
                bring ListItem("<code class=\"inline-code\">shape $Tag { value: string }</code>")
                bring ListItem("<code class=\"inline-code\">shape $Layer { index: int }</code>")
                bring ListItem("<strong>Quantity:</strong>")
                bring ListItem("<code class=\"inline-code\">shape $Pool { current: int folds sum, max: int }</code>")
                bring ListItem("<code class=\"inline-code\">shape $Counter { value: int folds sum }</code>")
                bring ListItem("<strong>Relations:</strong>")
                bring ListItem("<code class=\"inline-code\">shape $Parent { of: Entity }</code>")
                bring ListItem("<code class=\"inline-code\">shape $Owner { by: Entity }</code>")
            bring Close("ul")
            bring Subsubheading("Vein.Math")
            bring Open("ul")
                bring ListItem("<strong>Values:</strong>")
                bring ListItem("<code class=\"inline-code\">shape $Vec2 { x: float, y: float }</code>")
                bring ListItem("<code class=\"inline-code\">shape $Vec3 { x: float, y: float, z: float }</code>")
                bring ListItem("<code class=\"inline-code\">shape $Color { r: float, g: float, b: float, a: float }</code>")
                bring ListItem("<code class=\"inline-code\">shape $Rect { x: float, y: float, width: float, height: float }</code>")
                bring ListItem("<strong>Scalars:</strong>")
                bring ListItem("<code class=\"inline-code\">fn clamp(v: float, lo: float, hi: float) -&gt; float</code>")
                bring ListItem("<code class=\"inline-code\">fn lerp(a: float, b: float, t: float) -&gt; float</code>")
                bring ListItem("<code class=\"inline-code\">fn min(a: float, b: float) -&gt; float</code>")
                bring ListItem("<code class=\"inline-code\">fn max(a: float, b: float) -&gt; float</code>")
                bring ListItem("<code class=\"inline-code\">fn abs(v: float) -&gt; float</code>")
            bring Close("ul")
            bring Subsubheading("Vein.Transform")
            bring Open("ul")
                bring ListItem("<strong>Spatial:</strong>")
                bring ListItem("<code class=\"inline-code\">shape $Position { x: float, y: float, z: float }</code>")
                bring ListItem("<code class=\"inline-code\">shape $Rotation { x: float, y: float, z: float }</code>")
                bring ListItem("<code class=\"inline-code\">shape $Velocity { x: float folds sum, y: float folds sum }</code>")
                bring ListItem("<strong>Motion:</strong>")
                bring ListItem("<code class=\"inline-code\">event @Moved { entity: Entity, x: float, y: float, z: float }</code>")
            bring Close("ul")
            bring Subsubheading("Vein.Input")
            bring Open("ul")
                bring ListItem("<strong>Mouse:</strong>")
                bring ListItem("<code class=\"inline-code\">event @MouseDown { $Vec2, button: int }</code>")
                bring ListItem("<code class=\"inline-code\">event @MouseMove { $Vec2 }</code>")
                bring ListItem("<strong>Keyboard:</strong>")
                bring ListItem("<code class=\"inline-code\">shape $Key { key: string }</code>")
                bring ListItem("<code class=\"inline-code\">event @KeyDown { $Key }</code>")
                bring ListItem("<code class=\"inline-code\">event @TextInput { text: string }</code>")
            bring Close("ul")
            bring Subsubheading("Vein.UI")
            bring Open("ul")
                bring ListItem("<strong>Widgets:</strong>")
                bring ListItem("<code class=\"inline-code\">shape $Text { content: string }</code>")
                bring ListItem("<code class=\"inline-code\">shape $Button { label: string }</code>")
                bring ListItem("<code class=\"inline-code\">shape $Field { value: string, placeholder: string }</code>")
                bring ListItem("<strong>Interaction:</strong>")
                bring ListItem("<code class=\"inline-code\">event @Clicked { target: Entity }</code>")
                bring ListItem("<code class=\"inline-code\">event @Hovered { target: Entity }</code>")
            bring Close("ul")
            bring Subsubheading("Vein.Web")
            bring Open("ul")
                bring ListItem("<strong>Http:</strong>")
                bring ListItem("<code class=\"inline-code\">event @Request { path: string }</code>")
                bring ListItem("<code class=\"inline-code\">event @Html { markup: string }</code>")
                bring ListItem("<code class=\"inline-code\">event @Response { status: int, body: string }</code>")
                bring ListItem("<strong>Elements:</strong>")
                bring ListItem("<code class=\"inline-code\">builder Heading { text: string }</code>")
                bring ListItem("<code class=\"inline-code\">builder Button { label: string }</code>")
                bring ListItem("<code class=\"inline-code\">builder Link { href: string, label: string }</code>")
            bring Close("ul")
            bring Subsubheading("Vein.Console")
            bring Open("ul")
                bring ListItem("<strong>Io:</strong>")
                bring ListItem("<code class=\"inline-code\">event @Print { text: string }</code>")
                bring ListItem("<code class=\"inline-code\">event @Input { text: string }</code>")
                bring ListItem("<code class=\"inline-code\">event @Send { to: Mark, text: string }</code>")
                bring ListItem("<code class=\"inline-code\">event @Message { from: Mark, text: string }</code>")
                bring ListItem("<code class=\"inline-code\">SF print(text: string)</code>")
                bring ListItem("<code class=\"inline-code\">SF spawn(name: Mark, firsttext: string)</code>")
            bring Close("ul")
            bring Subsubheading("Vein.Diagnostics")
            bring Open("ul")
                bring ListItem("<strong>Report:</strong>")
                bring ListItem("<code class=\"inline-code\">shape $Diagnostic { severity: int, message: string, line: int, column: " +
                               "int }</code>")
                bring ListItem("<code class=\"inline-code\">event @DiagnosticRaised { severity: int, message: string }</code>")
                bring ListItem("<code class=\"inline-code\">SF info(message: string)</code>")
                bring ListItem("<code class=\"inline-code\">SF error(message: string)</code>")
            bring Close("ul")
            bring Raw("<span id='sec20'></span>")
            bring Subheading("Examples")
            bring Subsubheading("Inter-Process Console Chat")
            bring CodeBlock("bundle ConsoleChat by you {\n" +
                            "\n" +
                            "    start @Boot { }\n" +
                            "    event @Boot { }\n" +
                            "\n" +
                            "    shard Launcher {\n" +
                            "        hear @Boot {\n" +
                            "            emit *Vein.Console.Io.@Print { text: &quot;Main — type here.&quot; }\n" +
                            "            emit *Vein.Console.Io.@Console { name: #Server, firsttext: &quot;Server ready.&quot; }\n" +
                            "            emit *Vein.Console.Io.@Console { name: #Client1, firsttext: &quot;Client ready.&quot; }\n" +
                            "        }\n" +
                            "    }\n" +
                            "\n" +
                            "    shard Chat {\n" +
                            "        hear *Vein.Console.Io.@Input as i {\n" +
                            "            emit *Vein.Console.Io.@Send { to: #Server, text: i.text }\n" +
                            "        }\n" +
                            "        hear *Vein.Console.Io.@Message as m {\n" +
                            "            emit *Vein.Console.Io.@Print { text: m.from + &quot; says: &quot; + m.text }\n" +
                            "        }\n" +
                            "    }\n" +
                            "}")
            bring Subsubheading("Full Simulation Shard (Trace Example)")
            bring CodeBlock("bundle Demo {\n" +
                            "    use Core\n" +
                            "    publicator DemoCore {\n" +
                            "        shared(&quot;Hit points for living identities&quot;)\n" +
                            "        shape $Health { hp: int folds sum, mp: int }\n" +
                            "        shared(&quot;Damage event&quot;)\n" +
                            "        event @Damaged { amount: int, victim: Entity }\n" +
                            "    }\n" +
                            "\n" +
                            "    shard Drain {\n" +
                            "        target $Health #Enemy as self {\n" +
                            "            each tick {\n" +
                            "                self.Health.hp -= 1\n" +
                            "                chance 30% { \n" +
                            "                    emit @Damaged { amount: 5, victim: self } \n" +
                            "                }\n" +
                            "            }\n" +
                            "        }\n" +
                            "        settled { \n" +
                            "            target $Health #Enemy as self {\n" +
                            "                if self.Health.hp &lt;= 0 { mark self #Dead } \n" +
                            "            }\n" +
                            "        }\n" +
                            "    }\n" +
                            "}")
            bring Subsubheading("Web Builder Composition")
            bring CodeBlock("bundle WebPage by user {\n" +
                            "    use Vein.Web\n" +
                            "\n" +
                            "    shard PageRouter {\n" +
                            "        hear *Vein.Web.Http.@Request as req {\n" +
                            "            emit *Vein.Web.Http.@Html { markup: &quot;&lt;div&gt;&quot; }\n" +
                            "            bring *Vein.Web.Elements.&amp;Heading(&quot;Welcome&quot;)\n" +
                            "            bring *Vein.Web.Elements.&amp;Paragraph(&quot;Path: &quot; + req.path)\n" +
                            "            emit *Vein.Web.Http.@Html { markup: &quot;&lt;/div&gt;&quot; }\n" +
                            "            emit *Vein.Web.Http.@Render { path: req.path }\n" +
                            "        }\n" +
                            "    }\n" +
                            "}")
                bring Close("article")
            bring Close("main")
            bring Footer("Transcribed verbatim from the 2026-08-29 reference snapshot")
        }
    }
}
