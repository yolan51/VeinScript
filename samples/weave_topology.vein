// samples/weave_topology.vein — `weave`: bring identities to life from a string (D23), and hold many of
// them in a `~` collection (D24).
//     veinc run samples/weave_topology.vein
//
// A server mesh and a handful of NPCs, each written as ONE string — the kind that arrives in a setting, a
// file or a network message — and brought to life by one statement each. A woven record means exactly
// the bring you would write by hand:
//
//     weave Server("S1=9811:S2; S2=9812:S1")
//
//         ==  bring Server("S1", "", 9811, [s2])        (once S2 exists — names resolve across the text)
//             bring Server("S2", "", 9812, [s1])
//
// THREE DECLARATIONS, EACH WITH ONE JOB:
//
//   format MeshList { … }          HOW a record is written: `;` between records, the name before `=`, the
//                                  values cut at `:`, a list cut at `+`. In a project this is its own file,
//                                  formats/MeshList.vein — shared like an event, found through `need`.
//   loom<MeshList> Server { … }    WHAT a record becomes: a builder's body (shapes, marks), and the format
//                                  its records are written in.
//   weave Server(servers)          DO it: one identity per record.
//
// THINGS TO SEE:
//
//   1. VALUES ARE PLACED BY TYPE. `host` has a default, so it may be missing: `S6=box.lan:9816` cannot give
//      `box.lan` to the port (not a whole number), so it goes to the host.
//   2. MANY OF SOMETHING IS A `~` COLLECTION. `~<set> peers: $Server` holds any number of servers, each
//      once, NAMED in the text — S1 names S4 before S4's line, because every identity is spawned before
//      any is linked. S1 lists S4 twice; a set holds it once, and the weave says so.
//   3. RESULTS ARE EVENTS. A record that cannot be woven is one @Unwoven, and the rest are woven anyway:
//      S1 names S7, which does not exist, so S7 is dropped from S1's peers. Then @Woven arrives — after the
//      commit, so a `target` sees every server. No hand-made "begin" event is needed.
//   4. WALKS ARE FLAT. `target s.Server.~peers as p` gives each peer, and `p.Server.name` reads its data
//      directly; `target $Server.~peers as s, p` gives every (server, peer) in one loop. The program's
//      own rules — a server listing itself, a link one way only — are a `has` each.
//   5. THE WAY OUT IS THE SAME LOOM. `toText(Server)` writes every server back in the loom's own format, and
//      `toText<KeyValue>(Server)` in another one. It writes the IDENTITIES, not the text they came from: S4
//      once, no S7, and no empty host. Whatever it writes, `weave Server(…)` reads back as the same servers.
//
// The NPCs use the built-in KeyValue format: values in parameter order, or `name=value`, "…" around spaces.
//
// Expected output:
//
//     ! Server: "S1=9811:S2+S4+S1+S3+S4+S5+S6+S7": `peers`: no record named "S7"
//     ! Server: "S1=9811:S2+S4+S1+S3+S4+S5+S6+S7": `peers`: "S4" is listed twice
//     S1 :9811  ->  S2 S4 S1 S3 S5 S6
//     S2 :9812  ->  S1 S3
//     S3 :9813  ->  S2 S4
//     S4 :9814  ->  S3 S1
//     S5 :9815  ->  S6 S1
//     S6 box.lan:9816  ->  S5 S2
//     rule: S1 lists itself
//     rule: S1 -> S3 is one way
//     rule: S1 -> S6 is one way
//     rule: S6 -> S2 is one way
//     as MeshList: S1=9811:S2+S4+S1+S3+S5+S6; S2=9812:S1+S3; S3=9813:S2+S4; S4=9814:S3+S1; S5=9815:S6+S1; S6=box.lan:9816:S5+S2
//     as KeyValue: S1 port=9811 peers=S2+S4+S1+S3+S5+S6
//     S2 port=9812 peers=S1+S3
//     S3 port=9813 peers=S2+S4
//     S4 port=9814 peers=S3+S1
//     S5 port=9815 peers=S6+S1
//     S6 host=box.lan port=9816 peers=S5+S2
//     ! Npc: "Imp lots": `hp`: "lots" is not a whole number
//     Goblin hp 30 at 4,2
//     Orc hp 50 at 9,0
//     Cave Troll hp 80 at 0,0

bundle WeaveTopology by you {

    need "Vein.Console"

    // In a project: formats/MeshList.vein. (A samples/formats/ folder would join every sample here.)
    format MeshList {
        records ";"
        name "="
        values ":"
        lists "+"
    }

    // The FIRST field is the name a record is known by — what `S2` in another record's peers means.
    shape $Server { name: string, host: string = "", port: int, ~<set> peers: $Server }
    shape $Npc    { name: string, hp: int, x: float = 0.0, y: float = 0.0 }

    mark #Listed
    mark #Npc

    loom<MeshList> Server { $Server  mark #Listed }
    loom<KeyValue> Npc    { $Npc  mark #Npc }

    shard Setup {
        run once {
            weave Server("S1=9811:S2+S4+S1+S3+S4+S5+S6+S7; S2=9812:S1+S3; S3=9813:S2+S4; S4=9814:S3+S1; S5=9815:S6+S1; S6=box.lan:9816:S5+S2")
        }

        hear @Unwoven as u {
            do print("! " + u.loom + ": " + u.why)
        }

        // The mesh is queryable now. Each server and its peers, then the program's own rules.
        hear @Woven as w {
            if w.loom == "Server" {
                target $Server #Listed as s {
                    var line = s.Server.name + " :" + s.Server.port
                    if not (s.Server.host == "") { line = s.Server.name + " " + s.Server.host + ":" + s.Server.port }
                    line = line + "  -> "
                    target s.Server.~peers as p { line = line + " " + p.Server.name }    // a peer's data, read directly
                    do print(line)
                }

                // The program's rules. A peer listed twice never got this far — `peers` is a ~<set>, so the
                // weave said so above. What is left: a server that lists itself, and a link one way only.
                target $Server #Listed as s {
                    if s.Server.~peers has s { do print("rule: " + s.Server.name + " lists itself") }
                }
                target $Server.~peers #Listed as s, p {                                 // every (server, peer) — one loop
                    if not (p.Server.~peers has s) { do print("rule: " + s.Server.name + " -> " + p.Server.name + " is one way") }
                }

                // The way out: the same loom, written back — in its own format, then in another.
                do print("as MeshList: " + toText(Server))
                do print("as KeyValue: " + trim(toText<KeyValue>(Server)))     // a line per record, and a last newline

                // The NPCs, now that the mesh is done.
                weave Npc("Goblin 30 4 2; Orc hp=50 x=9; \"Cave Troll\" 80; Imp lots")
            }
            if w.loom == "Npc" {
                target $Npc #Npc as n { do print(n.Npc.name + " hp " + n.Npc.hp + " at " + n.Npc.x + "," + n.Npc.y) }
            }
        }
    }
}
