// ============================================================================================
//  VeinScript — LANGUAGE TOUR
//  A single-file digest of every sample in samples/, concatenated for reading/discussion.
//  (Each bundle is independent — this file is a reference, not one compiled program.)
//
//  VeinScript is an Identity Oriented Programming (IOP) language:
//    * DATA lives in `shape`s (identity components) and `event`s (messages).
//    * BEHAVIOR lives in `shard`s (systems) and `SF`s (shard-functions; emit-only, never return).
//    * There is NO general `class`. Sigils tag references:  $Shape   @Event   #Mark
//    * Shards react to events with `hear`, mutate targeted identities, and `emit` new events.
//    * `folds` reconciles concurrent writes to a field (sum/min/max/…).
//    * Output (HTML/JS/CSS, etc.) is ASSEMBLED reactively: shards emit fragments, a `ShardView`
//      hears them and concatenates the final artifact.
//
//  Sections:
//    1. demo      — core IOP: shape/shard/target/each tick/settled/emit/mark, folds, SF, chance
//    2. payload   — emit ergonomics: field defaults, context auto-fill, `?` fill-the-rest
//    3. events    — the `audience` barrier + event provenance (from/origin)
//    4. site      — a reactive website: fragments assembled by a ShardView
//    5. mypage    — `builder` templates + `bring` (html/script/css from output fields)
//    6. shaped    — `$Shape` includes: a shape's fields flatten into a builder's params
//    7. handles   — cross-linking html/js/css through shared handle values (one source of truth)
//    8. entities  — the identity runtime RUNNING: spawn/attach, folds reconciling two shards, settled
//    9. console   — many windows, one program: @Console/@Send/@Message, `here()` as a role switch,
//                   `every N` (the wall clock), `audience` over the bus, @Undelivered
//   10. net       — the same model off this machine: @Listen/@Link, encrypted + NAT-crossing peers,
//                   and @Fetch/@Fetched/@Failed for services that are not VeinScript
//   11. chat      — entities AS a growing collection: a roster that stacks, and why leaving destroys
//   12. apps      — a principal bundle boots; capability bundles join ONE runtime and boot nothing
//   13. use       — naming a bundle once so bare names resolve, instead of qualifying every reference
//   14. toolchain — run / render / serve / build / emit / symbols, and the three checks
//
//  Everything in 9–13 was built after the original tour; sections 1–8 are unchanged.
// ============================================================================================


// ============================================================================================
//  1. demo.vein — CORE IOP
//  Exercises the IOP core: shape/shard/target/each tick/settled/emit/mark, folds, if/else, SF,
//  chance, and `$Shape.field` / `var` members inside an event. Traced in docs/EXAMPLE-PIPELINE.md.
// ============================================================================================

bundle Demo {
    need "Vein.Core"

    publicator DemoCore {
        shared("Hit points and mana for any living identity.")
        shape $Health {
            hp: int folds sum      // many shards may drain hp in one tick; sum the deltas
            mp: int
        }

        shared("Damage applied after mitigation.")
        event @Damaged {
            amount: int
            victim: Entity
            $Health.hp = 0             // pull one field off $Health (defaulted, so optional at emit)
            var note: string = "hit"   // a `var` member — same `=`/required rule as a field
        }
    }

    // An SF never returns a value — it emits events (each auto-tagged with origin/source).
    // A single SF can emit many times, just like a shard.
    SF hurt(victim: Entity, amount: int) {
        emit @Damaged {
            amount: amount
            victim: victim
        }
    }

    shard Drain {
        // The SCHEDULE is outer, the entity `target` query is inner.
        each tick {
            target $Health #Enemy as self {
                self.Health.hp -= 1

                chance 30% {
                    emit @Damaged {
                        amount: 5
                        victim: self
                    }
                }
            }
        }

        // settled runs once after the tick's fold contributions reconcile.
        settled {
            target $Health #Enemy as self {
                if self.Health.hp <= 0 {
                    mark self #Dead
                }
            }
        }
    }
}


// ============================================================================================
//  2. payload.vein — EMIT PAYLOAD ERGONOMICS
//    * event fields can have DEFAULTS (`amount: int = 1`) — optional at emit, override to change.
//    * omitted fields AUTO-FILL from the current context (the event being heard, then locals).
//    * hear reads the payload with plain field access on the binding (no sigil): `s.amount`.
//  Run:  veinc render samples/payload.vein /
// ============================================================================================

bundle Demo {
    event @Request   { path: string }
    event @Hit       { amount: int = 1 }     // default 1 — omit it to accept the default
    event @SyncedHit { amount: int }         // no default — auto-filled from context on emit
    event @Response  { status: int, body: string }

    shard Source {
        hear @Request as req { emit @Hit }               // amount omitted -> default 1
    }

    bridge Sync {
        hear @Hit as h { emit @SyncedHit }               // amount auto-filled from h (current context)
    }

    shard Report {
        hear @SyncedHit as s {
            emit @Response { status: 200, body: "amount " + s.amount + " from " + s.from.kind + "." + s.from.name }
        }
    }
}


// ============================================================================================
//  3. events.vein — THE `audience` BARRIER + PROVENANCE
//  A First-Class object can CARRY shapes/marks: `shard Combat $Session #Trusted { ... }`.
//  A `hear ... audience $Session #Trusted` only fires when the EMITTER carries ALL of them.
//  Every event also carries provenance you can read on the binding: `d.from.kind`, `d.from.name`.
//  Run:  veinc render samples/events.vein /   (one @Damage fires, the other is blocked)
// ============================================================================================

bundle Demo {
    event @Request  { path: string }
    event @Damage   { amount: int }
    event @Response { status: int, body: string }

    // Carries the credentials the auditor requires.
    shard Combat $Session #Trusted {
        hear @Request as req { emit @Damage { amount: 5 } }
    }

    // Carries nothing — its @Damage should be blocked by the audience barrier.
    shard Sneaky {
        hear @Request as req { emit @Damage { amount: 99 } }
    }

    shard Auditor {
        hear @Damage as d audience $Session #Trusted {
            emit @Response { status: 200, body: "audited trusted damage " + d.amount + " from " + d.from.kind + "." + d.from.name }
        }
    }
}


// ============================================================================================
//  4. site.vein — A REACTIVE WEBSITE
//  A page is ASSEMBLED, not returned:
//    @Request -> content shards emit @Html fragments -> ShardView concatenates them
//    -> on @Render the ShardView emits the finished @Response page.
//  Run:  veinc render samples/site.vein /
// ============================================================================================

bundle Site {
    need "Vein.Web"

    publicator SiteApi {
        shared("An inbound HTTP request.")
        event @Request { path: string }

        shared("A fragment of HTML contributed by some shard.")
        event @Html { markup: string }

        shared("Signal that all fragments are in; assemble the page.")
        event @Render { }

        shared("The response to send back.")
        event @Response { status: int, body: string }
    }

    // Content providers: each hears a request and emits its fragment (auto origin/source).
    shard Header {
        hear @Request as req { emit @Html { markup: "<h1>VeinScript</h1>" } }
    }

    shard Body {
        hear @Request as req {
            emit @Html { markup: "<p>Reactive page, assembled from fragments.</p>" }
        }
    }

    // Kernel closes the request phase (declared last, so @Render is queued after the fragments).
    shard Kernel {
        hear @Request as req { emit @Render { } }
    }

    // The ShardView: tons of `hear`, concatenating HTML into one page, then rendering.
    ShardView Page {
        var html: string

        hear @Html as f {
            html += f.markup
        }

        hear @Render as r {
            emit @Response {
                status: 200
                body: "<html><body>" + html + "</body></html>"
            }
        }
    }
}


// ============================================================================================
//  5. mypage.vein — `builder` TEMPLATES + `bring`
//  A `builder` is a reusable element: params, then ONE output field whose value is the template.
//  The output field's name decides the kind:  markup -> @Html,  code -> @Script,  css -> @Style.
//  `bring` instantiates it (optionally N times); a ShardView hears the fragments and assembles.
//  Run:  veinc render samples/mypage.vein /
// ============================================================================================

bundle App {
    need "Vein.Web"

    publicator PageApi {
        event @Request  { path: string }
        event @Html     { markup: string }
        event @Script   { code: string }
        event @Style    { css: string }
        event @Render   { }
        event @Response { status: int, body: string }
    }

    // Pre-built elements: params then an output field (markup/code/css) whose value is the template.
    builder Heading    { text: string   markup = "<h1>" + text + "</h1>" }
    builder CounterView { markup = "<p>Count: <span id=\"n\">0</span></p>" }
    builder Button     { label: string  markup = "<button onclick=\"inc()\">" + label + "</button>" }
    builder Item       { label: string  markup = "<li>" + label + "</li>" }
    builder IncFn      { code = "let c=0; function inc(){ c+=1; document.getElementById('n').innerText=c; }" }
    builder BaseCss    { css = "body{font-family:sans-serif;margin:2rem} button{cursor:pointer}" }

    // A shard brings in as many elements as the page needs.
    shard Ui {
        hear @Request as req {
            bring BaseCss()
            bring Heading("Counter")
            bring CounterView()
            bring Button("+1")
            bring 8 Item("row")        // build eight list items
            bring IncFn()
        }
    }

    shard Kernel {
        hear @Request as req { emit @Render { } }
    }

    // The page: hears html/script/style fragments and assembles one document.
    ShardView MyPage {
        var html: string
        var js: string
        var css: string

        hear @Html as f   { html += f.markup }
        hear @Script as s { js += s.code }
        hear @Style as st { css += st.css }

        hear @Render as r {
            emit @Response {
                status: 200
                body: "<!doctype html><html><head><style>" + css + "</style></head><body>" + html + "<script>" + js + "</script></body></html>"
            }
        }
    }
}


// ============================================================================================
//  6. shaped.vein — `$Shape` INCLUDES FLATTEN INTO BUILDER PARAMS
//  Instead of taking a whole shape VALUE as a param (which forces a shape literal at the call site
//  and repeats the name), a builder INCLUDES the shape (`$Heading`): its fields become the params
//  directly. Then `bring Button("+1","inc","primary","inc")` — no literal, no repeated name.
//  (`bring Button ?` in the Workbench expands `?` into the flattened fields to fill.)
//  Run:  veinc render samples/shaped.vein /
// ============================================================================================

bundle App {
    need "Vein.Web"

    publicator PageApi {
        event @Request  { path: string }
        event @Html     { markup: string }
        event @Render   { }
        event @Response { status: int, body: string }

        // Element data as shapes:
        shape $Heading { text: string }
        shape $Button  { label: string, id: string, class: string, onclick: string }
    }

    // Builders INCLUDE the shape ($Heading / $Button) — its fields become the builder's params
    // directly, so there's no literal to construct and no name to repeat at the `bring` site.
    builder Heading {
        $Heading
        markup = "<h1>" + text + "</h1>"
    }
    builder Button {
        $Button
        markup = "<button id=\"" + id + "\" class=\"" + class + "\" onclick=\"" + onclick + "()\">" + label + "</button>"
    }

    // Provide the fields straight — positionally, or `bring Button ?` to see/fill them.
    shard Ui {
        hear @Request as req {
            bring Heading("Counter")
            bring Button("+1", "inc", "primary", "inc")
        }
    }

    shard Kernel {
        hear @Request as req { emit @Render { } }
    }

    ShardView MyPage {
        var html: string
        hear @Html as f { html += f.markup }
        hear @Render as r {
            emit @Response { status: 200, body: "<html><body>" + html + "</body></html>" }
        }
    }
}


// ============================================================================================
//  7. handles.vein — CROSS-LINKING HTML / JS / CSS THROUGH HANDLES
//  A handle is a shape carrying a name (and, for a function, a body). Declare each ONCE, then hand
//  the SAME handle value to the element, the script, and the style — the name can't drift because
//  it lives in one place. Builders read the name/body off the handle.
//  Run:  veinc render samples/handles.vein /
// ============================================================================================

bundle App {
    need "Vein.Web"

    publicator PageApi {
        event @Request  { path: string }
        event @Html     { markup: string }
        event @Script   { code: string }
        event @Style    { css: string }
        event @Render   { }
        event @Response { status: int, body: string }

        // Handle types (would ship in `use Web`):
        shape $Id    { name: string }
        shape $Class { name: string }
        shape $Fn    { name: string, body: string }

        // Element data references handles instead of loose strings:
        shape $Control { id: Id, class: Class, onclick: Fn, label: string }
    }

    // Builders: params… then an output field (markup/code/css) whose value is the template.
    builder Display {
        slot: Id
        initial: string
        markup = "<span id=\"" + slot.name + "\">" + initial + "</span>"
    }
    builder Button {
        b: Control
        markup = "<button id=\"" + b.id.name + "\" class=\"" + b.class.name + "\" onclick=\"" + b.onclick.name + "()\">" + b.label + "</button>"
    }
    builder Define {
        f: Fn
        code = "function " + f.name + "(){ " + f.body + " }"
    }
    builder Rule {
        c: Class
        decl: string
        css = "." + c.name + "{" + decl + "}"
    }

    shard Ui {
        hear @Request as req {
            // Declare each handle ONCE. inc's body reads counter.name, so "counter" is written once.
            let counter = Id { name: "counter" }
            let primary = Class { name: "primary" }
            let inc     = Fn { name: "inc", body: "let e=document.getElementById('" + counter.name + "'); e.innerText=(+e.innerText)+1" }

            bring Rule(primary, "cursor:pointer;font-weight:bold")
            bring Display(counter, "0")
            bring Button(Control { id: counter, class: primary, onclick: inc, label: "+1" })
            bring Define(inc)
        }
    }

    shard Kernel { hear @Request as req { emit @Render { } } }

    ShardView MyPage {
        var html: string
        var js: string
        var css: string
        hear @Html as f   { html += f.markup }
        hear @Script as s { js += s.code }
        hear @Style as st { css += st.css }
        hear @Render as r {
            emit @Response { status: 200, body: "<!doctype html><html><head><style>" + css + "</style></head><body>" + html + "<script>" + js + "</script></body></html>" }
        }
    }
}


// ============================================================================================
//  8. entities.vein — THE IDENTITY RUNTIME, RUNNING
//  `run once` builds a world with spawn/attach/mark; two independent shards drain the same
//  `folds sum` field in one tick (so hp falls by 2, not 1); `settled` reads the reconciled value.
//  The clock is explicit:  veinc run samples/entities.vein --ticks 3
// ============================================================================================

bundle Entities {
    need "Vein.Core"

    shape $Health {
        hp: int folds sum      // many shards may drain hp in one tick; sum the deltas
    }

    shard Spawner {
        // `run once` builds the world before anything else happens.
        run once {
            repeat 3 {
                let e = spawn()
                attach $Health to e { hp: 5 }
                mark e #Enemy
            }
        }
    }

    shard Drain {
        each tick {
            target $Health #Enemy as self { self.Health.hp -= 1 }
        }
    }

    shard Poison {
        each tick {
            target $Health #Enemy as self { self.Health.hp -= 1 }
        }
    }

    shard Undertaker {
        // settled runs AFTER the tick's contributions reconcile — the only place a death check is
        // correct, because during the tick another shard may still be subtracting.
        settled {
            target $Health #Enemy as self {
                emit *Vein.Console.Io.@Print { text: "enemy " + Entity + " hp " + self.Health.hp }
                if self.Health.hp <= 0 {
                    mark self #Dead
                    unmark self #Enemy
                    emit *Vein.Console.Io.@Print { text: "enemy " + Entity + " died" }
                }
            }
        }
    }
}


// ============================================================================================
//  9. console — MANY WINDOWS, ONE PROGRAM
//  A program can spawn named console applications and pass events between them. Every window runs
//  the SAME source, so what differs is `here()` — this process's own console address. That makes
//  `match here()` a ROLE SWITCH: the window you launched is #Main, each spawned one is its name.
//    veinc build samples/console_roles.vein   ·   samples/console_broadcast.vein
//
//  `every N` is the wall clock — the one schedule in real seconds rather than frames. It runs only
//  in a live session (`veinc run`, a built .exe); `--ticks N` drives `each tick`, not this.
//
//  NOTE: the setup below sits in a `hear` rather than `run once` so that merely running this tour
//  does not open windows or bind ports. In a real program it is `run once`.
// ============================================================================================

bundle ConsoleRoles by you {

    event @Begin { }

    shard Boot {
        hear @Begin as b {
            match here() {
                // Only the launched window opens the others; a spawned console cannot spawn again,
                // so the tree can never run away.
                when #Main {
                    emit *Vein.Console.Io.@Console { name: #Alpha, firsttext: "Alpha — I echo." }
                    emit *Vein.Console.Io.@Console { name: #Beta,  firsttext: "Beta — I count." }
                }
            }
        }
    }

    shard Driver {
        var round: int

        // Every window reaches this block; the workers match no arm and do nothing. One timer, one
        // program, different work per identity.
        every 2 {
            match here() {
                when #Main {
                    round += 1
                    let workers = [#Alpha, #Beta]
                    emit *Vein.Console.Io.@Send { to: pick(workers), text: "ping " + round }
                }
            }
        }
    }

    shard Worker {
        var seen: int

        // `audience #Main` is the barrier: only Main reaches this handler. Over a console pipe it is
        // ADVISORY (the sender's name is unauthenticated); over Vein.Net it is enforced — §10.
        hear *Vein.Console.Io.@Message as m audience #Main {
            seen += 1
            emit *Vein.Console.Io.@Print { text: m.from + " -> " + m.text + " (#" + seen + ")" }
        }
    }

    // A window can be CLOSED at any time — normal, not an error. Without this, a closed peer just
    // makes the sender go quiet, and a silent window is indistinguishable from a dead one.
    shard Reachability {
        hear *Vein.Console.Io.@Undelivered as u {
            emit *Vein.Console.Io.@Print { text: "  (" + u.to + " is not running)" }
        }
    }
}


// ============================================================================================
//  10. net — THE SAME MODEL, OFF THIS MACHINE
//  `Vein.Net.Peer` re-declares Console's @Send/@Message/@Undelivered because at runtime they are the
//  SAME events: an `emit` lowers to its bare event name. So there is exactly one place a transport is
//  chosen — a mark that has been @Link-ed goes over the wire, anything else over the local pipe — and
//  a console program goes cross-machine by adding @Listen/@Link and changing nothing else.
//
//  Connections are persistent and bidirectional, so a reply travels back down the socket the sender
//  opened: a client behind NAT needs no port forwarding and no public address. Frames are encrypted
//  (AES-256-GCM under a key derived from `key:`), which is what makes `audience` a real barrier.
//  Not TLS: one static key means no forward secrecy and no certificate identity.
//    samples/net_peer.vein + samples/net_spoke.vein   ·   samples/net_fetch.vein
// ============================================================================================

bundle NetPeer by you {

    event @Begin { }

    shard Boot {
        hear @Begin as b {
            // `as` is who this program IS on the network — without it every peer answers to #Main.
            // A key is MANDATORY: @Listen refuses an empty one, because a port with no key accepts
            // any claimed identity and `audience` would silently become decoration.
            emit *Vein.Net.Peer.@Listen { as: #Hub, at: 9700, key: "shared-secret" }

            // Where a peer LIVES. Only the side that speaks FIRST needs this: a frame carries the
            // port its sender listens on, so receiving one teaches the receiver the way back.
            emit *Vein.Net.Peer.@Link { name: #Spoke, at: "10.0.0.5:9701", key: "shared-secret" }
        }
    }

    // Byte for byte the console version — nothing here says "network".
    shard Trusted {
        hear *Vein.Net.Peer.@Message as m audience #Spoke {
            emit *Vein.Net.Peer.@Send { to: m.from, text: "ack " + m.text }
        }
    }

    // HTTP is deliberately a DIFFERENT shape: a URL is not an identity, cannot call back, and answers
    // once per question. So @Fetch is a request with a reply. ANY status is @Fetched — a 404 is an
    // ANSWER — and only silence is @Failed, the same line @Undelivered draws for a peer.
    shard Fetcher {
        hear @Begin as b {
            emit *Vein.Net.Http.@Fetch { url: "https://httpbin.org/ip", method: "GET", body: "" }
        }
        hear *Vein.Net.Http.@Fetched as r {
            emit *Vein.Console.Io.@Print { text: r.status + " " + r.body }
        }
        hear *Vein.Net.Http.@Failed as f {
            emit *Vein.Console.Io.@Print { text: "unreachable " + f.url + " — " + f.reason }
        }
    }
}


// ============================================================================================
//  11. chat — ENTITIES AS A GROWING COLLECTION
//  The chat server's roster. A shard's `var` holds ONE value and the language has no growable list —
//  but it has entities, and those are the growing collection: `spawn()` makes one, `attach $Client`
//  gives it data, `target $Client` iterates them. Joining is spawning; leaving is destroying.
//
//  Two rules this leans on:
//    * a `hear` handler CAN build a world — each event is its own commit point, so the next event
//      sees what the last one built (inside one event a structural change is still deferred);
//    * `destroy` removes the entity AND its components, so a returning client is not a duplicate —
//      `unmark` would leak one per disconnect and hand the returner a second entity.
//
//  There is no `!=` in VeinScript: inequality is `not (a == b)`.
//    samples/chat/server.vein + samples/chat/client.vein
// ============================================================================================

bundle ChatRoster by you {

    shape $Client { addr: string }

    shard Relay {
        var known: bool

        hear *Vein.Net.Peer.@Message as m {
            // `target` is the only way to look through the roster, so the answer comes back on shard
            // state rather than as a return value.
            known = false
            target $Client as self {
                if self.Client.addr == m.from { known = true }
            }

            // A newcomer becomes an entity. That is the whole "stacking" mechanism.
            if not known {
                let e = spawn()
                attach $Client to e { addr: m.from }
                emit *Vein.Console.Io.@Print { text: "* " + m.from + " joined" }
            }

            // Relay to everyone except the sender.
            target $Client as self {
                if not (self.Client.addr == m.from) {
                    emit *Vein.Net.Peer.@Send { to: self.Client.addr, text: m.from + ": " + m.text }
                }
            }
        }
    }

    shard Reachability {
        hear *Vein.Net.Peer.@Undelivered as u {
            target $Client as self {
                if self.Client.addr == u.to {
                    destroy self
                    emit *Vein.Console.Io.@Print { text: "* " + u.to + " left" }
                }
            }
        }
    }
}


// ============================================================================================
//  12. apps — A PRINCIPAL BOOTS, CAPABILITIES JOIN ONE RUNTIME
//  An `app` manifest lists bundles. The FIRST `load` is the PRINCIPAL: its `start` is the app's single
//  boot event. Every other bundle contributes its shards to the SAME runtime and boots nothing — so an
//  `emit` in one bundle reaches a `hear` in another, and capabilities compose by being listed.
//
//      app Shop {
//          load "Store.vein"      // * principal — the only bundle that starts anything
//          load "Billing.vein"    // capability: invoices what Store ships
//          load "Audit.vein"      // capability: watches both
//      }
//
//  Adding a `load` adds reactions; removing it removes them, with no edit to any other bundle.
//  Events unify BY NAME, which is what makes that work — and is why two bundles declaring one name
//  with different fields is reported (VS0332) rather than silently merged. A non-principal `start`
//  does not fire (VS0331); its shards still run.
//    samples/app_capabilities/shop.app.vein     ·     veinc run <app.vein>
//
//  (Written as a comment on purpose: a real `app { … }` block here would make the tour itself a
//   manifest, and `veinc run` would try to link bundles that do not exist beside it.)
//
//  The principal below shows the other half — `start` names the boot event and its payload.
// ============================================================================================

bundle Store by you {

    publicator Orders {
        shared("A customer placed an order.")
        event @Ordered { item: string, qty: int }

        shared("An order was accepted and is going out.")
        event @Shipped { item: string }
    }

    // The app's front door: `veinc run` fires exactly this, once. At most one per bundle; zero makes
    // the bundle purely reactive, which is what every capability bundle is.
    start @Ordered { item: "widget", qty: 3 }

    shard Fulfilment {
        hear @Ordered as o {
            emit *Vein.Console.Io.@Print { text: "[Store] " + o.qty + " x " + o.item }
            emit @Shipped { item: o.item }
        }
    }
}


// ============================================================================================
//  13. use — NAMING A BUNDLE ONCE INSTEAD OF EVERY TIME
//  `use B` widens what a BARE name may mean: after every local lookup misses, the name is sought in the
//  bundles this one uses. Builders, shapes and `fn`/`SF` — events never needed it, because an emit
//  already lowers to its bare event name and the runtime dispatches on that.
//
//  Local declarations always win, so `use` cannot change what an existing program means; it only makes
//  more things resolve. A name exported by TWO used bundles is reported (VS0216) rather than picked by
//  dictionary order — `send` is a real example, living in both Vein.Console.Io and Vein.Net.Peer.
//
//  `*Author.Bundle.member` still works everywhere and is always unambiguous; reach for it when two
//  bundles collide, or when being explicit is the point.
// ============================================================================================

bundle UseDemo by you {

    need "Vein.Console"                    // print / send / spawn …
    need "Vein.Math"                       // $Vec2 / $Vec3 / $Color …
    need "Vein.Web"                        // &Heading / &Button / &Paragraph …

    // `$Vec2` with no qualifier — resolved through `use Math`.
    event @Placed { $Vec2, label: string }

    shard Demo {
        run once {
            print("bare call, resolved through `use Console`")     // *Vein.Console.Io.print
            bring Button("Go")                                     // *Vein.Web.Elements.&Button
            emit @Placed { x: 1.0, y: 2.0, label: "origin" }
        }
    }

    shard Watch {
        hear @Placed as p {
            // The qualified form, side by side with the bare one above. Same function, same result.
            *Vein.Console.Io.print(p.label + " at " + p.x + "," + p.y)
        }
    }
}


// ============================================================================================
//  14. what runs it — THE TOOLCHAIN IN ONE PLACE
//
//    veinc run    <file> [--ticks N]  console session: @Print/@Input, `every N` timers, the network
//    veinc render <file> [path]       one-shot: fire the boot event, capture @Response
//    veinc serve  <file> --port N     real HTTP into that same @Request -> @Response pipeline
//    veinc build  <file> [--rid R]    standalone exe (embeds the interpreter); --rid linux-x64 to
//                                     cross-build a server for a VPS
//    veinc emit   <file> -o <dir>     HIR -> C# for the SECS backend (identity half only: shapes,
//                                     marks, target, folds, run once/each tick/settled — ~10x the
//                                     interpreter; the reactive half stays interpreted)
//    veinc symbols <app.vein>         the combined cross-bundle API, with collisions flagged
//    veinc ir / ast / tokens / graph / events / scaffold / exec
//
//  Two execution models share one identity model, and both are implemented:
//    * the reactive event loop — emit/hear/ShardView/@Response, plus console and network;
//    * the ECS tick loop — target/each tick/settled/folds, driven by an explicit `--ticks N`.
//
//  Checks:  dotnet test src/Vein.Tests  ·  bash tools/check-ir.sh  ·  bash tools/check-backend.sh
//           (behaviour · the IR's shape · the backend agreeing with the interpreter, byte for byte)
// ============================================================================================
