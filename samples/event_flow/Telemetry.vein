//   NOT RUN ON ITS OWN — it is one bundle of samples/event_flow/event_flow.app.vein. Run that (open it and press ▶), or set it as the
//   Entry with the button at the top right, and ▶ runs the app from here.
// A recorder, and the home of the app's DEAD EVENT. It turns every hit and every death into @Logged —
// and nothing in the app hears @Logged. In one bundle that might be fine (someone else may hear it);
// in a linked app there IS no one else, so the map paints the wire red and ends it nowhere.
//
// To fix it, load a bundle that hears `*you.Telemetry.Records.@Logged` — or stop emitting it.

bundle Telemetry by you {

    publicator Records {
        shared("One line for the record.")
        event @Logged { entry: string }
    }

    shard Recorder {
        hear *you.Combat.Fight.@Damaged as d {
            emit @Logged { entry: "damage " + d.amount + " to " + d.target }
        }

        hear *you.Combat.Fight.@Died as d {
            emit @Logged { entry: "death of " + d.who }
        }
    }
}
