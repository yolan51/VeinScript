bundle WeaveFormats by you {

    need "Vein.Console"

    shape $Item    { name: string, qty: int, price: float = 0.0 }
    shape $Node    { name: string, port: int, ~<list> near: string }
    shape $Kick    { kind: string, who: string, by: string, minutes: int, why: string }
    shape $Mob     { name: string, hp: int, x: int = 0, y: int = 0 }
    shape $Setting { key: string, value: string }

    mark #FromJson
    mark #FromCsv
    mark #FromIni
    mark #FromKeyValue
    mark #FromSemi
    mark #Woven

    loom<Json>     JsonItem     { $Item  mark #FromJson }
    loom<Csv>      CsvItem      { $Item  mark #FromCsv }
    loom<Ini>      IniItem      { $Item  mark #FromIni }
    loom<KeyValue> KeyValueItem { $Item  mark #FromKeyValue }

    format SemiCsv from Csv {
        delimiter ";"
    }

    format NamedList {
        records ";"
        name "="
        values ":"
        lists "+"
    }

    format Pipes {
        values "|"
    }

    format Colons {
        pairs ":"
    }

    format Env {
        name "="
        comments "#"
        quotes "\""
    }

    loom<SemiCsv>   SemiCsvItem { $Item  mark #FromSemi }
    loom<NamedList> Node        { $Node  mark #Woven }
    loom<Pipes>     Kick        { $Kick  mark #Woven }
    loom<Colons>    Mob         { $Mob  mark #Woven }
    loom<Env>       Setting     { $Setting  mark #Woven }

    shard Setup {
        run once {
            weave JsonItem("[{\"name\": \"Rope\", \"qty\": 3, \"price\": 1.5}, {\"name\": \"Lamp\", \"qty\": 1}]")
            weave CsvItem("name,qty,price\n\"Torch, small\",4,2.25\n")
            weave IniItem("[Map]\nqty = 1\nprice = 9\n; a comment\n")
            weave KeyValueItem("Rag 2; Coin qty=50 price=0.1")
            weave SemiCsvItem("name;qty;price\nBread;2;1.5\nGem;lots;5")
            weave Node("S1=9811:S2+S4; S6=9816:S5")
            weave Kick("K|bob|ann|10|spam, again")
            weave Mob("Goblin hp:30 x:4 y:2")
            weave Setting("# greeting shown at login\nGREETING=\"hello there\"\nPORT=9811")
        }

        hear @Unwoven as u { do print("! " + u.loom + ": " + u.why) }

        hear @Woven as w {
            if w.loom == "JsonItem" { target $Item #FromJson as i { do print("Json: " + i.Item.name + " x" + i.Item.qty + " at " + i.Item.price) } }
            if w.loom == "CsvItem" { target $Item #FromCsv as i { do print("Csv: " + i.Item.name + " x" + i.Item.qty + " at " + i.Item.price) } }
            if w.loom == "IniItem" { target $Item #FromIni as i { do print("Ini: " + i.Item.name + " x" + i.Item.qty + " at " + i.Item.price) } }
            if w.loom == "KeyValueItem" { target $Item #FromKeyValue as i { do print("KeyValue: " + i.Item.name + " x" + i.Item.qty + " at " + i.Item.price) } }
            if w.loom == "SemiCsvItem" { target $Item #FromSemi as i { do print("SemiCsv: " + i.Item.name + " x" + i.Item.qty + " at " + i.Item.price) } }
            if w.loom == "Node" { target $Node as n { do print(n.Node.name + " port " + n.Node.port + " near " + join(n.Node.~near, " ")) } }
            if w.loom == "Kick" { target $Kick as k { do print("kick " + k.Kick.who + " by " + k.Kick.by + " for " + k.Kick.minutes + " min: " + k.Kick.why) } }
            if w.loom == "Mob" { target $Mob as m { do print(m.Mob.name + " hp " + m.Mob.hp + " at " + m.Mob.x + "," + m.Mob.y) } }
            if w.loom == "Setting" { target $Setting as s { do print(s.Setting.key + " = " + s.Setting.value) } }
        }
    }
}
