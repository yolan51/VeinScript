bundle Boids by advanced {
    need "Vein.Math"

    shape $Boid { x: float = 0.0, y: float = 0.0, vx: float = 0.0, vy: float = 0.0, cell: int = 0, next: Entity = 0, nh: int = 0, nn: int = 0, tag: int = 0, flock: int = 0 }
    shape $Bucket { key: int = 0, head: Entity = 0, gen: int = -1 }
    shape $Grid { first: Entity = 0, gen: int = 0, hashChecks: int = 0, naiveChecks: int = 0, mismatches: int = 0, sampleAgree: int = 0, sampleFrames: int = 0, sampleSeen: int = 0, faults: int = 0, contiguous: bool = false }

    fn boids() return int { return 40 }
    fn side() return float { return 600.0 }        // the world is [0, 600) on both axes — positive, so int() floors
    fn cellSize() return float { return 50.0 }     // = the neighbour radius, so 3x3 cells cover every neighbour
    fn cols() return int { return 12 }             // 600 / 50
    fn sepRadius() return float { return 14.0 }

    fn keyOf(x: float, y: float) return int { return int(y / cellSize()) * cols() + int(x / cellSize()) }
    fn clampTo(v: float, lo: float, hi: float) return float {
        if v < lo { return lo }
        if v > hi { return hi }
        return v
    }

    SF check(name: string, good: bool) {
        if good { emit *Vein.Console.Io.@Print { text: "ok   " + name } } else { emit *Vein.Console.Io.@Print { text: "FAIL " + name } }
    }

    shard Seed {
        run once {
            let g = spawn()
            var first = 0
            var gaps = 0
            repeat cols() * cols() as k {
                let b = spawn()
                if k == 0 { first = b }
                if not (b == first + k) { gaps += 1 }
                attach $Bucket to b { key: k }
            }
            attach $Grid to g { first: first, contiguous: gaps == 0 }
            repeat boids() as i {
                let e = spawn()
                let f = int(i / 10)
                let j = i % 10
                let x = 106.0 + 300.0 * float(f % 2) + float(j % 5) * 22.0 + float(i * 37 % 11) - 5.0
                let y = 139.0 + 300.0 * float(int(f / 2)) + float(int(j / 5)) * 22.0 + float(i * 53 % 13) - 6.0
                let angle = float(i) * 2.39996
                attach $Boid to e { x: x, y: y, vx: cos(angle) * 30.0, vy: sin(angle) * 30.0, cell: keyOf(x, y), tag: i, flock: f }
            }
        }
    }

    shard Flock {
        each tick as t {
            var first = 0
            var gen = 0
            target $Grid as g {
                first = g.Grid.first
                gen = g.Grid.gen
            }
            if gen > 0 {
                var checks = 0
                target $Boid as a {
                    let acx = a.Boid.cell % cols()
                    let acy = int(a.Boid.cell / cols())
                    var found = 0
                    var sx = 0.0
                    var sy = 0.0
                    var avx = 0.0
                    var avy = 0.0
                    var px = 0.0
                    var py = 0.0
                    repeat 9 as k {
                        let cx = acx + k % 3 - 1
                        let cy = acy + int(k / 3) - 1
                        if cx >= 0 and cx < cols() and cy >= 0 and cy < cols() {
                            target $Bucket on first + cy * cols() + cx as c {
                                if c.Bucket.gen == gen {
                                    var cur = c.Bucket.head
                                    while not (cur == 0) {
                                        let here = cur
                                        cur = 0
                                        target $Boid on here as b {
                                            cur = b.Boid.next
                                            if not (b == a) {
                                                checks += 1
                                                let dx = b.Boid.x - a.Boid.x
                                                let dy = b.Boid.y - a.Boid.y
                                                let d2 = dx * dx + dy * dy
                                                if d2 < cellSize() * cellSize() {
                                                    found += 1
                                                    sx = sx + dx
                                                    sy = sy + dy
                                                    avx = avx + b.Boid.vx
                                                    avy = avy + b.Boid.vy
                                                    if d2 < sepRadius() * sepRadius() {
                                                        let d = sqrt(d2) + 0.01
                                                        let push = (sepRadius() - d) / d
                                                        px = px - dx * push
                                                        py = py - dy * push
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    var ax = 0.0
                    var ay = 0.0
                    if found > 0 {
                        let n = float(found)
                        ax = (sx / n) * 2.0 + (avx / n - a.Boid.vx) * 3.0 + px * 30.0
                        ay = (sy / n) * 2.0 + (avy / n - a.Boid.vy) * 3.0 + py * 30.0
                    }
                    if a.Boid.x < 60.0 { ax = ax + 40.0 }
                    if a.Boid.x > side() - 60.0 { ax = ax - 40.0 }
                    if a.Boid.y < 60.0 { ay = ay + 40.0 }
                    if a.Boid.y > side() - 60.0 { ay = ay - 40.0 }
                    var vx = a.Boid.vx + ax * t.delta
                    var vy = a.Boid.vy + ay * t.delta
                    let speed = sqrt(vx * vx + vy * vy) + 0.0001
                    let want = clampTo(speed, 15.0, 45.0)
                    vx = vx / speed * want
                    vy = vy / speed * want
                    let x = clampTo(a.Boid.x + vx * t.delta, 0.0, side() - 0.001)
                    let y = clampTo(a.Boid.y + vy * t.delta, 0.0, side() - 0.001)
                    a.Boid.vx = vx
                    a.Boid.vy = vy
                    a.Boid.x = x
                    a.Boid.y = y
                    a.Boid.cell = keyOf(x, y)
                    a.Boid.nh = found
                }
                target $Grid as g { g.Grid.hashChecks = g.Grid.hashChecks + checks }
            }
        }
    }

    shard Naive {
        each tick {
            var gen = 0
            target $Grid as g { gen = g.Grid.gen }
            if gen > 0 {
                var checks = 0
                target $Boid as a {
                    var found = 0
                    target $Boid as b {
                        if not (b == a) {
                            checks += 1
                            let dx = b.Boid.x - a.Boid.x
                            let dy = b.Boid.y - a.Boid.y
                            if dx * dx + dy * dy < cellSize() * cellSize() { found += 1 }
                        }
                    }
                    a.Boid.nn = found
                }
                target $Grid as g { g.Grid.naiveChecks = g.Grid.naiveChecks + checks }
            }
        }
    }

    shard Hash {
        settled {
            var first = 0
            var gen = 0
            target $Grid as g {
                first = g.Grid.first
                gen = g.Grid.gen
            }
            var mismatches = 0
            var sampleAgree = 0
            var sampleSeen = 0
            if gen > 0 {
                target $Boid as a {
                    if not (a.Boid.nh == a.Boid.nn) { mismatches += 1 }
                    if a.Boid.tag == 0 {
                        if a.Boid.nh == a.Boid.nn { sampleAgree = 1 }
                        if a.Boid.nn > 0 { sampleSeen = 1 }
                    }
                }
            }

            var prev = 0
            var prevKey = -1
            var heads = 0
            var linked = 0
            target $Boid by Boid.cell as b {
                if b.Boid.cell == prevKey {
                    target $Boid on prev as p { p.Boid.next = b }
                    linked += 1
                } else {
                    if not (prev == 0) { target $Boid on prev as p { p.Boid.next = 0 } }
                    target $Bucket on first + b.Boid.cell as c {
                        c.Bucket.head = b
                        c.Bucket.gen = gen + 1
                    }
                    heads += 1
                }
                prev = b
                prevKey = b.Boid.cell
            }
            if not (prev == 0) { target $Boid on prev as p { p.Boid.next = 0 } }

            target $Grid as g {
                if gen > 0 {
                    g.Grid.mismatches = g.Grid.mismatches + mismatches
                    g.Grid.sampleAgree = g.Grid.sampleAgree + sampleAgree
                    g.Grid.sampleSeen = g.Grid.sampleSeen + sampleSeen
                    g.Grid.sampleFrames = g.Grid.sampleFrames + 1
                }
                if not (heads + linked == boids()) { g.Grid.faults = g.Grid.faults + 1 }
                g.Grid.gen = gen + 1
            }
        }
    }

    shard Report {
        var spread0: float = 0.0
        var polar0: float = 0.0
        each tick as t {
            if t.frame == 1 or t.frame == 180 {
                var sumD = 0.0
                var sumP = 0.0
                var closest = 1000000.0
                target $Boid as a {
                    var cx = 0.0
                    var cy = 0.0
                    var hx = 0.0
                    var hy = 0.0
                    var m = 0
                    target $Boid as b {
                        if b.Boid.flock == a.Boid.flock {
                            m += 1
                            cx = cx + b.Boid.x
                            cy = cy + b.Boid.y
                            let s = sqrt(b.Boid.vx * b.Boid.vx + b.Boid.vy * b.Boid.vy) + 0.0001
                            hx = hx + b.Boid.vx / s
                            hy = hy + b.Boid.vy / s
                        }
                        if a.Boid.tag < b.Boid.tag {
                            let d = sqrt((a.Boid.x - b.Boid.x) * (a.Boid.x - b.Boid.x) + (a.Boid.y - b.Boid.y) * (a.Boid.y - b.Boid.y))
                            if d < closest { closest = d }
                        }
                    }
                    let fm = float(m)
                    cx = cx / fm
                    cy = cy / fm
                    sumD = sumD + sqrt((a.Boid.x - cx) * (a.Boid.x - cx) + (a.Boid.y - cy) * (a.Boid.y - cy))
                    sumP = sumP + sqrt(hx * hx + hy * hy) / fm
                }
                let spread = sumD / float(boids())
                let polar = sumP / float(boids())
                if t.frame == 1 {
                    spread0 = spread
                    polar0 = polar
                } else {
                    target $Grid as g {
                        do check("buckets are an array: cell k is the identity first + k", g.Grid.contiguous)
                        do check("every boid sits in exactly one bucket, every frame", g.Grid.faults == 0)
                        do check("the hash makes under a third of the naive loop's distance checks",
                            g.Grid.hashChecks * 3 < g.Grid.naiveChecks and g.Grid.hashChecks > 0)
                        do check("sample boid: hash and naive agree on its neighbours every frame",
                            g.Grid.sampleAgree == g.Grid.sampleFrames and g.Grid.sampleSeen > 0)
                        do check("every boid: hash and naive agree, every frame", g.Grid.mismatches == 0)
                    }
                    do check("cohesion: the mean distance to the flock's centre shrank", spread < spread0 * 0.85)
                    do check("separation: no two boids closer than half the separation radius", closest > sepRadius() * 0.5)
                    do check("alignment: each flock's headings converged", polar > 0.8 and polar > polar0 + 0.4)
                }
            }
        }
    }
}
