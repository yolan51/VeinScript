// docs/design/views-lego.vein — DESIGN SKETCH for D26 (PROPOSED, docs/SYNTAX-DECISIONS.md). NOT COMPILED YET.
//
// Three ShardViews brick a desktop app together like Lego. Each one is a view ON one kind of identity, and
// knows only the SOCKET its top piece plugs into: a widget another view built and marked. No view mentions
// another view.
//
//   BoardWindow on $Board   the base plate        offers socket #Groups
//   GroupCard   on $Group   plugs into #Groups    offers socket #Tasks
//   TaskRow     on $Task    plugs into ITS group's #Tasks
//
// What a ShardView `on $Shape as x { … }` would MEAN, in today's VeinScript (the rule that keeps it VeinScript):
//   • the body runs ONCE per identity carrying $Shape that has no view of this name yet — it is
//     `settled { target $Shape not #<generated> as x { …; mark x #<generated> } }`
//   • a builder call needs no `bring`; a NESTED call gets its enclosing widget as its parent (RULES 9), so only
//     the top call names where it plugs in
//   • every widget the body brings is owned by x (`do ownedBy(w, x)`), so `discard(x)` takes them all and a
//     handler goes from a clicked widget to its data in one step
//   • `mark #M` after a call marks that widget
//
// Everything below the views is today's language.

bundle Lego by you {
    need "Vein.Desktop"
    need "Vein.UI"
    need "Vein.Core"

    // ---- the data: nothing here knows about the screen ------------------------------------------------

    shape $Board { title: string }
    shape $Group { name: string }
    shape $Task { group: string, text: string, done: bool = false }

    builder Board { $Board   mark #Board }
    builder Group { $Group   mark #Group }
    builder Task { $Task   mark #Task }

    mark #Board
    mark #Group
    mark #Task
    mark #Groups        // socket: where group cards plug in
    mark #Tasks         // socket: where a group's task rows plug in
    mark #Done
    mark #Delete

    // ---- brick 1: the base plate — one window per $Board, offering the #Groups socket -------------------

    ShardView BoardWindow on $Board as b {                       // [D26]
        Window(b.Board.title, 480.0, 600.0) {
            Heading(b.Board.title, 24.0)
            Column(12.0) mark #Groups
        }
    }

    // ---- brick 2: a group — plugs into #Groups, offers its own #Tasks socket -----------------------------

    ShardView GroupCard on $Group as g {                         // [D26]
        Column(groupsSocket(), 6.0) {
            Heading(g.Group.name, 18.0)
            Column(4.0) mark #Tasks
        }
    }

    // ---- brick 3: a task — plugs into its own group's #Tasks ---------------------------------------------

    ShardView TaskRow on $Task as t {                            // [D26]
        Row(tasksOf(t.Task.group), 8.0) {
            Check(t.Task.text, t.Task.done) mark #Done
            Button("✕") mark #Delete
        }
    }

    // ---- the data arrives in ANY order; each brick waits until its socket exists -----------------------

    shard Start {
        run once {
            bring Task("Work", "Ship it")           // before its group and the board: waits a frame or two
            bring Board("My board")
            bring Group("Work")
            bring Group("Home")
            bring Task("Home", "Water plants")
        }
    }

    // ---- behaviour stays rules. Every widget a view brought is owned by its identity -------------------

    shard Actions {
        hear *Vein.UI.Interaction.@Clicked as c {
            // The ✕ is owned by its task: discarding the task takes its whole row.
            target $Owner #Delete on c.target as d { do discard(d.Owner.ownerId) }
        }
        hear *Vein.Desktop.Events.@Toggled as e {
            target $Owner #Done on e.target as box {
                target $Task on box.Owner.ownerId as t { t.Task.done = e.checked }
            }
        }
    }

    // ---- the sockets: small questions, today's language ------------------------------------------------

    // The one column every group card plugs into — 0 until the board's window exists.
    fn groupsSocket() return Entity {
        var at = 0
        target $Panel #Groups as s { at = s }
        return at
    }

    // A group's task column, found through the card that owns it — 0 until that card exists.
    fn tasksOf(group: string) return Entity {
        var at = 0
        target $Group as g {
            if g.Group.name == group {
                target $Owner $Panel #Tasks as s { if s.Owner.ownerId == g { at = s } }
            }
        }
        return at
    }
}

// ---- web, eventually: the same bricks, a different drawer -------------------------------------------------
//
// Today a web page is a STREAM of text fragments (@Html), so order is everything and a brick cannot plug in
// later — which is why the web todo and the desktop todo look nothing alike. The unifying step: on the web too,
// a widget is an identity with a $Parent (a tree, as on the desktop), and @Render WALKS that tree and writes the
// HTML, the way the Workbench walks it and draws native controls. Then these three ShardViews serve a page
// unchanged: Column → <div>, Heading → <h2>, Check → <input type=checkbox>, Button → <button>. The bricks, the
// sockets and the rules stay; only the drawer differs — Avalonia on the desktop, an HTML writer on the web.
