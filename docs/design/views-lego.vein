// docs/design/views-lego.vein — DESIGN SKETCH for D26 (PROPOSED, docs/SYNTAX-DECISIONS.md). NOT COMPILED YET.
//
// Three ShardViews brick a desktop app together like Lego. A PARENT view says which view goes where, with a
// SOCKET named after that view (`socket !TaskRow(…)`, the shard sigil of D19). A child view says nothing about
// its place, so it can be reused in another socket unchanged.
//
//   BoardWindow on $Board   top-level (placed by no socket): the window, with   socket !GroupCard
//   GroupCard   on $Group   placed by BoardWindow; offers                        socket !TaskRow(g.Group.~tasks)
//   TaskRow     on $Task    placed by its group's card
//
// What it would MEAN, in today's VeinScript (the rule that keeps it VeinScript):
//   • a view's body runs ONCE per identity carrying its shape — `settled { target $S not #<generated> as x { … } }`
//   • a builder call needs no `bring` and no parent: a nested call gets its enclosing widget, the top call gets
//     the socket it is placed in
//   • every widget the body brings is owned by x (`do ownedBy(w, x)`): `discard(x)` takes them all, and a handler
//     goes from a clicked widget to its data in one step
//   • `socket !View(collection)` shows that view for each identity in the collection, in its order; with no
//     argument, for every identity the view is on
//
// Everything outside the three views is today's language.

bundle Lego by you {
    need "Vein.Desktop"
    need "Vein.UI"
    need "Vein.Core"

    // ---- the data: nothing here knows about the screen ------------------------------------------------

    shape $Board { title: string }
    shape $Task { text: string, done: bool = false }
    shape $Group { name: string, ~<list> tasks: owns $Task }     // D24: a group OWNS its tasks, in order

    builder Board { $Board   mark #Board }
    builder Group { $Group   mark #Group }
    builder Task { $Task   mark #Task }

    mark #Board
    mark #Group
    mark #Task
    mark #Done
    mark #Delete

    // ---- brick 1: the window — top-level, with a socket for every group's card ------------------------

    ShardView BoardWindow on $Board as b {                       // [D26]
        Window(b.Board.title, 480.0, 600.0) {
            Heading(b.Board.title, 24.0)
            Column(12.0) socket !GroupCard
        }
    }

    // ---- brick 2: a group's card — with a socket for THIS group's tasks -----------------------------------

    ShardView GroupCard on $Group as g {                         // [D26]
        Column(6.0) {
            Heading(g.Group.name, 18.0)
            Column(4.0) socket !TaskRow(g.Group.~tasks)
        }
    }

    // ---- brick 3: a task's row — it does not know where it goes -----------------------------------------

    ShardView TaskRow on $Task as t {                            // [D26]
        Row(8.0) {
            Check(t.Task.text, t.Task.done) mark #Done
            Button("✕") mark #Delete
        }
    }

    // ---- the data arrives in ANY order; a socket fills as its identities appear ------------------------

    shard Start {
        run once {
            bring Task("Ship it") as ship                // before its group and the board exist
            bring Board("My board")
            bring Group("Work", [ship]) as work
            bring Group("Home", []) as home
            bring Task("Water plants") as water
            home.Group.~tasks.add(water)
        }
    }

    // ---- behaviour stays rules. Every widget a view brought is owned by its identity -------------------

    shard Actions {
        hear *Vein.UI.Interaction.@Clicked as c {
            // The ✕ is owned by its task: discarding the task takes its whole row.
            target $Owner #Delete on c.target as d { do discard(d.Owner.ownerId) }
        }
        hear *Vein.Desktop.Events.@Toggled as e {
            target $Owner #Done on e.target as box {
                target $Task on box.Owner.ownerId as t { t.Task.done = e.checked }
            }
        }
    }
}

// ---- ten views later -------------------------------------------------------------------------------------
//
// The structure lives in the parents' sockets, so it can be read — and drawn by the Outline — as a tree:
//
//   BoardWindow ▸ !GroupCard ▸ !TaskRow
//              ▸ !Sidebar ▸ !FilterChip
//              ▸ !StatusBar
//
// A misspelt `socket !TaskRwo` is an error, not an empty screen; a view placed by nothing is a window.
//
// ---- web, eventually: the same bricks, a different drawer -------------------------------------------------
//
// Today a web page is a STREAM of text fragments (@Html), so order is everything and a brick cannot plug in
// later. The unifying step: on the web too, a widget is an identity with a $Parent (a tree, as on the desktop),
// and @Render WALKS that tree and writes the HTML, the way the Workbench walks it and draws native controls.
// Then these three ShardViews serve a page unchanged: Column → <div>, Heading → <h2>, Check → <input
// type=checkbox>, Button → <button>. The bricks and the sockets stay; only the drawer differs.
